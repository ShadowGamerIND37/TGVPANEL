    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "node-gyp": "^13.1.0",
    "nodemon": "^3.0.1",
    "typescript": "^7.0.2"
