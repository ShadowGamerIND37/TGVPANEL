{
  "name": "hkvm",
  "version": "3.0.0",
  "description": "HKVM V3 — Unified QEMU/KVM & LXC VPS Virtualization Control Panel",
  "main": "app.js",
  "scripts": {
    "build": "tsc",
    "start": "node app.js",
    "start:agent": "node lib/node-agent/agent.js",
    "migrate": "node lib/db/cli-migrate.js",
    "import:hvm": "node lib/db/hvm-importer-cli.js",
    "dev": "nodemon app.js",
    "test": "node tests/run-all.js"
  },
  "keywords": [
    "hkvm",
    "vm",
    "qemu",
    "kvm",
    "lxc",
    "vps",
    "virtualization",
    "management"
