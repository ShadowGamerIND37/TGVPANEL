    "@xterm/xterm": "^6.0.0",
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "ejs": "^6.0.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "multer": "^2.5.0",
    "node-pty": "^1.1.0",
    "passport": "^0.7.0",
    "passport-discord": "^0.1.4",
    "qrcode": "^1.5.4",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
