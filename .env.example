# ============================================================================
# HKVM V3 — Unified KVM + LXC Virtualization Platform Configuration
# Copy this file to .env and customize for your deployment.
# ============================================================================

# Server Binding
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# Panel Branding
PANEL_NAME=HKVM
PANEL_VERSION=V3.0
DEFAULT_LOGO_URL=/images/logo.png

# Data & Storage Directories
HKVM_DATA_DIR=./data
HKVM_VM_DIR=./storage/vms
HKVM_LXC_DIR=/var/lib/lxc
HKVM_BACKUP_DIR=./backups
HKVM_ISO_DIR=./storage/iso
HKVM_TEMPLATES_DIR=./storage/templates

# Security Secrets (auto-generated into .hkvm-secret if omitted)
SESSION_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
CSRF_SECRET=

# Local Node Agent Integration
LOCAL_NODE_AGENT_PORT=5050
LOCAL_NODE_AGENT_HOST=127.0.0.1
NODE_AGENT_TLS_ENABLED=false

# Monitoring & Background Jobs
LIVE_STATS_VPS_INTERVAL_SEC=5
LIVE_STATS_NODE_INTERVAL_SEC=10
CPU_ALERT_THRESHOLD=90
RAM_ALERT_THRESHOLD=90
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_RETENTION=7

# Optional PostgreSQL Migration Target (see docs/POSTGRESQL_MIGRATION.md)
DATABASE_DRIVER=sqlite
DATABASE_URL=
