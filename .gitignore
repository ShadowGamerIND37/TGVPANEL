# Dependencies
/node_modules/

# Environment & Secrets
/.env
/.env.local
/.env.*.local
/.hkvm-secret
/certs/*.key
/certs/*.pem

# SQLite WAL / SHM & runtime temp files
*.db-wal
*.db-shm
*.db-journal

# Runtime logs & PID files
/logs/
/*.log
/*.pid
npm-debug.log*

# Runtime VM / Container / Upload / Temp artifacts (root-anchored so src/ & lib/ are never matched)
/vms/
/storage/
/tmp/
/.tmp/
/backups/*.tar.gz
/backups/*.qcow2
/data/backups/
/data/instance-backups/
/data/lxc-templates/
/data/migration-staging/
/data/node-agent-credentials.json
