              <button type="button" class="nc-tool-btn danger" id="ncPtyDisconnectBtn" onclick="disconnectNodeShell()" style="display:none;">Disconnect</button>
            </div>
          </div>

          <div class="nc-pty-locked" id="ncPtyLockedPane" style="<%= interactiveEnabled ? 'display:none;' : '' %>">
            <div>
              <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
