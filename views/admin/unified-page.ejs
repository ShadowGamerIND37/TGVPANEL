function renderDualSeriesSvg(containerId, points, s1Cfg, s2Cfg) {
  const box = document.getElementById(containerId);
  if (!box) return;
  if (!points || points.length === 0) {
    box.innerHTML =
      '<div style="text-align:center;padding:28px 16px;">' +
      '<div style="font-size:13px;font-weight:600;color:var(--text-secondary);margin-bottom:6px;">No telemetry samples in this window yet</div>' +
      '<div style="font-size:12px;color:var(--text-muted);margin-bottom:12px;">Click <strong>Collect Live Sample Now</strong> above to capture an immediate host reading.</div>' +
      '<button type="button" class="btn btn-outline" onclick="pollNodeNow()" style="font-size:12px;padding:6px 12px;">Capture Sample</button>' +
      '</div>';
    return;
  }

  const W = 560, H = 175, padL = 36, padR = 14, padT = 12, padB = 26;
  const plotW = W - padL - padR;
  const plotH = H - padT - padB;

  const v1 = points.map(p => Math.max(0, Number(s1Cfg.get(p) || 0)));
  const v2 = points.map(p => Math.max(0, Number(s2Cfg.get(p) || 0)));
  const maxVal = s1Cfg.fixedMax || Math.max(100, ...v1, ...v2);

  const xAt = (idx) => points.length === 1 ? padL + plotW / 2 : padL + (idx / (points.length - 1)) * plotW;
  const yAt = (val) => padT + plotH - (Math.min(maxVal, Math.max(0, val)) / maxVal) * plotH;

  const mkPath = (arr) => arr.map((val, i) => (i === 0 ? 'M' : 'L') + xAt(i).toFixed(1) + ',' + yAt(val).toFixed(1)).join(' ');
  const mkArea = (arr) => {
    if (arr.length < 2) return '';
    return mkPath(arr) + ` L${xAt(arr.length - 1).toFixed(1)},${(padT + plotH).toFixed(1)} L${xAt(0).toFixed(1)},${(padT + plotH).toFixed(1)} Z`;
  };

  const gridSteps = [0, 0.25, 0.5, 0.75, 1];
  const gridSvg = gridSteps.map(g => {
    const y = (padT + plotH * (1 - g)).toFixed(1);
    const lbl = Math.round(maxVal * g) + (s1Cfg.unit || '%');
    return `<line x1="${padL}" y1="${y}" x2="${W - padR}" y2="${y}" stroke="rgba(255,255,255,0.06)" stroke-dasharray="3,3"/>` +
           `<text x="${padL - 6}" y="${Number(y) + 3.5}" text-anchor="end" fill="rgba(160,170,185,0.75)" font-size="9.5" font-family="monospace">${lbl}</text>`;
  }).join('');

  const fmtTimeShort = (raw) => {
    if (!raw) return '';
    const str = String(raw);
    return str.length >= 16 ? str.slice(11, 16) : str;
  };
  const firstLbl = hkvmEsc(fmtTimeShort(points[0].recorded_at));
  const midLbl = points.length > 2 ? hkvmEsc(fmtTimeShort(points[Math.floor(points.length / 2)].recorded_at)) : '';
  const lastLbl = hkvmEsc(fmtTimeShort(points[points.length - 1].recorded_at));

  const grad1 = containerId + '_g1';
  const grad2 = containerId + '_g2';
  const lastIdx = points.length - 1;

  box.innerHTML = `<svg viewBox="0 0 ${W} ${H}" style="width:100%;height:180px;display:block;overflow:visible;">
    <defs>
      <linearGradient id="${grad1}" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="${s1Cfg.color}" stop-opacity="0.28"/>
        <stop offset="100%" stop-color="${s1Cfg.color}" stop-opacity="0.0"/>
      </linearGradient>
      <linearGradient id="${grad2}" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="${s2Cfg.color}" stop-opacity="0.20"/>
        <stop offset="100%" stop-color="${s2Cfg.color}" stop-opacity="0.0"/>
      </linearGradient>
    </defs>
    ${gridSvg}
    ${points.length > 1 ? `<path d="${mkArea(v2)}" fill="url(#${grad2})"/>` : ''}
    ${points.length > 1 ? `<path d="${mkArea(v1)}" fill="url(#${grad1})"/>` : ''}
    ${points.length > 1 ? `<path d="${mkPath(v2)}" fill="none" stroke="${s2Cfg.color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>` : ''}
    ${points.length > 1 ? `<path d="${mkPath(v1)}" fill="none" stroke="${s1Cfg.color}" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>` : ''}
    <circle cx="${xAt(lastIdx).toFixed(1)}" cy="${yAt(v2[lastIdx]).toFixed(1)}" r="3.5" fill="${s2Cfg.color}"/>
    <circle cx="${xAt(lastIdx).toFixed(1)}" cy="${yAt(v1[lastIdx]).toFixed(1)}" r="4" fill="${s1Cfg.color}"/>
    <text x="${padL}" y="${H - 6}" text-anchor="start" fill="rgba(160,170,185,0.75)" font-size="9.5" font-family="monospace">${firstLbl}</text>
    ${midLbl ? `<text x="${(padL + plotW / 2).toFixed(1)}" y="${H - 6}" text-anchor="middle" fill="rgba(160,170,185,0.75)" font-size="9.5" font-family="monospace">${midLbl}</text>` : ''}
    <text x="${W - padR}" y="${H - 6}" text-anchor="end" fill="rgba(160,170,185,0.75)" font-size="9.5" font-family="monospace">${lastLbl}</text>
  </svg>`;
}

async function loadMonitoring() {
  const sel = document.getElementById('monNodeSelect');
  if (!sel) return;
  const nodeId = sel.value;
  const [mData, aData] = await Promise.all([
    hkvmApi('/api/v1/nodes/' + nodeId + '/metrics?hours=' + __monHours),
    hkvmApi('/api/v1/monitoring/alerts')
  ]);

  const history = mData.history || [];
  const rules = aData.rules || [];
  const latest = history.length ? history[history.length - 1] : null;

  const setTxt = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
  setTxt('monSamplesCountBadge', history.length + (history.length === 1 ? ' Sample' : ' Samples'));
  setTxt('monRulesCountBadge', rules.length + (rules.length === 1 ? ' Rule' : ' Rules'));

  if (latest) {
    const cpuPct = Math.min(100, Math.max(0, Number(latest.cpu_percent || 0)));
    const ramTot = Math.max(1, Number(latest.ram_total_mb || 1));
    const ramUsed = Number(latest.ram_used_mb || 0);
    const ramPct = Math.min(100, Math.max(0, (ramUsed / ramTot) * 100));
    const diskTot = Math.max(0.01, Number(latest.disk_total_gb || 0));
    const diskUsed = Number(latest.disk_used_gb || 0);
    const diskPct = diskTot > 0 ? Math.min(100, Math.max(0, (diskUsed / diskTot) * 100)) : 0;

    const avgCpu = history.reduce((s, r) => s + Number(r.cpu_percent || 0), 0) / history.length;
    const peakCpu = Math.max(...history.map(r => Number(r.cpu_percent || 0)));

    setTxt('monCpuVal', cpuPct.toFixed(2) + '%');
    setTxt('monCpuLoadTag', 'Load ' + Number(latest.load_avg_1 || 0).toFixed(2));
    setTxt('monCpuMeta', 'Avg ' + avgCpu.toFixed(1) + '% • Peak ' + peakCpu.toFixed(1) + '%');
    const cBar = document.getElementById('monCpuBar');
    if (cBar) { cBar.style.width = cpuPct.toFixed(1) + '%'; cBar.className = 'st-bar-fill ' + barToneClass(cpuPct); }

    setTxt('monRamVal', fmtMbAsGb(ramUsed) + ' / ' + fmtMbAsGb(ramTot));
    setTxt('monRamPctTag', ramPct.toFixed(1) + '%');
    setTxt('monRamMeta', ramUsed + ' / ' + ramTot + ' MB (' + fmtMbAsGb(Math.max(0, ramTot - ramUsed)) + ' free)');
    const rBar = document.getElementById('monRamBar');
    if (rBar) { rBar.style.width = ramPct.toFixed(1) + '%'; rBar.className = 'st-bar-fill ' + barToneClass(ramPct); }

    setTxt('monDiskVal', diskUsed.toFixed(2) + ' / ' + diskTot.toFixed(2) + ' GB');
    setTxt('monDiskPctTag', diskPct.toFixed(1) + '%');
    setTxt('monDiskMeta', Math.max(0, diskTot - diskUsed).toFixed(2) + ' GB free headroom');
    const dBar = document.getElementById('monDiskBar');
    if (dBar) { dBar.style.width = diskPct.toFixed(1) + '%'; dBar.className = 'st-bar-fill ' + barToneClass(diskPct); }

    setTxt('monNetVal', fmtBytesCompact(Number(latest.net_rx_bytes || 0) + Number(latest.net_tx_bytes || 0)));
    setTxt('monNetMeta', 'RX ' + fmtBytesCompact(latest.net_rx_bytes) + ' • TX ' + fmtBytesCompact(latest.net_tx_bytes));
    setTxt('monSampleAge', fmtRelTimestamp(latest.recorded_at));
  } else {
    setTxt('monCpuVal', '--%');
    setTxt('monCpuLoadTag', 'No data');
    setTxt('monCpuMeta', 'Click Collect Live Sample Now');
    setTxt('monRamVal', '--');
    setTxt('monRamPctTag', '--%');
    setTxt('monRamMeta', 'No samples recorded yet');
    setTxt('monDiskVal', '--');
    setTxt('monDiskPctTag', '--%');
    setTxt('monDiskMeta', 'No samples recorded yet');
    setTxt('monNetVal', '0 B');
    setTxt('monNetMeta', 'RX 0 B • TX 0 B');
    setTxt('monSampleAge', 'Idle');
  }

  const firedRules = rules.filter(r => r.last_triggered_at).length;
  const alTag = document.getElementById('monAlertStateTag');
  if (alTag) {
    alTag.className = 'st-tag ' + (firedRules > 0 ? 'amber' : 'emerald');
    alTag.textContent = rules.length === 0 ? 'No Rules' : (firedRules > 0 ? firedRules + ' Triggered' : rules.length + ' Armed');
  }

  const chartSlice = history.slice(-60);
  renderDualSeriesSvg(
    'monChartCompute',
    chartSlice,
    { color: '#22d3ee', fixedMax: 100, unit: '%', get: (r) => Number(r.cpu_percent || 0) },
    { color: '#818cf8', fixedMax: 100, unit: '%', get: (r) => r.ram_total_mb > 0 ? (Number(r.ram_used_mb || 0) / Number(r.ram_total_mb)) * 100 : 0 }
  );
  renderDualSeriesSvg(
    'monChartSystem',
    chartSlice,
    { color: '#34d399', fixedMax: 100, unit: '%', get: (r) => r.disk_total_gb > 0 ? (Number(r.disk_used_gb || 0) / Number(r.disk_total_gb)) * 100 : 0 },
    { color: '#fbbf24', fixedMax: 100, unit: '%', get: (r) => Math.min(100, Number(r.load_avg_1 || 0) * 12.5) }
  );

  const rows = history.slice(-25).reverse();
  document.getElementById('monMetricsBox').innerHTML = rows.length
    ? `<table class="st-table"><thead><tr><th>Timestamp</th><th>CPU %</th><th>Load (1m)</th><th>Memory</th><th>Disk</th><th>Net RX / TX</th></tr></thead><tbody>` +
      rows.map(r => {
        const cpuP = Math.min(100, Math.max(0, Number(r.cpu_percent || 0)));
        const ramP = r.ram_total_mb > 0 ? Math.min(100, (Number(r.ram_used_mb || 0) / Number(r.ram_total_mb)) * 100) : 0;
        const dskP = r.disk_total_gb > 0 ? Math.min(100, (Number(r.disk_used_gb || 0) / Number(r.disk_total_gb)) * 100) : 0;
        return `<tr>
          <td>
            <div style="font-weight:600;font-size:12px;">${hkvmEsc(r.recorded_at)}</div>
            <div style="font-size:10.5px;color:var(--text-muted);">${hkvmEsc(fmtRelTimestamp(r.recorded_at))}</div>
          </td>
          <td style="min-width:105px;">
            <div style="font-weight:700;font-size:12.5px;">${cpuP.toFixed(2)}%</div>
            <div class="st-bar-track" style="height:5px;margin-top:4px;"><div class="st-bar-fill ${barToneClass(cpuP)}" style="width:${cpuP.toFixed(1)}%"></div></div>
          </td>
          <td><span class="st-mono-chip">${Number(r.load_avg_1 || 0).toFixed(2)}</span></td>
          <td style="min-width:135px;">
            <div style="font-size:12px;"><strong>${r.ram_used_mb}</strong> <span style="color:var(--text-muted);">/ ${r.ram_total_mb} MB</span></div>
            <div class="st-bar-track" style="height:5px;margin-top:4px;"><div class="st-bar-fill ${barToneClass(ramP)}" style="width:${ramP.toFixed(1)}%"></div></div>
          </td>
          <td style="min-width:125px;">
            <div style="font-size:12px;"><strong>${Number(r.disk_used_gb || 0).toFixed(1)}</strong> <span style="color:var(--text-muted);">/ ${Number(r.disk_total_gb || 0).toFixed(1)} GB</span></div>
            <div class="st-bar-track" style="height:5px;margin-top:4px;"><div class="st-bar-fill ${barToneClass(dskP)}" style="width:${dskP.toFixed(1)}%"></div></div>
          </td>
          <td style="font-size:11.5px;color:var(--text-secondary);white-space:nowrap;">
            &darr; ${fmtBytesCompact(r.net_rx_bytes)}<br>&uarr; ${fmtBytesCompact(r.net_tx_bytes)}
          </td>
        </tr>`;
      }).join('') +
      `</tbody></table>`
    : '<div style="padding:32px 20px;text-align:center;color:var(--text-muted);font-size:13px;">Click <strong>Collect Live Sample Now</strong> to record an immediate telemetry snapshot.</div>';

  const metricLabel = (m) => {
    if (m === 'cpu_percent') return 'Host CPU';
    if (m === 'ram_percent') return 'Host Memory';
    if (m === 'disk_percent') return 'Host Disk';
    return m;
  };

  document.getElementById('alertsBody').innerHTML = rules.length
    ? rules.map(a => {
        const isCrit = String(a.severity || '').toLowerCase() === 'critical';
        return `<tr>
          <td>
            <strong style="font-size:13px;">${hkvmEsc(a.name)}</strong>
            <div style="font-size:11px;color:var(--text-muted);">${hkvmEsc(metricLabel(a.metric))}</div>
          </td>
          <td><span class="st-mono-chip">${hkvmEsc(a.operator || '>=')} ${a.threshold}%</span></td>
          <td><span class="st-tag ${isCrit ? 'red' : 'amber'}">${hkvmEsc(String(a.severity || 'warning').toUpperCase())}</span></td>
          <td style="font-size:12px;color:var(--text-muted);">${a.last_triggered_at ? hkvmEsc(fmtRelTimestamp(a.last_triggered_at)) : 'Never'}</td>
          <td style="text-align:right;"><button class="btn btn-outline" style="color:#ef4444;font-size:11.5px;padding:5px 9px;" onclick="delAlert(${a.id})">Delete</button></td>
        </tr>`;
      }).join('')
    : '<tr><td colspan="5" style="text-align:center;color:var(--text-muted);padding:20px;">No alert rules configured yet. Create one above to monitor CPU, RAM, or Disk spikes.</td></tr>';
}

async function pollNodeNow(silent) {
  const btn = document.getElementById('monPollNowBtn');
  if (!silent && btn) { btn.disabled = true; btn.textContent = 'Sampling...'; }
  try {
    const nodeId = document.getElementById('monNodeSelect').value;
    await hkvmApi('/api/v1/nodes/' + nodeId + '/check', { method: 'POST' });
    if (!silent) hkvmToast('Live telemetry sample recorded');
    await loadMonitoring();
  } catch (err) {
    if (!silent) hkvmToast(err.message, 'error');
  } finally {
    if (btn) { btn.disabled = false; btn.textContent = 'Collect Live Sample Now'; }
  }
}

async function submitAlertRule(e) {
  e.preventDefault();
  try {
    await hkvmApi('/api/v1/monitoring/alerts', {
      method: 'POST',
      body: {
        name: document.getElementById('alName').value.trim(),
        metric: document.getElementById('alMetric').value,
        operator: document.getElementById('alOp') ? document.getElementById('alOp').value : '>=',
