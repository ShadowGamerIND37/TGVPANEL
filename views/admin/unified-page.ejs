// --- Node Diagnostic & Host Console Studio Controllers ---
let _ncActivePreset = 'uptime';
let _ncActiveCategory = 'all';
let _ncRawOutput = '';
let _ncHistory = [];
let _ncTerm = null;
let _ncFitAddon = null;
let _ncWs = null;
let _ncFontSize = 13;
let _ncResizeObs = null;

function formatUptimeHuman(sec) {
  const s = Math.max(0, Number(sec || 0));
  const d = Math.floor(s / 86400);
  const h = Math.floor((s % 86400) / 3600);
  const m = Math.floor((s % 3600) / 60);
  if (d > 0) return `${d}d ${h}h ${m}m`;
  if (h > 0) return `${h}h ${m}m`;
  return `${m}m ${Math.floor(s % 60)}s`;
}

function ansiToSafeHtml(rawText) {
  const escaped = hkvmEsc(String(rawText || ''));
  let openSpan = false;
  const html = escaped.replace(/\x1b\[([0-9;]*)m/g, (_m, codesStr) => {
    const codes = String(codesStr || '0').split(';').map(Number);
    let prefix = openSpan ? '</span>' : '';
    openSpan = false;
    if (codes.includes(0) && codes.length === 1) return prefix;
    let cls = '';
    if (codes.includes(32) || codes.includes(92)) cls = 'nc-ansi-green';
    else if (codes.includes(33) || codes.includes(93)) cls = 'nc-ansi-yellow';
    else if (codes.includes(31) || codes.includes(91)) cls = 'nc-ansi-red';
    else if (codes.includes(36) || codes.includes(96)) cls = 'nc-ansi-cyan';
    else if (codes.includes(1)) cls = 'nc-ansi-bold';
    if (cls) {
      openSpan = true;
      return `${prefix}<span class="${cls}">`;
    }
    return prefix;
  }).replace(/\x1b\[[0-9;?]*[A-Za-z]/g, '');
  return openSpan ? html + '</span>' : html;
}

async function refreshNodeConsoleTelemetry() {
  const sel = document.getElementById('diagNode');
  if (!sel || !sel.value) return;
  const btn = document.getElementById('ncRefreshTelemetryBtn');
  if (btn) btn.disabled = true;
  try {
    const rep = await hkvmApi('/api/v1/nodes/' + sel.value + '/check', { method: 'POST' });
    const st = rep.stats || {};
    const hl = rep.health || {};
    const caps = hl.capabilities || {};

    const statePill = document.getElementById('ncNodeStatePill');
    if (statePill) {
      const online = hl.status === 'online';
      statePill.className = 'v3-pill ' + (online ? 'online' : 'warning');
      statePill.innerHTML = '&bull; ' + (online ? 'ONLINE' : String(hl.status || 'DEGRADED').toUpperCase());
    }
    const hostMeta = document.getElementById('ncHostMeta');
    if (hostMeta) {
      hostMeta.textContent = `${st.hostname || hl.hostname || 'host'} • ${st.cpuModel || 'Linux Host'}`;
    }
    const upMeta = document.getElementById('ncUptimeMeta');
    if (upMeta) {
      const skewStr = typeof hl.agentTimeEpochSec === 'number'
        ? ` • Clock skew ${hl.agentTimeEpochSec - Math.floor(Date.now() / 1000)}s`
        : '';
      upMeta.textContent = `Uptime ${formatUptimeHuman(st.uptimeSeconds || hl.uptimeSeconds)}${skewStr}`;
    }
    const verEl = document.getElementById('ncAgentVer');
    if (verEl && hl.agentVersion) verEl.textContent = 'v' + hl.agentVersion;

    // Dynamically toggle Interactive Host PTY Shell availability per selected node!
    if (typeof hl.interactiveShellEnabled === 'boolean') {
      const ptyOn = Boolean(hl.interactiveShellEnabled);
      const showEl = (id, vis, disp = '') => {
        const el = document.getElementById(id);
        if (el) el.style.display = vis ? disp : 'none';
      };
      showEl('ncPtyEnabledBadge', ptyOn, 'inline-flex');
      showEl('ncPtyStateBadge', ptyOn, 'inline-flex');
      showEl('ncPtyLockedBadge', !ptyOn, 'inline-flex');
      showEl('ncPtyToolbar', ptyOn, 'flex');
      showEl('ncPtyLockedPane', !ptyOn, '');
      showEl('nodeXtermBox', ptyOn, 'block');
    }

    const cpuPct = Math.min(100, Math.max(0, Number(st.cpuPercent || 0)));
    document.getElementById('ncCpuVal').textContent = cpuPct.toFixed(1) + '%';
    document.getElementById('ncCpuBar').style.width = cpuPct + '%';
    document.getElementById('ncCpuCores').textContent = (st.cpuCores || 0) + ' vCPU Cores';
    document.getElementById('ncLoadAvg').textContent =
      `Load: ${Number(st.loadAvg1 || 0).toFixed(2)} / ${Number(st.loadAvg5 || 0).toFixed(2)}`;

    const ramPct = Math.min(100, Math.max(0, Number(st.ramPercent || 0)));
    document.getElementById('ncRamVal').textContent = ramPct.toFixed(1) + '%';
    document.getElementById('ncRamBar').style.width = ramPct + '%';
    document.getElementById('ncRamDetail').textContent =
      `${st.ramUsedMb || 0} / ${st.ramTotalMb || 0} MB`;
    document.getElementById('ncSwapDetail').textContent =
      `Swap: ${st.swapUsedMb || 0}/${st.swapTotalMb || 0} MB`;

    const diskPct = Math.min(100, Math.max(0, Number(st.diskPercent || 0)));
    document.getElementById('ncDiskVal').textContent = diskPct.toFixed(1) + '%';
    document.getElementById('ncDiskBar').style.width = diskPct + '%';
    document.getElementById('ncDiskDetail').textContent =
      `${st.diskUsedGb || 0} / ${st.diskTotalGb || 0} GB`;
    document.getElementById('ncDiskFree').textContent = `${st.diskAvailableGb || 0} GB free`;

    const setDot = (id, state) => {
      const el = document.getElementById(id);
      if (el) el.className = 'nc-dot ' + state;
    };
    setDot('ncCapKvm', caps.kvmDevicePresent ? 'ok' : (caps.qemuSystemAvailable ? 'warn' : 'off'));
    setDot('ncCapQemu', caps.qemuSystemAvailable ? 'ok' : 'off');
    setDot('ncCapLxc', caps.lxcAvailable ? 'ok' : 'off');
  } catch (err) {
    const statePill = document.getElementById('ncNodeStatePill');
    if (statePill) {
      statePill.className = 'v3-pill offline';
      statePill.innerHTML = '&bull; UNREACHABLE';
    }
  } finally {
    if (btn) btn.disabled = false;
  }
}

function setNcCategory(cat, btnEl) {
  _ncActiveCategory = cat;
  document.querySelectorAll('.nc-cat-btn').forEach(b => b.classList.remove('active'));
  if (btnEl) btnEl.classList.add('active');
  filterNcPresets();
}

function filterNcPresets() {
  const q = (document.getElementById('ncPresetSearch')?.value || '').trim().toLowerCase();
  document.querySelectorAll('.nc-preset-btn').forEach(btn => {
    const catOk = _ncActiveCategory === 'all' || btn.dataset.cat === _ncActiveCategory;
    const searchOk = !q || (btn.dataset.search || '').includes(q);
    btn.style.display = (catOk && searchOk) ? 'flex' : 'none';
  });
}

function renderNcHistory() {
  const wrap = document.getElementById('ncHistoryChips');
  if (!wrap) return;
  if (!_ncHistory.length) {
    wrap.innerHTML = '<span style="color:var(--text-muted);">None yet</span>';
    return;
  }
  wrap.innerHTML = _ncHistory.map((item, idx) =>
    `<button type="button" class="nc-hist-chip" onclick="restoreNcHistory(${idx})" title="${hkvmEsc(item.command)} (${item.exitCode === 0 ? 'OK' : 'exit ' + item.exitCode})">${hkvmEsc(item.preset)} <span style="color:${item.exitCode === 0 ? '#10b981' : '#f59e0b'};">&bull;</span></button>`
  ).join('');
}

function restoreNcHistory(idx) {
  const item = _ncHistory[idx];
  if (!item) return;
  applyDiagResultToView(item);
}

function applyDiagResultToView(res) {
  _ncActivePreset = res.preset || _ncActivePreset;
  document.querySelectorAll('.nc-preset-btn').forEach(b => {
    b.classList.toggle('active', b.dataset.preset === _ncActivePreset);
  });

  const cmdEl = document.getElementById('ncCmdDisplay');
  if (cmdEl) {
    cmdEl.innerHTML = `<span class="prompt">$</span>${hkvmEsc(res.command || res.preset)}`;
  }
  const exitEl = document.getElementById('ncExitBadge');
  if (exitEl) {
    exitEl.style.display = 'inline-flex';
    exitEl.className = 'v3-pill ' + (res.exitCode === 0 ? 'online' : 'warning');
    exitEl.textContent = 'EXIT ' + res.exitCode;
  }
  const durEl = document.getElementById('ncDurationBadge');
  if (durEl) {
    durEl.textContent = typeof res.durationMs === 'number' ? `${res.durationMs} ms` : '';
  }
  const tsEl = document.getElementById('ncExecTimestamp');
  if (tsEl && res.executedAt) {
    const dt = new Date(res.executedAt);
    tsEl.textContent = `${res.description || ''} • ${isNaN(dt.getTime()) ? res.executedAt : dt.toLocaleTimeString()}`;
  }

  _ncRawOutput = `# [${res.executedAt}] ${res.description} ($ ${res.command || res.preset}) [exit=${res.exitCode}]\n\n${res.output || ''}`;
  const outEl = document.getElementById('diagOutput');
  if (outEl) {
    outEl.innerHTML = ansiToSafeHtml(res.output || '');
    outEl.scrollTop = 0;
  }
}

async function runDiag(preset) {
  const nodeSel = document.getElementById('diagNode');
  if (!nodeSel || !nodeSel.value) return;
  _ncActivePreset = preset;
  document.querySelectorAll('.nc-preset-btn').forEach(b => {
    b.classList.toggle('active', b.dataset.preset === preset);
  });
  const outEl = document.getElementById('diagOutput');
  const cmdEl = document.getElementById('ncCmdDisplay');
  if (cmdEl) cmdEl.innerHTML = `<span class="prompt">$</span>Running ${hkvmEsc(preset)}...`;
  if (outEl) outEl.innerHTML = `<span style="color:#94a3b8;">Executing allowlisted diagnostic preset <strong>${hkvmEsc(preset)}</strong>...</span>`;

  try {
    const res = await hkvmApi('/api/v1/nodes/' + nodeSel.value + '/diagnostics/' + preset, { method: 'POST' });
    applyDiagResultToView(res);
    _ncHistory = [res, ..._ncHistory.filter(h => h.preset !== res.preset)].slice(0, 6);
    renderNcHistory();
  } catch (err) {
    _ncRawOutput = 'Error: ' + err.message;
    if (outEl) outEl.innerHTML = `<span class="nc-ansi-red">Error: ${hkvmEsc(err.message)}</span>`;
  }
}

function rerunActiveDiag() {
  runDiag(_ncActivePreset || 'uptime');
}

async function runNodeHealthSuite() {
  const nodeSel = document.getElementById('diagNode');
  if (!nodeSel || !nodeSel.value) return;
  const btn = document.getElementById('ncHealthSuiteBtn');
  if (btn) { btn.disabled = true; btn.textContent = 'Running Suite...'; }
  const outEl = document.getElementById('diagOutput');
  const suitePresets = ['uname', 'uptime', 'memory', 'disk', 'network_links', 'bridges', 'lxc_list'];
  const sections = [];
  const started = Date.now();
  try {
    if (outEl) outEl.innerHTML = '<span style="color:#22d3ee;">Running 7-point allowlisted host health suite...</span>';
    for (const p of suitePresets) {
      const r = await hkvmApi('/api/v1/nodes/' + nodeSel.value + '/diagnostics/' + p, { method: 'POST' });
      sections.push(`\x1b[1m=== [${p.toUpperCase()}] $ ${r.command || p} (exit=${r.exitCode}) ===\x1b[0m\n${r.output}`);
    }
    const combined = {
      preset: 'health_suite',
      description: '7-Point Host Health & Network Suite',
      command: suitePresets.join(' && '),
      exitCode: 0,
      durationMs: Date.now() - started,
      output: sections.join('\n\n'),
      executedAt: new Date().toISOString()
    };
    applyDiagResultToView(combined);
    _ncHistory = [combined, ..._ncHistory.filter(h => h.preset !== 'health_suite')].slice(0, 6);
    renderNcHistory();
    hkvmToast('Full host diagnostic suite completed');
  } catch (err) {
    hkvmToast(err.message, 'error');
  } finally {
    if (btn) { btn.disabled = false; btn.innerHTML = '&#9654; Run Full Health Check'; }
  }
}

function toggleDiagWrap() {
  const outEl = document.getElementById('diagOutput');
  const btn = document.getElementById('ncWrapBtn');
  if (!outEl) return;
  const wrapped = outEl.classList.toggle('wrap');
  if (btn) btn.textContent = 'Wrap: ' + (wrapped ? 'On' : 'Off');
}

async function copyDiagOutput() {
  const text = _ncRawOutput || document.getElementById('diagOutput')?.innerText || '';
  if (!text.trim()) return hkvmToast('Nothing to copy yet', 'warning');
  try {
    await navigator.clipboard.writeText(text);
    hkvmToast('Diagnostic output copied to clipboard');
  } catch {
    hkvmToast('Clipboard access unavailable in this browser context', 'warning');
  }
}

function downloadDiagOutput() {
  const text = _ncRawOutput || document.getElementById('diagOutput')?.innerText || '';
  if (!text.trim()) return hkvmToast('Run a diagnostic preset first', 'warning');
  const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `tgvpanel-node-diag-${_ncActivePreset || 'report'}-${Date.now()}.log`;
  document.body.appendChild(a);
  a.click();
  a.remove();
}

function clearDiagOutput() {
  _ncRawOutput = '';
  const outEl = document.getElementById('diagOutput');
  if (outEl) outEl.innerHTML = '<span style="color:#64748b;">Console cleared. Select a preset on the left to inspect live host state.</span>';
  const exitEl = document.getElementById('ncExitBadge');
  if (exitEl) exitEl.style.display = 'none';
}

async function copyNodeShellEnvFlag() {
  try {
    await navigator.clipboard.writeText('TGVPANEL_ENABLE_NODE_SHELL=true');
    hkvmToast('Copied TGVPANEL_ENABLE_NODE_SHELL=true to clipboard');
  } catch {
    hkvmToast('Set TGVPANEL_ENABLE_NODE_SHELL=true in .env');
  }
}

function onNodeConsoleSwitch() {
  if (_ncWs) disconnectNodeShell();
  refreshNodeConsoleTelemetry();
  runDiag(_ncActivePreset === 'health_suite' ? 'uptime' : (_ncActivePreset || 'uptime'));
}

function setPtyStateBadge(label, pillClass) {
  const el = document.getElementById('ncPtyStateBadge');
  if (!el) return;
  el.className = 'v3-pill ' + pillClass;
  el.textContent = label;
}

function connectNodeShell() {
  const box = document.getElementById('nodeXtermBox');
  if (!box) return;
  if (_ncWs) {
    try { _ncWs.close(); } catch {}
    _ncWs = null;
  }
  if (_ncResizeObs) {
    try { _ncResizeObs.disconnect(); } catch {}
    _ncResizeObs = null;
  }
  box.innerHTML = '';
  _ncTerm = new Terminal({
    cursorBlink: true,
    fontSize: _ncFontSize,
    fontFamily: 'ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace',
    theme: { background: '#06070c', foreground: '#f1f5f9', cursor: '#22d3ee' }
  });
  _ncFitAddon = new FitAddon.FitAddon();
  _ncTerm.loadAddon(_ncFitAddon);
  _ncTerm.open(box);
  _ncFitAddon.fit();

  const nodeId = document.getElementById('diagNode').value;
  const proto = location.protocol === 'https:' ? 'wss:' : 'ws:';
  setPtyStateBadge('Connecting...', 'warning');
  _ncWs = new WebSocket(`${proto}//${location.host}/ws/nodes/${nodeId}/shell?cols=${_ncTerm.cols}&rows=${_ncTerm.rows}`);

  const connBtn = document.getElementById('ncPtyConnectBtn');
  const discBtn = document.getElementById('ncPtyDisconnectBtn');

  _ncWs.onopen = () => {
    setPtyStateBadge('Connected • Live PTY', 'online');
    if (connBtn) connBtn.innerHTML = '&#8635; Reconnect';
    if (discBtn) discBtn.style.display = 'inline-flex';
    _ncTerm.focus();
  };

  _ncWs.onmessage = (ev) => {
    try {
      const m = JSON.parse(ev.data);
      if (m.type === 'output') _ncTerm.write(m.data);
      else if (m.type === 'error') _ncTerm.writeln('\r\n\x1b[31m[Policy/Error] ' + m.message + '\x1b[0m');
      else if (m.type === 'exit') _ncTerm.writeln('\r\n\x1b[33m[Host shell exited with code ' + m.exitCode + ']\x1b[0m');
    } catch {
      _ncTerm.write(ev.data);
    }
  };

  _ncWs.onclose = () => {
    setPtyStateBadge('Disconnected', 'stopped');
    if (discBtn) discBtn.style.display = 'none';
  };

  _ncTerm.onData(d => {
    if (_ncWs && _ncWs.readyState === WebSocket.OPEN) {
      _ncWs.send(JSON.stringify({ type: 'input', data: d }));
    }
  });

  if (typeof ResizeObserver !== 'undefined') {
    _ncResizeObs = new ResizeObserver(() => {
      if (!_ncFitAddon || !_ncTerm) return;
      try {
        _ncFitAddon.fit();
        if (_ncWs && _ncWs.readyState === WebSocket.OPEN) {
          _ncWs.send(JSON.stringify({ type: 'resize', cols: _ncTerm.cols, rows: _ncTerm.rows }));
        }
      } catch {}
    });
    _ncResizeObs.observe(box);
  }
}

function disconnectNodeShell() {
  if (_ncWs) {
    try { _ncWs.close(); } catch {}
    _ncWs = null;
  }
  setPtyStateBadge('Disconnected', 'stopped');
  const discBtn = document.getElementById('ncPtyDisconnectBtn');
  if (discBtn) discBtn.style.display = 'none';
}

function clearNodeShell() {
  if (_ncTerm) _ncTerm.clear();
}

function adjustNodeShellFont(delta) {
  _ncFontSize = Math.min(22, Math.max(10, _ncFontSize + delta));
  if (_ncTerm) {
    _ncTerm.options.fontSize = _ncFontSize;
    if (_ncFitAddon) _ncFitAddon.fit();
  }
}

function toggleNodeShellFullscreen() {
  const card = document.getElementById('ncPtyCard');
  const btn = document.getElementById('ncPtyFsBtn');
  if (!card) return;
  const fs = card.classList.toggle('fullscreen');
  if (btn) btn.innerHTML = fs ? '&#10005; Exit Fullscreen' : '&#9974; Fullscreen';
  setTimeout(() => {
    if (_ncFitAddon && _ncTerm) {
      _ncFitAddon.fit();
      if (_ncWs && _ncWs.readyState === WebSocket.OPEN) {
        _ncWs.send(JSON.stringify({ type: 'resize', cols: _ncTerm.cols, rows: _ncTerm.rows }));
      }
    }
  }, 60);
}

function initNodeConsoleStudio() {
  refreshNodeConsoleTelemetry();
  runDiag('uptime');
}

document.addEventListener('DOMContentLoaded', async () => {
  if (CURRENT_SECTION === 'instances') loadUnifiedInstances();
  if (CURRENT_SECTION === 'instances-create') initLxcCreateStudio();
  if (CURRENT_SECTION === 'lxc') loadLxcList();
  if (CURRENT_SECTION === 'nodes') loadNodes();
  if (CURRENT_SECTION === 'storage') loadStorage(true);
  if (CURRENT_SECTION === 'isos') loadIsos();
  if (CURRENT_SECTION === 'lxc-templates') loadLxcTemplates();
  if (CURRENT_SECTION === 'networking') loadNetworking();
  if (CURRENT_SECTION === 'ports') loadPorts();
  if (CURRENT_SECTION === 'firewall') loadFirewall();
  if (CURRENT_SECTION === 'snapshots') { await populateInstanceDropdown('snapInstSelect'); loadAdminSnapshots(); }
  if (CURRENT_SECTION === 'backups') { await populateInstanceDropdown('bkpInstSelect'); loadBackups(); }
  if (CURRENT_SECTION === 'migrations') { await populateInstanceDropdown('migLxcSelect', 'lxc'); loadMigrations(); }
  if (CURRENT_SECTION === 'monitoring') loadMonitoring();
  if (CURRENT_SECTION === 'api-keys') loadApiKeysAndWebhooks();
  if (CURRENT_SECTION === 'audit-logs') loadAuditLogs();
  if (CURRENT_SECTION === 'node-console') initNodeConsoleStudio();
});
</script>
</body>
