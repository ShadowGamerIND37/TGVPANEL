          <button class="btn btn-primary" onclick="openNodeInspector(${n.id})" style="font-size:12px;padding:6px 11px;">Inspect</button>
          <button class="btn btn-outline" id="chkNodeBtn_${n.id}" onclick="checkNode(${n.id})" style="font-size:12px;padding:6px 10px;">Probe</button>
          ${!n.is_local ? `<button class="btn btn-outline" onclick="openNodePairDrawer(${n.id})" style="font-size:12px;padding:6px 10px;" title="Generate 1-Command Auto-Join script or view .env credentials">Pair</button>` : ''}
          <button class="btn btn-outline" onclick="toggleNodeCordon(${n.id}, ${!n.maintenance_mode})" style="font-size:12px;padding:6px 10px;">${n.maintenance_mode ? 'Uncordon' : 'Cordon'}</button>
          <button class="btn btn-outline" onclick="rotateNode(${n.id})" style="font-size:12px;padding:6px 10px;">Keys</button>
          ${!n.is_local ? `<button class="btn btn-outline" style="color:#ef4444;font-size:12px;padding:6px 10px;" onclick="delNode(${n.id})">Remove</button>` : ''}
        </div>
      </td>
    </tr>`;
  }).join('');
}

function renderNodesCards() {
  const wrap = document.getElementById('nodesCardsWrap');
  if (!wrap) return;
  const list = getFilteredNodesList();
  if (!list.length) {
    wrap.innerHTML = '<div style="grid-column:1/-1;text-align:center;color:var(--text-muted);padding:28px;">No nodes match the selected filter.</div>';
    return;
  }

  wrap.innerHTML = list.map(n => {
    const tags = parseNodeTags(n.tags);
    const cpuPct = Number(n.live_cpu_percent || 0);
    const ramPct = n.ram_total_mb > 0 ? Math.min(100, (Number(n.live_ram_used_mb || 0) / Number(n.ram_total_mb)) * 100) : 0;
    const dskPct = n.disk_total_gb > 0 ? Math.min(100, (Number(n.live_disk_used_gb || 0) / Number(n.disk_total_gb)) * 100) : 0;
    const statusCls = n.maintenance_mode ? 'amber' : (n.status === 'online' ? 'emerald' : 'muted');
    const statusLbl = n.maintenance_mode ? 'CORDONED' : String(n.status || 'unknown').toUpperCase();

    return `<div class="nd-card ${n.maintenance_mode ? 'cordoned' : ''}">
      <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:10px;">
        <div>
          <div style="display:flex;align-items:center;gap:7px;flex-wrap:wrap;">
            <strong style="font-size:15px;color:var(--text-primary);">${hkvmEsc(n.name)}</strong>
            <span class="st-tag ${n.is_local ? 'cyan' : 'violet'}">${n.is_local ? 'LOCAL' : 'REMOTE #' + n.id}</span>
          </div>
          <div style="font-size:11.5px;color:var(--text-muted);margin-top:3px;">
            ${hkvmEsc(n.location || 'Datacenter')} &bull; <code>${hkvmEsc(n.ip_address || '127.0.0.1')}</code>
            ${n.latency_ms ? ' &bull; ' + n.latency_ms + 'ms' : ''}
          </div>
        </div>
        <span class="st-tag ${statusCls}">${hkvmEsc(statusLbl)}</span>
      </div>

      <div class="nd-mini-metrics">
        <div>
          <div class="nd-mini-k">Host CPU</div>
          <div class="nd-mini-v">${n.live_cpu_percent !== null && n.live_cpu_percent !== undefined ? cpuPct.toFixed(1) + '%' : Number(n.cpu_cores || 0) + 'c'}</div>
          <div class="st-bar-track" style="height:4px;margin-top:5px;"><div class="st-bar-fill ${barToneClass(cpuPct)}" style="width:${Math.min(100, cpuPct).toFixed(0)}%"></div></div>
        </div>
        <div>
          <div class="nd-mini-k">Host RAM</div>
          <div class="nd-mini-v">${n.live_ram_used_mb ? ramPct.toFixed(0) + '%' : fmtMbAsGb(n.ram_total_mb)}</div>
          <div class="st-bar-track" style="height:4px;margin-top:5px;"><div class="st-bar-fill ${barToneClass(ramPct)}" style="width:${ramPct.toFixed(0)}%"></div></div>
        </div>
        <div>
          <div class="nd-mini-k">Workloads</div>
          <div class="nd-mini-v">${Number(n.total_instances || 0)} / ${Number(n.max_instances || 100)}</div>
          <div style="font-size:10.5px;color:#34d399;margin-top:3px;">${Number(n.kvm_count || 0)} KVM • ${Number(n.lxc_count || 0)} LXC</div>
        </div>
      </div>

      <div style="display:flex;gap:5px;flex-wrap:wrap;align-items:center;">
        ${n.kvm_available ? '<span class="st-tag indigo">&#10003; KVM</span>' : '<span class="st-tag muted">KVM N/A</span>'}
        ${n.lxc_available ? '<span class="st-tag cyan">&#10003; LXC</span>' : '<span class="st-tag muted">LXC N/A</span>'}
        ${n.cgroup_version === 'v2' ? '<span class="st-tag emerald">cgroup v2</span>' : ''}
        ${tags.map(t => `<span class="nd-tag-chip">#${hkvmEsc(t)}</span>`).join('')}
      </div>

      ${n.notes ? `<div style="font-size:11.5px;color:var(--text-muted);border-left:2px solid rgba(99,102,241,0.4);padding-left:8px;">${hkvmEsc(n.notes)}</div>` : ''}

      ${(!n.is_local && n.status !== 'online' && n.last_error) ? `
        <div style="font-size:11px;color:#f87171;padding:7px 9px;border-radius:8px;background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.28);">
          &#9888; ${hkvmEsc(n.last_error)}
        </div>
      ` : ''}

      <div style="display:flex;gap:7px;flex-wrap:wrap;margin-top:auto;padding-top:10px;border-top:1px solid var(--border-subtle);">
        <button class="btn btn-primary" style="flex:1;font-size:12px;padding:7px 10px;" onclick="openNodeInspector(${n.id})">Inspect &amp; Configure</button>
        <button class="btn btn-outline" style="font-size:12px;padding:7px 10px;" onclick="checkNode(${n.id})">Probe</button>
        ${!n.is_local ? `<button class="btn btn-outline" style="font-size:12px;padding:7px 10px;" onclick="openNodePairDrawer(${n.id})">Pair</button>` : ''}
        <button class="btn btn-outline" style="font-size:12px;padding:7px 10px;" onclick="toggleNodeCordon(${n.id}, ${!n.maintenance_mode})">${n.maintenance_mode ? 'Uncordon' : 'Cordon'}</button>
      </div>
    </div>`;
  }).join('');
}

async function toggleNodeCordon(nodeId, enableMaint) {
  try {
    await hkvmApi('/api/v1/nodes/' + nodeId, {
      method: 'PATCH',
      body: { maintenanceMode: Boolean(enableMaint) }
    });
    hkvmToast(enableMaint ? 'Node #' + nodeId + ' cordoned (Maintenance Mode active)' : 'Node #' + nodeId + ' uncordoned & active for scheduling');
    await loadNodes();
    if (__inspectorNodeId === nodeId) await reloadInspectorNode();
  } catch (err) {
    hkvmToast(err.message, 'error');
  }
}

async function resetNodeCircuit(nodeId) {
  try {
    const res = await hkvmApi('/api/v1/nodes/' + nodeId + '/reset-circuit', {
      method: 'POST',
      body: { probe: true }
    });
    hkvmToast(res.probeOk ? 'Circuit breaker reset — node is online!' : 'Circuit reset, but node probe still unreachable', res.probeOk ? 'info' : 'warning');
    await loadNodes();
    if (__inspectorNodeId === nodeId) await reloadInspectorNode();
  } catch (err) {
    hkvmToast(err.message, 'error');
  }
}

async function openNodeInspector(nodeId) {
  __inspectorNodeId = nodeId;
  __inspectorTab = 'overview';
  const modal = document.getElementById('nodeInspectorModal');
  if (modal) modal.classList.add('open');
  document.querySelectorAll('#niTabBar .nd-tab-btn').forEach((b, idx) => b.classList.toggle('active', idx === 0));
  await reloadInspectorNode();
}

function closeNodeInspector() {
  __inspectorNodeId = null;
  const modal = document.getElementById('nodeInspectorModal');
  if (modal) modal.classList.remove('open');
}

function switchInspectorTab(tab, btnEl) {
  __inspectorTab = tab;
  document.querySelectorAll('#niTabBar .nd-tab-btn').forEach(b => b.classList.remove('active'));
  if (btnEl) btnEl.classList.add('active');
  renderInspectorBody();
}

async function reloadInspectorNode() {
  if (!__inspectorNodeId) return;
  const body = document.getElementById('niModalBody');
  if (body && !__inspectorData) {
    body.innerHTML = '<div style="text-align:center;padding:36px;color:var(--text-muted);">Probing live node telemetry &amp; workload inventory...</div>';
  }
  try {
    __inspectorData = await hkvmApi('/api/v1/nodes/' + __inspectorNodeId + '/detail');
    const n = __inspectorData.node;
    const setTxt = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
    setTxt('niHeadBadge', '#' + n.id);
    setTxt('niHeadTitle', n.name + (n.is_local ? ' (Controller Host)' : ''));
    setTxt('niHeadSub', (n.location || 'Datacenter') + ' • ' + n.url + (__inspectorData.latencyMs ? ' • ' + __inspectorData.latencyMs + 'ms RTT' : ''));
    const stEl = document.getElementById('niHeadStatus');
    if (stEl) {
      stEl.className = 'st-tag ' + (n.status === 'online' ? 'emerald' : 'red');
      stEl.textContent = String(n.status || 'unknown').toUpperCase();
    }
    const mEl = document.getElementById('niHeadMaint');
    if (mEl) mEl.style.display = n.maintenance_mode ? 'inline-flex' : 'none';
    const mBtn = document.getElementById('niToggleMaintBtn');
    if (mBtn) mBtn.textContent = n.maintenance_mode ? 'Uncordon Node' : 'Cordon (Maintenance)';

    renderInspectorBody();
    loadNodes();
  } catch (err) {
    if (body) body.innerHTML = `<div style="padding:24px;color:#f87171;">Failed to load node details: ${hkvmEsc(err.message)}</div>`;
  }
}

async function toggleInspectorNodeMaintenance() {
  if (!__inspectorData?.node) return;
  await toggleNodeCordon(__inspectorData.node.id, !__inspectorData.node.maintenance_mode);
}

function renderInspectorBody() {
  const body = document.getElementById('niModalBody');
  if (!body || !__inspectorData) return;
  const { node: n, liveStats: s, liveHealth: h, instances = [], storagePools = [], latencyMs } = __inspectorData;

  if (__inspectorTab === 'overview') {
    const cpuPct = s ? Number(s.cpuPercent || 0) : Number(n.live_cpu_percent || 0);
    const ramUsed = s ? Number(s.ramUsedMb || 0) : Number(n.live_ram_used_mb || 0);
    const ramTot = Math.max(1, s ? Number(s.ramTotalMb || 1) : Number(n.ram_total_mb || 1));
    const ramPct = Math.min(100, (ramUsed / ramTot) * 100);
    const swapUsed = s ? Number(s.swapUsedMb || 0) : 0;
    const swapTot = s ? Number(s.swapTotalMb || 0) : 0;
    const diskUsed = s ? Number(s.diskUsedGb || 0) : Number(n.live_disk_used_gb || 0);
    const diskTot = Math.max(0.1, s ? Number(s.diskTotalGb || 0.1) : Number(n.disk_total_gb || 0.1));
    const diskPct = Math.min(100, (diskUsed / diskTot) * 100);
    const upSec = s ? Number(s.uptimeSeconds || 0) : (h ? Number(h.uptimeSeconds || 0) : 0);
    const upHuman = upSec > 0 ? (Math.floor(upSec / 3600) + 'h ' + Math.floor((upSec % 3600) / 60) + 'm') : 'n/a';
    const warnings = (h && Array.isArray(h.warnings)) ? h.warnings : [];

    body.innerHTML = `
      ${(!n.is_local && n.last_error) ? `
        <div style="margin-bottom:14px;padding:12px 14px;border-radius:10px;border:1px solid rgba(239,68,68,0.4);background:rgba(239,68,68,0.08);display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
          <div>
            <strong style="color:#f87171;font-size:12.5px;">&#9888; Connection / Auth Diagnostic:</strong>
            <div style="font-size:12px;color:#fca5a5;margin-top:3px;">${hkvmEsc(n.last_error)}</div>
          </div>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            ${String(n.url || '').startsWith('https://') ? `<button type="button" class="btn btn-primary" style="font-size:12px;padding:6px 11px;" onclick="trustNodeTls(${n.id})">Pin &amp; Trust TLS Cert</button>` : ''}
            <button type="button" class="btn btn-outline" style="font-size:12px;padding:6px 11px;" onclick="closeNodeInspector();openNodePairDrawer(${n.id});">1-Command Auto-Join / .env</button>
          </div>
        </div>
      ` : ''}
      ${warnings.length ? `<div style="margin-bottom:14px;padding:11px 14px;border-radius:10px;border:1px solid rgba(245,158,11,0.35);background:rgba(245,158,11,0.08);font-size:12px;color:#fbbf24;">${warnings.map(w => '&#9888; ' + hkvmEsc(w)).join('<br>')}</div>` : ''}
      <div class="st-kpi-grid" style="margin-bottom:16px;">
        <div class="st-kpi-card">
          <div class="st-kpi-top"><span class="st-kpi-label">Host CPU</span><span class="st-tag cyan">${Number(n.cpu_cores || 0)} Cores</span></div>
          <div class="st-kpi-val">${cpuPct.toFixed(1)}%</div>
          <div class="st-bar-track"><div class="st-bar-fill ${barToneClass(cpuPct)}" style="width:${Math.min(100, cpuPct).toFixed(1)}%"></div></div>
          <div class="st-kpi-foot"><span>Load: ${s ? `${s.loadAvg1} / ${s.loadAvg5} / ${s.loadAvg15}` : (n.live_load_1 ?? '--')}</span></div>
        </div>
        <div class="st-kpi-card">
          <div class="st-kpi-top"><span class="st-kpi-label">Physical Memory</span><span class="st-tag indigo">${ramPct.toFixed(1)}%</span></div>
          <div class="st-kpi-val">${fmtMbAsGb(ramUsed)}</div>
          <div class="st-bar-track"><div class="st-bar-fill ${barToneClass(ramPct)}" style="width:${ramPct.toFixed(1)}%"></div></div>
          <div class="st-kpi-foot"><span>of ${fmtMbAsGb(ramTot)} • Swap ${swapUsed}/${swapTot}MB</span></div>
        </div>
        <div class="st-kpi-card">
          <div class="st-kpi-top"><span class="st-kpi-label">Root Filesystem</span><span class="st-tag violet">${diskPct.toFixed(1)}%</span></div>
          <div class="st-kpi-val">${diskUsed.toFixed(1)} / ${diskTot.toFixed(1)}G</div>
          <div class="st-bar-track"><div class="st-bar-fill ${barToneClass(diskPct)}" style="width:${diskPct.toFixed(1)}%"></div></div>
          <div class="st-kpi-foot"><span>${Math.max(0, diskTot - diskUsed).toFixed(2)} GB free</span></div>
        </div>
        <div class="st-kpi-card">
          <div class="st-kpi-top"><span class="st-kpi-label">Network &amp; Uptime</span><span class="st-tag emerald">${latencyMs ? latencyMs + 'ms' : 'local'}</span></div>
          <div class="st-kpi-val">${upHuman}</div>
          <div class="st-kpi-foot"><span>${s ? ('RX ' + fmtBytesCompact(s.netRxBytes) + ' • TX ' + fmtBytesCompact(s.netTxBytes)) : 'Telemetry synced'}</span></div>
        </div>
      </div>

      <div class="st-chart-grid" style="margin-bottom:0;">
        <div class="st-panel" style="margin-bottom:0;">
          <div class="st-panel-head"><h4 class="st-panel-title">Hypervisor &amp; Kernel Stack</h4></div>
          <div class="st-panel-body">
            <div class="lic-kv-list">
              <div class="lic-kv-row"><span class="lic-kv-k">CPU Model</span><span class="lic-kv-v">${hkvmEsc(n.cpu_model || 'Unknown')}</span></div>
              <div class="lic-kv-row"><span class="lic-kv-k">Linux Kernel</span><span class="lic-kv-v">${hkvmEsc(n.kernel_version || 'Probing...')}</span></div>
              <div class="lic-kv-row"><span class="lic-kv-k">QEMU / KVM</span><span class="lic-kv-v">${n.kvm_available ? hkvmEsc(n.qemu_version || 'Available') : 'Unavailable'}</span></div>
              <div class="lic-kv-row"><span class="lic-kv-k">Native LXC</span><span class="lic-kv-v">${n.lxc_available ? hkvmEsc(n.lxc_version || 'Available') : 'Unavailable'}</span></div>
