  catch (err) { hkvmToast(err.message, 'error'); }
}

function applyPoolPreset(name, type, scope, poolPath) {
  const nEl = document.getElementById('spName');
  const tEl = document.getElementById('spType');
  const sEl = document.getElementById('spScope');
  const pEl = document.getElementById('spPath');
  if (nEl && !nEl.value) nEl.value = name;
  if (tEl) tEl.value = type;
  if (sEl) sEl.value = scope;
  if (pEl) pEl.value = poolPath;
}

function setStorageScopeFilter(scope, btnEl) {
  __storageScopeFilter = scope;
  document.querySelectorAll('#storageFilterSeg .st-seg-btn').forEach(b => b.classList.remove('active'));
  if (btnEl) btnEl.classList.add('active');
  renderStorageTable();
}

async function loadStorage(sync) {
  const btn = document.getElementById('syncStorageBtn');
  if (sync && btn) { btn.disabled = true; btn.textContent = 'Syncing statfs...'; }
  try {
    const data = await hkvmApi('/api/v1/storage/pools' + (sync ? '?sync=1' : ''));
    __cachedPools = data.pools || [];

    // Deduplicate identical underlying filesystems per node (e.g. two dir pools on same root partition)
    const fsMap = new Map();
    for (const p of __cachedPools) {
      const tot = Number(p.total_bytes || 0);
      const used = Number(p.used_bytes || 0);
      const avail = Number(p.available_bytes || Math.max(0, tot - used));
      const fsKey = tot > 0 ? (p.node_id + ':' + tot) : ('pool:' + p.id);
      if (!fsMap.has(fsKey)) {
        fsMap.set(fsKey, { total: tot, used, avail });
      }
    }
    let uniqueTotal = 0, uniqueUsed = 0, uniqueAvail = 0;
    fsMap.forEach(v => { uniqueTotal += v.total; uniqueUsed += v.used; uniqueAvail += v.avail; });
    const pct = uniqueTotal > 0 ? Math.min(100, (uniqueUsed / uniqueTotal) * 100) : 0;

    const kvmCnt = __cachedPools.filter(p => p.engine_scope === 'kvm' || p.engine_scope === 'both').length;
    const lxcCnt = __cachedPools.filter(p => p.engine_scope === 'lxc' || p.engine_scope === 'both').length;

    const setTxt = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
    setTxt('skPoolsVal', __cachedPools.length + (__cachedPools.length === 1 ? ' Pool' : ' Pools'));
    setTxt('skPoolsSub', kvmCnt + ' KVM-capable • ' + lxcCnt + ' LXC-capable');
    setTxt('skTotalVal', (uniqueTotal / 1073741824).toFixed(2) + ' GB');
    setTxt('skTotalSub', fsMap.size + ' backing filesystem' + (fsMap.size === 1 ? '' : 's'));
    setTxt('skUsedVal', (uniqueUsed / 1073741824).toFixed(2) + ' GB');
    setTxt('skUsedPctSub', pct.toFixed(1) + '% of raw capacity used');
    const bar = document.getElementById('skUsedBar');
    if (bar) {
      bar.style.width = pct.toFixed(1) + '%';
      bar.className = 'st-bar-fill ' + barToneClass(pct);
    }
    setTxt('skFreeVal', (uniqueAvail / 1073741824).toFixed(2) + ' GB');
    setTxt('skFreeSub', pct >= 85 ? 'High disk utilization — expand soon' : 'Healthy free capacity');

    renderStorageTable();
  } finally {
    if (btn) { btn.disabled = false; btn.textContent = 'Sync Real Disk Usage (statfs)'; }
  }
}

function renderStorageTable() {
  const tbody = document.getElementById('storageBody');
  if (!tbody) return;
  const list = __cachedPools.filter(p => {
    if (__storageScopeFilter === 'all') return true;
    return String(p.engine_scope || 'both') === __storageScopeFilter;
  });

  if (!list.length) {
    tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:var(--text-muted);padding:26px;">No storage pools match this filter.</td></tr>';
    return;
  }

  tbody.innerHTML = list.map(p => {
    const usedGb = Number(p.used_bytes || 0) / 1073741824;
    const totalGb = Number(p.total_bytes || 0) / 1073741824;
    const freeGb = Math.max(0, totalGb - usedGb);
    const pct = totalGb > 0 ? Math.min(100, (usedGb / totalGb) * 100) : 0;
    const tone = barToneClass(pct);

    const scopeVal = String(p.engine_scope || 'both');
    const scopeBadge = scopeVal === 'kvm'
      ? '<span class="st-tag indigo">KVM</span>'
      : (scopeVal === 'lxc' ? '<span class="st-tag cyan">LXC</span>' : '<span class="st-tag emerald">KVM + LXC</span>');

    const statusOnline = p.status === 'online' || totalGb > 0;
    const volCnt = Number(p.volume_count || 0);

    return `<tr>
      <td>
        <div style="display:flex;align-items:center;gap:9px;">
          <span class="st-dot ${statusOnline ? 'online' : 'warn'}"></span>
          <div>
            <strong style="font-size:13.5px;color:var(--text-primary);">${hkvmEsc(p.name)}</strong>
            <div style="font-size:11px;color:var(--text-muted);margin-top:2px;">
              ${volCnt} tracked volume${volCnt === 1 ? '' : 's'} &bull; ${hkvmEsc(p.status || 'online')}
            </div>
          </div>
        </div>
      </td>
      <td><span class="st-tag muted">${hkvmEsc(p.node_name || '#' + p.node_id)}</span></td>
      <td>
        <div style="display:flex;gap:5px;flex-wrap:wrap;align-items:center;">
          <span class="st-tag violet">${hkvmEsc(String(p.pool_type || 'dir').toUpperCase())}</span>
          ${scopeBadge}
        </div>
      </td>
      <td>
        <div style="display:inline-flex;align-items:center;gap:6px;flex-wrap:wrap;">
          <span class="st-mono-chip">${hkvmEsc(p.path)}</span>
          <button type="button" class="st-copy-mini" data-path="${hkvmEsc(p.path)}" onclick="copyTextWithToast(this.dataset.path, 'Mount path copied!')">Copy</button>
        </div>
      </td>
      <td>
        <div style="display:flex;justify-content:space-between;align-items:baseline;font-size:12.5px;">
          <span><strong>${usedGb.toFixed(2)}</strong> <span style="color:var(--text-muted);">/ ${totalGb.toFixed(2)} GB</span></span>
          <span style="font-size:11.5px;font-weight:700;color:${pct >= 85 ? '#f87171' : (pct >= 70 ? '#fbbf24' : '#38bdf8')};">${totalGb > 0 ? pct.toFixed(1) + '%' : 'Unprobed'}</span>
        </div>
        <div class="st-bar-track" style="margin-top:6px;"><div class="st-bar-fill ${tone}" style="width:${pct.toFixed(1)}%"></div></div>
