      </div>
      <% } %>

      <!-- SECTION: AUDIT LOGS -->
      <% if (section === 'audit-logs') { %>
      <div class="v3-toolbar"><h2 style="margin:0;color:var(--text-primary);">Security &amp; Activity Audit Trail</h2></div>
      <div class="v3-card v3-table-wrap">
        <table class="v3-table">
          <thead><tr><th>ID</th><th>Timestamp</th><th>Actor</th><th>Action</th><th>Resource</th><th>Details</th></tr></thead>
