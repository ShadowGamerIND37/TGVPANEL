          <tbody id="fwBody"></tbody>
        </table>
      </div>
      <% } %>

      <!-- SECTION: SNAPSHOTS -->
      <% if (section === 'snapshots') { %>
      <div class="v3-toolbar"><h2 style="margin:0;color:var(--text-primary);">Unified Instance Snapshots (QCOW2 &amp; LXC)</h2></div>
