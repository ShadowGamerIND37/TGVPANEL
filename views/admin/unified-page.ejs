        </div>
        ${liveCpu !== null ? `
          <div style="display:flex;align-items:center;gap:6px;margin-top:5px;">
            <span style="font-size:10.5px;color:var(--text-muted);width:54px;">CPU ${liveCpu.toFixed(0)}%</span>
            <div class="st-bar-track" style="margin:0;height:5px;flex:1;"><div class="st-bar-fill ${barToneClass(liveCpu)}" style="width:${Math.min(100, liveCpu).toFixed(1)}%"></div></div>
          </div>
        ` : ''}
      </td>
      <td>
        <div style="font-weight:700;font-size:12.5px;color:var(--text-primary);">
          ${Number(n.cpu_cores || 0)} vCPU &bull; ${fmtMbAsGb(n.ram_total_mb)} &bull; ${Number(n.disk_total_gb || 0).toFixed(1)} GB
        </div>
        <div style="font-size:11px;color:var(--text-muted);margin-top:2px;">
          Alloc: ${Number(n.allocated_vcpus || 0)}c / ${fmtMbAsGb(n.allocated_ram_mb)} / ${Number(n.allocated_disk_gb || 0).toFixed(0)}G
          ${liveRamPct !== null ? ` &bull; Host RAM ${liveRamPct.toFixed(0)}%` : ''}
        </div>
      </td>
      <td>
        <div style="display:flex;flex-direction:column;gap:4px;align-items:flex-start;">
          <span class="st-tag ${statusTag}"><span class="st-dot ${statusDot}" style="width:6px;height:6px;"></span> ${hkvmEsc(statusLabel)}</span>
          ${cTag}
          <span style="font-size:10.5px;color:var(--text-muted);">Seen: ${hkvmEsc(hbText)}</span>
          ${(!n.is_local && n.status !== 'online' && n.last_error) ? `
            <div style="font-size:10.5px;color:#f87171;max-width:210px;line-height:1.35;" title="${hkvmEsc(n.last_error)}">
              &#9888; ${hkvmEsc(String(n.last_error).slice(0, 72))}${String(n.last_error).length > 72 ? '…' : ''}
              ${/TLS|self-signed|certificate/i.test(String(n.last_error)) ? `<button type="button" class="st-copy-mini" style="margin-top:3px;padding:2px 6px;font-size:10px;" onclick="trustNodeTls(${n.id})">Trust TLS</button>` : ''}
            </div>
