<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'TGVPANEL Unified Admin' %></title>
  <link rel="icon" href="<%= siteLogo %>" type="image/png">
  <link rel="stylesheet" href="/css/admin.css">
  <% if (section === 'node-console') { %>
  <link rel="stylesheet" href="/vendor/xterm/xterm.css">
  <script src="/vendor/xterm/xterm.js"></script>
  <script src="/vendor/xterm/addon-fit.js"></script>
  <% } %>
  <style>
    .v3-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin-bottom: 20px; }
    .v3-card { background: var(--bg-card); border: 1px solid var(--border-card); border-radius: 12px; padding: 18px; margin-bottom: 18px; }
    .v3-card h3 { margin: 0 0 12px 0; font-size: 16px; font-weight: 700; color: var(--text-primary); }
    .v3-toolbar { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; justify-content: space-between; margin-bottom: 16px; }
    .v3-form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
    .v3-field label { display: block; font-size: 12px; color: var(--text-secondary); margin-bottom: 5px; font-weight: 600; }
    .v3-field input, .v3-field select, .v3-field textarea {
      width: 100%; padding: 9px 11px; border-radius: 8px; border: 1px solid var(--border-color);
      background: var(--bg-secondary, rgba(255,255,255,0.03)); color: var(--text-primary); font-size: 13px;
    }
    .v3-table-wrap { overflow-x: auto; }
    .v3-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .v3-table th, .v3-table td { padding: 10px 12px; text-align: left; border-bottom: 1px solid var(--border-subtle); color: var(--text-primary); }
    .v3-table th { font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted); }
    .v3-pill { display: inline-flex; align-items: center; padding: 2px 9px; border-radius: 999px; font-size: 11px; font-weight: 600; }
    .v3-pill.kvm { background: rgba(99,102,241,0.16); color: #818cf8; }
    .v3-pill.lxc { background: rgba(6,182,212,0.16); color: #22d3ee; }
    .v3-pill.running, .v3-pill.online, .v3-pill.completed { background: rgba(16,185,129,0.16); color: #10b981; }
    .v3-pill.stopped, .v3-pill.offline { background: rgba(107,114,128,0.2); color: #9ca3af; }
    .v3-pill.frozen, .v3-pill.suspended, .v3-pill.warning { background: rgba(245,158,11,0.18); color: #f59e0b; }
    .v3-btn-row { display: flex; gap: 6px; flex-wrap: wrap; }
    .v3-code { font-family: monospace; font-size: 12px; background: rgba(0,0,0,0.25); padding: 12px; border-radius: 8px; white-space: pre-wrap; max-height: 360px; overflow-y: auto; color: var(--text-primary); }

    /* --- LXC Provisioning Studio --- */
    .lxc-studio-header {
      display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap;
      margin-bottom: 22px; padding-bottom: 16px; border-bottom: 1px solid var(--border-subtle);
    }
    .lxc-engine-switch {
      display: inline-flex; padding: 4px; border-radius: 12px; background: var(--bg-card);
      border: 1px solid var(--border-card); gap: 4px; align-items: center;
    }
    .lxc-engine-tab {
      display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 9px;
      font-size: 12.5px; font-weight: 600; text-decoration: none; color: var(--text-secondary);
      transition: all 0.18s ease; border: 1px solid transparent; cursor: pointer;
    }
    .lxc-engine-tab:hover { color: var(--text-primary); background: rgba(255,255,255,0.04); }
    .lxc-engine-tab.active {
      background: rgba(6, 182, 212, 0.14); color: #22d3ee; border-color: rgba(6, 182, 212, 0.35);
      box-shadow: 0 2px 12px rgba(6, 182, 212, 0.12);
    }
    .lxc-studio-layout {
      display: grid; grid-template-columns: minmax(0, 1fr) 365px; gap: 20px; align-items: start;
    }
    @media (max-width: 1120px) {
      .lxc-studio-layout { grid-template-columns: 1fr; }
    }
    .lxc-step-card {
      background: var(--bg-card); border: 1px solid var(--border-card); border-radius: 14px;
      padding: 20px 22px; margin-bottom: 18px; transition: border-color 0.2s ease;
    }
    .lxc-step-card:hover { border-color: var(--border-color-hover, rgba(255,255,255,0.2)); }
    .lxc-step-head {
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--border-subtle);
      flex-wrap: wrap;
    }
    .lxc-step-title-wrap { display: flex; align-items: center; gap: 11px; }
    .lxc-step-badge {
      width: 28px; height: 28px; border-radius: 8px; display: inline-flex; align-items: center;
      justify-content: center; font-size: 12px; font-weight: 800;
      background: rgba(6, 182, 212, 0.15); color: #22d3ee; border: 1px solid rgba(6, 182, 212, 0.3);
      flex-shrink: 0;
    }
    .lxc-step-title { margin: 0; font-size: 15px; font-weight: 700; color: var(--text-primary); }
    .lxc-step-sub { margin: 2px 0 0; font-size: 12px; color: var(--text-muted); }

    .lxc-node-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 10px; margin-top: 6px;
    }
    .lxc-node-card {
      padding: 12px 14px; border-radius: 10px; border: 1px solid var(--border-color);
      background: var(--bg-secondary, rgba(255,255,255,0.02)); cursor: pointer;
      transition: all 0.16s ease; position: relative;
    }
    .lxc-node-card:hover { border-color: rgba(6,182,212,0.45); transform: translateY(-1px); }
    .lxc-node-card.selected {
      border-color: #06b6d4; background: rgba(6, 182, 212, 0.08);
      box-shadow: 0 0 0 1px rgba(6, 182, 212, 0.28);
    }

    .lxc-cat-bar {
      display: flex; gap: 6px; flex-wrap: wrap; align-items: center; margin-bottom: 12px;
    }
    .lxc-cat-pill {
      padding: 5px 11px; border-radius: 999px; font-size: 11.5px; font-weight: 600;
      border: 1px solid var(--border-color); background: transparent; color: var(--text-secondary);
      cursor: pointer; transition: all 0.15s ease;
    }
    .lxc-cat-pill:hover { color: var(--text-primary); border-color: rgba(6,182,212,0.4); }
    .lxc-cat-pill.active {
      background: rgba(6, 182, 212, 0.16); color: #22d3ee; border-color: rgba(6, 182, 212, 0.45);
    }
    .lxc-os-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(195px, 1fr)); gap: 10px;
      max-height: 330px; overflow-y: auto; padding-right: 4px;
    }
    .lxc-os-card {
      padding: 12px 13px; border-radius: 11px; border: 1px solid var(--border-color);
      background: var(--bg-secondary, rgba(255,255,255,0.02)); cursor: pointer;
      transition: all 0.16s ease; display: flex; flex-direction: column; gap: 8px; position: relative;
    }
    .lxc-os-card:hover { border-color: rgba(6, 182, 212, 0.45); transform: translateY(-1px); }
    .lxc-os-card.selected {
      border-color: #06b6d4; background: rgba(6, 182, 212, 0.09);
      box-shadow: 0 0 0 1px rgba(6, 182, 212, 0.3);
    }
    .lxc-os-top { display: flex; align-items: center; gap: 10px; }
    .lxc-os-icon {
      width: 34px; height: 34px; border-radius: 9px; display: inline-flex; align-items: center;
      justify-content: center; flex-shrink: 0; font-weight: 800; font-size: 13px;
    }
    .lxc-os-name { font-size: 13px; font-weight: 700; color: var(--text-primary); line-height: 1.25; }
    .lxc-os-meta { font-size: 11px; color: var(--text-muted); display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
    .lxc-os-check {
      position: absolute; top: 9px; right: 9px; width: 18px; height: 18px; border-radius: 50%;
      background: #06b6d4; color: #001018; display: none; align-items: center; justify-content: center;
      font-size: 11px; font-weight: 900;
    }
    .lxc-os-card.selected .lxc-os-check { display: inline-flex; }

    .lxc-preset-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 9px; margin-bottom: 18px;
    }
    .lxc-preset-card {
      padding: 11px 12px; border-radius: 10px; border: 1px solid var(--border-color);
      background: var(--bg-secondary, rgba(255,255,255,0.02)); cursor: pointer; text-align: left;
      transition: all 0.15s ease;
    }
    .lxc-preset-card:hover { border-color: rgba(99, 102, 241, 0.5); transform: translateY(-1px); }
    .lxc-preset-card.active {
      border-color: #6366f1; background: rgba(99, 102, 241, 0.11);
      box-shadow: 0 0 0 1px rgba(99, 102, 241, 0.3);
    }
    .lxc-preset-tier { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #818cf8; }
    .lxc-preset-main { font-size: 13.5px; font-weight: 700; color: var(--text-primary); margin-top: 3px; }
    .lxc-preset-sub { font-size: 11px; color: var(--text-muted); margin-top: 2px; }

    .lxc-chip-row { display: flex; gap: 5px; flex-wrap: wrap; margin-top: 6px; }
    .lxc-chip {
      padding: 3px 8px; border-radius: 6px; font-size: 11px; font-weight: 600;
      border: 1px solid var(--border-color); background: transparent; color: var(--text-secondary);
      cursor: pointer; transition: all 0.14s ease;
    }
    .lxc-chip:hover, .lxc-chip.active {
      border-color: #06b6d4; color: #22d3ee; background: rgba(6, 182, 212, 0.12);
    }

    .lxc-seg-group {
      display: inline-flex; padding: 3px; border-radius: 9px; border: 1px solid var(--border-color);
      background: var(--bg-secondary, rgba(255,255,255,0.02)); gap: 3px;
    }
    .lxc-seg-btn {
      padding: 6px 12px; border-radius: 7px; border: none; background: transparent;
      color: var(--text-secondary); font-size: 12px; font-weight: 600; cursor: pointer;
    }
    .lxc-seg-btn.active { background: rgba(6, 182, 212, 0.16); color: #22d3ee; }

    .lxc-toggle-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 10px; }
    .lxc-toggle-item {
      display: flex; align-items: flex-start; justify-content: space-between; gap: 12px;
      padding: 11px 13px; border-radius: 10px; border: 1px solid var(--border-subtle);
      background: var(--bg-secondary, rgba(255,255,255,0.02)); cursor: pointer;
    }
    .lxc-toggle-item:hover { border-color: var(--border-color); }
    .lxc-toggle-item input[type="checkbox"] {
      width: 18px; height: 18px; accent-color: #06b6d4; cursor: pointer; margin-top: 2px; flex-shrink: 0;
    }

    .lxc-summary-sticky { position: sticky; top: 82px; }
    .lxc-blueprint-card {
      background: var(--bg-card); border: 1px solid var(--border-card); border-radius: 14px;
      padding: 20px; box-shadow: var(--shadow-card);
    }
    .lxc-bp-row {
      display: flex; justify-content: space-between; align-items: center; gap: 10px;
      padding: 7px 0; border-bottom: 1px dashed var(--border-subtle); font-size: 12.5px;
    }
    .lxc-bp-row:last-child { border-bottom: none; }
    .lxc-bp-k { color: var(--text-muted); font-weight: 500; }
    .lxc-bp-v { color: var(--text-primary); font-weight: 600; text-align: right; word-break: break-all; }
    .lxc-deploy-btn {
      width: 100%; margin-top: 16px; padding: 12px 18px; border-radius: 10px; font-size: 14px;
      font-weight: 700; display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      cursor: pointer; border: 1px solid rgba(6, 182, 212, 0.45);
      background: linear-gradient(135deg, #0891b2 0%, #4f46e5 100%); color: #ffffff;
      box-shadow: 0 6px 20px rgba(6, 182, 212, 0.25); transition: all 0.18s ease;
    }
    .lxc-deploy-btn:hover:not(:disabled) { transform: translateY(-1px); filter: brightness(1.08); }
    .lxc-deploy-btn:disabled { opacity: 0.68; cursor: not-allowed; }
    @keyframes lxcIndeterminate {
      0% { transform: translateX(-100%); }
      100% { transform: translateX(250%); }
    }
    .lxc-prog-track {
      width: 100%; height: 6px; border-radius: 999px; background: rgba(255,255,255,0.08);
      overflow: hidden; margin: 10px 0;
    }
    .lxc-prog-bar {
      width: 42%; height: 100%; border-radius: 999px;
      background: linear-gradient(90deg, #06b6d4, #818cf8, #22d3ee);
      animation: lxcIndeterminate 1.4s infinite ease-in-out;
    }

    /* --- Node Diagnostic & Host Console Studio --- */
    .nc-wrap { max-width: 1440px; margin: 0 auto; }
    .nc-hero {
      background: linear-gradient(145deg, rgba(6, 182, 212, 0.08) 0%, rgba(99, 102, 241, 0.06) 50%, var(--bg-card) 100%);
      border: 1px solid var(--border-card);
      border-radius: 16px;
      padding: 20px 22px;
      margin-bottom: 18px;
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      flex-wrap: wrap;
    }
    .nc-hero::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 2px;
      background: linear-gradient(90deg, #06b6d4, #6366f1, #10b981);
    }
    .nc-hero-left { display: flex; align-items: center; gap: 15px; min-width: 0; }
    .nc-hero-icon {
      width: 48px; height: 48px; border-radius: 13px; flex-shrink: 0;
      background: linear-gradient(135deg, rgba(6, 182, 212, 0.2), rgba(99, 102, 241, 0.2));
      border: 1px solid rgba(6, 182, 212, 0.35);
      color: #22d3ee;
      display: inline-flex; align-items: center; justify-content: center;
      box-shadow: 0 6px 20px rgba(6, 182, 212, 0.14);
    }
    .nc-title-row { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; }
    .nc-title { margin: 0; font-size: 21px; font-weight: 800; color: var(--text-primary); letter-spacing: -0.3px; }
    .nc-sub { margin: 4px 0 0; font-size: 12.5px; color: var(--text-muted); display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .nc-hero-actions { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; }
    .nc-node-select-wrap {
      display: inline-flex; align-items: center; gap: 8px;
      background: rgba(10, 12, 18, 0.85); border: 1px solid var(--border-color);
      border-radius: 10px; padding: 4px 10px 4px 12px;
    }
    .nc-node-select-wrap label {
      font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;
      color: var(--text-muted); margin: 0; white-space: nowrap;
    }
    .nc-node-select {
      background: transparent; border: none; color: var(--text-primary);
      font-size: 13px; font-weight: 700; padding: 5px 4px; outline: none; cursor: pointer;
    }
    .nc-node-select option { background: #0f111a; color: #f3f4f6; }

    .nc-telemetry-grid {
      display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-bottom: 18px;
    }
    @media (max-width: 1180px) { .nc-telemetry-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 640px) { .nc-telemetry-grid { grid-template-columns: 1fr; } }
    .nc-stat-card {
      background: var(--bg-card); border: 1px solid var(--border-card); border-radius: 13px;
      padding: 15px 17px; display: flex; flex-direction: column; justify-content: space-between; gap: 10px;
      transition: border-color 0.18s ease;
    }
    .nc-stat-card:hover { border-color: rgba(255,255,255,0.2); }
    .nc-stat-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .nc-stat-label { font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted); }
    .nc-stat-val { font-size: 20px; font-weight: 800; color: var(--text-primary); letter-spacing: -0.3px; }
    .nc-bar-track { width: 100%; height: 6px; border-radius: 999px; background: rgba(255,255,255,0.08); overflow: hidden; }
    .nc-bar-fill { height: 100%; border-radius: 999px; transition: width 0.35s ease; }
    .nc-stat-foot { font-size: 11.5px; color: var(--text-secondary); display: flex; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
    .nc-cap-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
    .nc-cap-chip {
      display: inline-flex; align-items: center; justify-content: space-between; gap: 6px;
      padding: 5px 8px; border-radius: 7px; font-size: 11px; font-weight: 600;
      background: rgba(255,255,255,0.03); border: 1px solid var(--border-subtle); color: var(--text-secondary);
    }
    .nc-dot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; flex-shrink: 0; }
    .nc-dot.ok { background: #10b981; box-shadow: 0 0 8px rgba(16,185,129,0.6); }
    .nc-dot.warn { background: #f59e0b; box-shadow: 0 0 8px rgba(245,158,11,0.5); }
    .nc-dot.off { background: #6b7280; }

    .nc-workbench {
      display: grid; grid-template-columns: 320px minmax(0, 1fr); gap: 16px; margin-bottom: 18px; align-items: stretch;
    }
    @media (max-width: 1040px) { .nc-workbench { grid-template-columns: 1fr; } }

    .nc-preset-panel {
      background: var(--bg-card); border: 1px solid var(--border-card); border-radius: 14px;
      padding: 15px; display: flex; flex-direction: column; gap: 11px;
    }
    .nc-preset-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .nc-preset-head h3 { margin: 0; font-size: 14.5px; font-weight: 700; color: var(--text-primary); }
    .nc-search {
      width: 100%; padding: 8px 11px; border-radius: 9px; border: 1px solid var(--border-color);
      background: rgba(10, 12, 18, 0.75); color: var(--text-primary); font-size: 12.5px; outline: none;
    }
    .nc-search:focus { border-color: rgba(6, 182, 212, 0.5); }
    .nc-cat-tabs { display: flex; gap: 5px; flex-wrap: wrap; }
    .nc-cat-btn {
      padding: 4px 9px; border-radius: 999px; font-size: 11px; font-weight: 700;
      border: 1px solid var(--border-color); background: transparent; color: var(--text-muted);
      cursor: pointer; transition: all 0.15s ease;
    }
    .nc-cat-btn:hover { color: var(--text-primary); border-color: rgba(6,182,212,0.4); }
    .nc-cat-btn.active { background: rgba(6,182,212,0.16); color: #22d3ee; border-color: rgba(6,182,212,0.45); }

    .nc-preset-list {
      display: flex; flex-direction: column; gap: 6px; max-height: 430px; overflow-y: auto; padding-right: 3px;
    }
    .nc-preset-btn {
      width: 100%; text-align: left; padding: 9px 11px; border-radius: 10px;
      border: 1px solid var(--border-subtle); background: rgba(255,255,255,0.02);
      color: var(--text-primary); cursor: pointer; display: flex; align-items: center; gap: 10px;
      transition: all 0.15s ease;
    }
    .nc-preset-btn:hover {
      border-color: rgba(6, 182, 212, 0.4); background: rgba(6, 182, 212, 0.05); transform: translateX(2px);
    }
    .nc-preset-btn.active {
      border-color: #06b6d4; background: rgba(6, 182, 212, 0.11);
      box-shadow: 0 0 0 1px rgba(6, 182, 212, 0.25);
    }
    .nc-preset-ico {
      width: 30px; height: 30px; border-radius: 8px; flex-shrink: 0;
      display: inline-flex; align-items: center; justify-content: center; font-size: 13px;
    }
    .nc-preset-ico.sys { background: rgba(6,182,212,0.14); color: #22d3ee; }
    .nc-preset-ico.net { background: rgba(99,102,241,0.16); color: #818cf8; }
    .nc-preset-ico.virt { background: rgba(16,185,129,0.15); color: #34d399; }
    .nc-preset-meta { min-width: 0; flex: 1; }
    .nc-preset-name { font-size: 12.5px; font-weight: 700; color: var(--text-primary); line-height: 1.2; }
    .nc-preset-cmd {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 11px; color: var(--text-muted); margin-top: 2px;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }

    .nc-term-card {
      background: #07080d; border: 1px solid rgba(255,255,255,0.12); border-radius: 14px;
      display: flex; flex-direction: column; overflow: hidden;
      box-shadow: 0 10px 30px rgba(0,0,0,0.55);
    }
    .nc-term-bar {
      background: linear-gradient(180deg, #11131d 0%, #0b0d14 100%);
      border-bottom: 1px solid rgba(255,255,255,0.08);
      padding: 10px 14px; display: flex; align-items: center; justify-content: space-between;
      gap: 10px; flex-wrap: wrap;
    }
    .nc-term-left { display: flex; align-items: center; gap: 10px; min-width: 0; flex-wrap: wrap; }
    .nc-win-dots { display: inline-flex; gap: 6px; align-items: center; margin-right: 4px; }
    .nc-win-dots span { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
    .nc-cmd-badge {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 12px; color: #e2e8f0; background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.09); border-radius: 7px; padding: 3px 9px;
      max-width: 420px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .nc-cmd-badge .prompt { color: #22d3ee; font-weight: 700; margin-right: 5px; }
    .nc-term-tools { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .nc-tool-btn {
      padding: 5px 9px; border-radius: 7px; font-size: 11.5px; font-weight: 600;
      background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1);
      color: #cbd5e1; cursor: pointer; display: inline-flex; align-items: center; gap: 5px;
      transition: all 0.14s ease;
    }
    .nc-tool-btn:hover { background: rgba(255,255,255,0.1); color: #ffffff; border-color: rgba(255,255,255,0.22); }
    .nc-tool-btn.primary {
      background: rgba(6, 182, 212, 0.16); border-color: rgba(6, 182, 212, 0.4); color: #22d3ee;
    }
    .nc-tool-btn.primary:hover { background: rgba(6, 182, 212, 0.26); color: #67e8f9; }
    .nc-tool-btn.danger {
      background: rgba(239, 68, 68, 0.12); border-color: rgba(239, 68, 68, 0.32); color: #f87171;
    }
    .nc-tool-btn.danger:hover { background: rgba(239, 68, 68, 0.22); }

    .nc-term-body {
      flex: 1; min-height: 390px; max-height: 470px; overflow: auto;
      padding: 15px 18px; margin: 0;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, "Cascadia Mono", Consolas, monospace;
      font-size: 12.5px; line-height: 1.58; color: #e2e8f0; white-space: pre;
      background: radial-gradient(circle at top right, rgba(6,182,212,0.04), transparent 45%), #06070c;
    }
    .nc-term-body.wrap { white-space: pre-wrap; word-break: break-word; }

    .nc-term-foot {
      background: #0a0c13; border-top: 1px solid rgba(255,255,255,0.07);
      padding: 8px 14px; display: flex; align-items: center; justify-content: space-between;
      gap: 10px; flex-wrap: wrap; font-size: 11.5px; color: var(--text-muted);
    }
    .nc-history-row { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .nc-hist-chip {
      padding: 2px 8px; border-radius: 6px; font-family: monospace; font-size: 11px;
      background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.09);
      color: #94a3b8; cursor: pointer; transition: all 0.14s ease;
    }
    .nc-hist-chip:hover { color: #22d3ee; border-color: rgba(6,182,212,0.4); }

    .nc-pty-card {
      background: var(--bg-card); border: 1px solid var(--border-card); border-radius: 14px;
      overflow: hidden; margin-bottom: 18px;
    }
    .nc-pty-card.fullscreen {
      position: fixed; inset: 12px; z-index: 9999; margin: 0;
      display: flex; flex-direction: column; background: #06070c;
      box-shadow: 0 24px 80px rgba(0,0,0,0.92);
    }
    .nc-pty-card.fullscreen #nodeXtermBox { flex: 1; height: auto !important; }
    .nc-pty-locked {
      background: radial-gradient(ellipse at top, rgba(245, 158, 11, 0.06) 0%, transparent 60%), #07080d;
      padding: 26px 24px;
      display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(280px, 1fr); gap: 22px; align-items: center;
    }
    @media (max-width: 900px) { .nc-pty-locked { grid-template-columns: 1fr; } }
    .nc-env-snippet {
      background: #0c0e17; border: 1px solid rgba(255,255,255,0.1); border-radius: 11px;
      padding: 14px 15px; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12px;
    }
    .nc-ansi-green { color: #34d399; font-weight: 600; }
    .nc-ansi-yellow { color: #fbbf24; font-weight: 600; }
    .nc-ansi-red { color: #f87171; font-weight: 600; }
    .nc-ansi-cyan { color: #22d3ee; }
    .nc-ansi-bold { color: #f8fafc; font-weight: 700; }
  </style>
</head>
<body>
<div class="admin-wrapper">
  <%- include('../partials/admin/sidebar') %>
  <div class="admin-main">
    <%- include('../partials/admin/header') %>
    <div class="admin-content">

      <!-- SECTION: UNIFIED INSTANCES -->
      <% if (section === 'instances') { %>
      <div class="v3-toolbar">
        <div>
          <h2 style="margin:0;color:var(--text-primary);">Unified Compute Instances</h2>
          <p style="margin:4px 0 0;font-size:13px;color:var(--text-muted);">Manage QEMU/KVM Virtual Machines and Native LXC Containers across all nodes.</p>
        </div>
        <div class="v3-btn-row">
          <select id="instEngineFilter" onchange="loadUnifiedInstances()" style="padding:8px 12px;border-radius:8px;background:var(--bg-card);color:var(--text-primary);border:1px solid var(--border-card);">
            <option value="">All Engines (KVM + LXC)</option>
            <option value="kvm">KVM Virtual Machines</option>
            <option value="lxc">LXC Containers</option>
          </select>
          <input id="instSearch" oninput="loadUnifiedInstances()" placeholder="Filter name, IP, owner..." style="padding:8px 12px;border-radius:8px;background:var(--bg-card);color:var(--text-primary);border:1px solid var(--border-card);">
          <button class="btn btn-outline" onclick="bulkSelected('start')">Bulk Start</button>
          <button class="btn btn-outline" onclick="bulkSelected('stop')">Bulk Stop</button>
          <a href="/admin/instances/create" class="btn btn-primary">+ Create Instance</a>
        </div>
      </div>
      <div class="v3-card v3-table-wrap">
        <table class="v3-table">
          <thead>
            <tr>
              <th><input type="checkbox" id="chkAll" onclick="document.querySelectorAll('.inst-chk').forEach(c=>c.checked=this.checked)"></th>
              <th>Engine</th><th>Name</th><th>Owner</th><th>Node</th><th>Specs</th><th>IP</th><th>Status</th><th>Actions</th>
            </tr>
          </thead>
          <tbody id="instTableBody"><tr><td colspan="9">Loading instances...</td></tr></tbody>
        </table>
      </div>
      <% } %>

      <!-- SECTION: LXC CONTAINERS -->
      <% if (section === 'lxc') { %>
      <div class="v3-toolbar">
        <div>
          <h2 style="margin:0;color:var(--text-primary);">Native LXC Containers</h2>
          <p style="margin:4px 0 0;font-size:13px;color:var(--text-muted);">Create, resize, freeze, snapshot, and manage LXC VPS instances.</p>
        </div>
        <div class="v3-btn-row">
          <button type="button" class="btn btn-outline" id="syncHostLxcBtn" onclick="syncHostLxc()">Sync Host Containers</button>
          <a href="/admin/instances/create?engine=lxc" class="btn btn-primary">+ Provision LXC Container</a>
        </div>
      </div>
      <div class="v3-card v3-table-wrap">
        <table class="v3-table">
          <thead>
            <tr><th>ID</th><th>Container</th><th>Template</th><th>Owner</th><th>Node</th><th>CPU / RAM / Disk</th><th>IP</th><th>Status</th><th>Capabilities &amp; Actions</th></tr>
          </thead>
          <tbody id="lxcTableBody"><tr><td colspan="9">Loading LXC containers...</td></tr></tbody>
        </table>
      </div>
      <% } %>

      <!-- SECTION: CREATE UNIFIED INSTANCE -->
      <% if (section === 'instances-create') { %>
      <%
        const _tplList = Array.isArray(templates) ? templates : [];
        const _nodeList = Array.isArray(nodes) ? nodes : [];
        const _userList = Array.isArray(users) ? users : [];
        const _netPoolList = typeof networkPools !== 'undefined' && Array.isArray(networkPools) ? networkPools : [];
        const _defaultTpl = _tplList.find(t => t.slug === 'ubuntu-24.04') || _tplList[0] || { slug: 'ubuntu-24.04', name: 'Ubuntu 24.04 LTS' };
        const _lxcOk = !(capabilities && !capabilities.lxcAvailable);
      %>
      <script id="lxcCatalogJson" type="application/json"><%- JSON.stringify(_tplList).replace(/</g, '\\u003c') %></script>
      <script id="lxcNodesJson" type="application/json"><%- JSON.stringify(_nodeList).replace(/</g, '\\u003c') %></script>
      <script id="lxcNetPoolsJson" type="application/json"><%- JSON.stringify(_netPoolList).replace(/</g, '\\u003c') %></script>

      <div class="lxc-studio-header">
        <div>
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px;flex-wrap:wrap;">
            <a href="/admin/lxc" style="color:var(--text-muted);text-decoration:none;font-size:12.5px;display:inline-flex;align-items:center;gap:5px;">
              &larr; Back to LXC Containers
            </a>
            <% if (_lxcOk) { %>
              <span class="v3-pill running" style="font-size:11px;">LXC Host Runtime Ready<% if (capabilities && capabilities.cgroupVersion) { %> &bull; cgroup v<%= capabilities.cgroupVersion %><% } %></span>
            <% } else { %>
              <span class="v3-pill warning" style="font-size:11px;">Controller Mode (No Local LXC Binary)</span>
            <% } %>
          </div>
          <h2 style="margin:0;font-size:22px;font-weight:800;color:var(--text-primary);letter-spacing:-0.3px;">Deploy Native LXC Container</h2>
          <p style="margin:4px 0 0;font-size:13px;color:var(--text-muted);">Lightweight OS-level Linux virtual server with instant boot, cgroup resource isolation, and WebSocket PTY console.</p>
        </div>

        <div class="lxc-engine-switch" role="tablist" aria-label="Virtualization engine selector">
          <span class="lxc-engine-tab active">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
            Native LXC Container
          </span>
          <a href="/admin/vm-create" class="lxc-engine-tab">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="7" rx="2"/><rect x="2" y="14" width="20" height="7" rx="2"/><line x1="6" y1="6.5" x2="6.01" y2="6.5"/><line x1="6" y1="17.5" x2="6.01" y2="17.5"/></svg>
            QEMU/KVM Virtual Machine &rarr;
          </a>
        </div>
      </div>

      <% if (!_lxcOk) { %>
      <div class="v3-card" style="border-color:rgba(245,158,11,0.45);background:rgba(245,158,11,0.06);margin-bottom:18px;">
        <div style="display:flex;align-items:flex-start;gap:10px;">
          <span style="color:#f59e0b;font-size:16px;line-height:1;">&#9888;</span>
          <div>
            <strong style="color:#f59e0b;font-size:13px;">Local LXC Utilities Not Detected</strong>
            <div style="font-size:12.5px;color:var(--text-secondary);margin-top:3px;">
              Install <code>sudo apt install -y lxc lxc-templates uidmap bridge-utils</code> on this Linux host, select a remote LXC-capable Node Agent below, or uncheck <em>Provision immediately on host</em> to pre-register container metadata.
            </div>
          </div>
        </div>
      </div>
      <% } %>

      <form id="lxcCreateStudioForm" onsubmit="submitCreateLxc(event)">
        <div class="lxc-studio-layout">
          <!-- LEFT COLUMN: CONFIGURATION STEPS -->
          <div>

            <!-- STEP 1: IDENTITY, OWNER & NODE -->
            <div class="lxc-step-card">
              <div class="lxc-step-head">
                <div class="lxc-step-title-wrap">
                  <span class="lxc-step-badge">1</span>
                  <div>
                    <h3 class="lxc-step-title">Identity, Placement &amp; Ownership</h3>
                    <p class="lxc-step-sub">Choose a unique container name, guest hostname, owner account, and target compute node.</p>
                  </div>
                </div>
                <button type="button" class="btn btn-outline" style="padding:5px 11px;font-size:11.5px;" onclick="genRandomLxcName()">
                  &#8635; Randomize Name
                </button>
              </div>

              <div class="v3-form-grid" style="grid-template-columns:repeat(auto-fit,minmax(210px,1fr));">
                <div class="v3-field">
                  <label>Container Name <span style="color:#ef4444;">*</span></label>
                  <input id="cName" required maxlength="63" placeholder="vps-prod-01" autocomplete="off" oninput="onLxcNameInput()">
                  <div id="cNameHint" style="font-size:11px;color:var(--text-muted);margin-top:4px;">Letters, digits, hyphens, underscores (e.g. <code>web-node-01</code>).</div>
                </div>
                <div class="v3-field">
                  <label>Guest Hostname</label>
                  <input id="cHost" maxlength="63" placeholder="vps-prod-01.local" oninput="onLxcHostInput()">
                  <div style="font-size:11px;color:var(--text-muted);margin-top:4px;">Defaults to container name if left blank.</div>
                </div>
                <div class="v3-field">
                  <label>Owner Account</label>
                  <select id="cUser" onchange="updateLxcBlueprint()">
                    <% _userList.forEach(u => { %>
                      <option value="<%= u.id %>"><%= u.username %> (#<%= u.id %>)</option>
                    <% }) %>
                  </select>
                  <div style="font-size:11px;color:var(--text-muted);margin-top:4px;">User receives full dashboard &amp; console access.</div>
                </div>
              </div>

              <div style="margin-top:16px;">
                <label style="display:block;font-size:12px;color:var(--text-secondary);margin-bottom:6px;font-weight:600;">Target Compute Node</label>
                <select id="cNode" style="display:none;" onchange="updateLxcBlueprint()">
                  <% _nodeList.forEach(n => { %>
                    <option value="<%= n.id %>"><%= n.name %> (<%= n.ip_address %>)</option>
                  <% }) %>
                </select>
                <div class="lxc-node-grid" id="lxcNodeCards">
                  <% _nodeList.forEach((n, idx) => { %>
                    <div class="lxc-node-card <%= idx === 0 ? 'selected' : '' %>" data-node-id="<%= n.id %>" onclick="selectLxcNode(<%= n.id %>)">
                      <div style="display:flex;align-items:center;justify-content:space-between;gap:6px;">
                        <strong style="font-size:13px;color:var(--text-primary);"><%= n.name %></strong>
                        <% if (n.is_local) { %>
                          <span class="v3-pill lxc" style="font-size:10px;padding:1px 7px;">LOCAL</span>
                        <% } else { %>
                          <span class="v3-pill kvm" style="font-size:10px;padding:1px 7px;">REMOTE</span>
                        <% } %>
                      </div>
                      <div style="font-size:11.5px;color:var(--text-muted);margin-top:4px;">
                        <code><%= n.ip_address %></code> &bull; <%= n.location || 'Datacenter' %>
                      </div>
                      <div style="font-size:11px;color:var(--text-secondary);margin-top:6px;display:flex;gap:8px;flex-wrap:wrap;">
                        <span><%= n.cpu_cores || '—' %> Cores</span>
                        <span>&bull;</span>
                        <span><%= n.ram_total_mb ? Math.round(n.ram_total_mb / 1024 * 10) / 10 + ' GB RAM' : 'RAM Auto' %></span>
                      </div>
                    </div>
                  <% }) %>
                </div>
              </div>
            </div>

            <!-- STEP 2: OS DISTRIBUTION IMAGE -->
            <div class="lxc-step-card">
              <div class="lxc-step-head">
                <div class="lxc-step-title-wrap">
                  <span class="lxc-step-badge">2</span>
                  <div>
                    <h3 class="lxc-step-title">Operating System Template</h3>
                    <p class="lxc-step-sub">Official LinuxContainers rootfs images &amp; custom uploaded templates.</p>
                  </div>
                </div>
                <input id="lxcTplSearch" type="search" placeholder="Search distro or release..." oninput="renderLxcOsGrid()"
                  style="width:210px;padding:6px 11px;border-radius:8px;border:1px solid var(--border-color);background:var(--bg-secondary,rgba(255,255,255,0.03));color:var(--text-primary);font-size:12px;">
              </div>

              <select id="cTpl" style="display:none;" onchange="updateLxcBlueprint()">
                <% _tplList.forEach(t => { %>
                  <option value="<%= t.slug %>" <%= t.slug === _defaultTpl.slug ? 'selected' : '' %>><%= t.name %> (<%= t.slug %>)</option>
                <% }) %>
              </select>

              <div class="lxc-cat-bar" id="lxcCatBar">
                <button type="button" class="lxc-cat-pill active" data-cat="all" onclick="setLxcCat('all', this)">All Images (<%= _tplList.length %>)</button>
                <button type="button" class="lxc-cat-pill" data-cat="ubuntu" onclick="setLxcCat('ubuntu', this)">Ubuntu</button>
                <button type="button" class="lxc-cat-pill" data-cat="debian" onclick="setLxcCat('debian', this)">Debian</button>
                <button type="button" class="lxc-cat-pill" data-cat="rhel" onclick="setLxcCat('rhel', this)">Alma / Rocky / CentOS</button>
                <button type="button" class="lxc-cat-pill" data-cat="fedora" onclick="setLxcCat('fedora', this)">Fedora</button>
                <button type="button" class="lxc-cat-pill" data-cat="security" onclick="setLxcCat('security', this)">Kali &amp; Other</button>
                <button type="button" class="lxc-cat-pill" data-cat="custom" onclick="setLxcCat('custom', this)">Custom</button>
              </div>

              <div class="lxc-os-grid" id="lxcOsGrid"></div>

              <div id="lxcSelectedOsBanner" style="margin-top:12px;padding:10px 13px;border-radius:9px;background:rgba(6,182,212,0.06);border:1px solid rgba(6,182,212,0.2);font-size:12px;color:var(--text-secondary);display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;"></div>
            </div>

            <!-- STEP 3: COMPUTE, MEMORY & STORAGE -->
            <div class="lxc-step-card">
              <div class="lxc-step-head">
                <div class="lxc-step-title-wrap">
                  <span class="lxc-step-badge">3</span>
                  <div>
                    <h3 class="lxc-step-title">Compute, Memory &amp; Root Storage</h3>
                    <p class="lxc-step-sub">Pick a quick cloud sizing profile or customize exact cgroup limits.</p>
                  </div>
                </div>
                <span style="font-size:11.5px;color:var(--text-muted);">Live resizable anytime</span>
              </div>

              <div class="lxc-preset-grid" id="lxcPresetGrid">
                <button type="button" class="lxc-preset-card" data-preset="nano" onclick="applyLxcPreset('nano', 1, 512, 256, 10, this)">
                  <div class="lxc-preset-tier">Nano</div>
                  <div class="lxc-preset-main">1 vCPU &bull; 512 MB</div>
                  <div class="lxc-preset-sub">10 GB SSD &bull; 256 MB Swap</div>
                </button>
                <button type="button" class="lxc-preset-card" data-preset="starter" onclick="applyLxcPreset('starter', 1, 1024, 512, 20, this)">
                  <div class="lxc-preset-tier">Starter</div>
                  <div class="lxc-preset-main">1 vCPU &bull; 1 GB</div>
                  <div class="lxc-preset-sub">20 GB SSD &bull; 512 MB Swap</div>
                </button>
                <button type="button" class="lxc-preset-card active" data-preset="standard" onclick="applyLxcPreset('standard', 2, 2048, 512, 20, this)">
                  <div class="lxc-preset-tier">Standard</div>
                  <div class="lxc-preset-main">2 vCPU &bull; 2 GB</div>
                  <div class="lxc-preset-sub">20 GB SSD &bull; 512 MB Swap</div>
                </button>
                <button type="button" class="lxc-preset-card" data-preset="performance" onclick="applyLxcPreset('performance', 4, 4096, 1024, 60, this)">
                  <div class="lxc-preset-tier">Performance</div>
                  <div class="lxc-preset-main">4 vCPU &bull; 4 GB</div>
                  <div class="lxc-preset-sub">60 GB SSD &bull; 1 GB Swap</div>
                </button>
                <button type="button" class="lxc-preset-card" data-preset="pro" onclick="applyLxcPreset('pro', 8, 8192, 2048, 120, this)">
                  <div class="lxc-preset-tier">Pro</div>
                  <div class="lxc-preset-main">8 vCPU &bull; 8 GB</div>
                  <div class="lxc-preset-sub">120 GB SSD &bull; 2 GB Swap</div>
                </button>
                <button type="button" class="lxc-preset-card" data-preset="heavy" onclick="applyLxcPreset('heavy', 16, 16384, 4096, 240, this)">
                  <div class="lxc-preset-tier">Dedicated</div>
                  <div class="lxc-preset-main">16 vCPU &bull; 16 GB</div>
                  <div class="lxc-preset-sub">240 GB SSD &bull; 4 GB Swap</div>
                </button>
              </div>

              <div class="v3-form-grid" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;">
                <div class="v3-field">
                  <div style="display:flex;justify-content:space-between;align-items:center;">
                    <label style="margin-bottom:0;">vCPU Cores</label>
                    <span id="cCpuBadge" style="font-size:12px;font-weight:700;color:#22d3ee;">2 Cores</span>
                  </div>
                  <div style="display:flex;gap:10px;align-items:center;margin-top:6px;">
                    <input type="range" id="cCpuRange" min="1" max="32" value="2" oninput="syncLxcCpu(this.value, 'range')" style="flex:1;accent-color:#06b6d4;padding:0;border:none;">
                    <input id="cCpu" type="number" min="1" max="128" value="2" oninput="syncLxcCpu(this.value, 'num')" style="width:78px;text-align:center;">
                  </div>
                  <div class="lxc-chip-row">
                    <button type="button" class="lxc-chip" onclick="syncLxcCpu(1,'chip')">1c</button>
                    <button type="button" class="lxc-chip active" onclick="syncLxcCpu(2,'chip')">2c</button>
                    <button type="button" class="lxc-chip" onclick="syncLxcCpu(4,'chip')">4c</button>
                    <button type="button" class="lxc-chip" onclick="syncLxcCpu(8,'chip')">8c</button>
                    <button type="button" class="lxc-chip" onclick="syncLxcCpu(16,'chip')">16c</button>
                  </div>
                </div>

                <div class="v3-field">
                  <div style="display:flex;justify-content:space-between;align-items:center;">
                    <label style="margin-bottom:0;">Memory (MB)</label>
                    <span id="cRamBadge" style="font-size:12px;font-weight:700;color:#22d3ee;">2.0 GB</span>
                  </div>
                  <input id="cRam" type="number" min="128" step="128" value="2048" style="margin-top:6px;" oninput="clearActivePreset();updateLxcBlueprint()">
                  <div class="lxc-chip-row">
                    <button type="button" class="lxc-chip" onclick="setNumericField('cRam',512)">512M</button>
                    <button type="button" class="lxc-chip" onclick="setNumericField('cRam',1024)">1G</button>
                    <button type="button" class="lxc-chip active" onclick="setNumericField('cRam',2048)">2G</button>
                    <button type="button" class="lxc-chip" onclick="setNumericField('cRam',4096)">4G</button>
                    <button type="button" class="lxc-chip" onclick="setNumericField('cRam',8192)">8G</button>
                    <button type="button" class="lxc-chip" onclick="setNumericField('cRam',16384)">16G</button>
                  </div>
                </div>

                <div class="v3-field">
                  <div style="display:flex;justify-content:space-between;align-items:center;">
                    <label style="margin-bottom:0;">Swap Memory (MB)</label>
                    <span id="cSwapBadge" style="font-size:12px;font-weight:700;color:var(--text-secondary);">512 MB</span>
                  </div>
                  <input id="cSwap" type="number" min="0" step="128" value="512" style="margin-top:6px;" oninput="clearActivePreset();updateLxcBlueprint()">
                  <div class="lxc-chip-row">
                    <button type="button" class="lxc-chip" onclick="setNumericField('cSwap',0)">Off (0)</button>
                    <button type="button" class="lxc-chip active" onclick="setNumericField('cSwap',512)">512M</button>
                    <button type="button" class="lxc-chip" onclick="setNumericField('cSwap',1024)">1G</button>
                    <button type="button" class="lxc-chip" onclick="setNumericField('cSwap',2048)">2G</button>
                  </div>
                </div>

                <div class="v3-field">
                  <div style="display:flex;justify-content:space-between;align-items:center;">
                    <label style="margin-bottom:0;">Root Disk (GB)</label>
                    <span id="cDiskBadge" style="font-size:12px;font-weight:700;color:#22d3ee;">20 GB</span>
                  </div>
                  <input id="cDisk" type="number" min="2" max="4096" value="20" style="margin-top:6px;" oninput="clearActivePreset();updateLxcBlueprint()">
                  <div class="lxc-chip-row">
                    <button type="button" class="lxc-chip" onclick="setNumericField('cDisk',10)">10G</button>
                    <button type="button" class="lxc-chip active" onclick="setNumericField('cDisk',20)">20G</button>
                    <button type="button" class="lxc-chip" onclick="setNumericField('cDisk',40)">40G</button>
                    <button type="button" class="lxc-chip" onclick="setNumericField('cDisk',80)">80G</button>
                    <button type="button" class="lxc-chip" onclick="setNumericField('cDisk',160)">160G</button>
                  </div>
                </div>
              </div>

              <details style="margin-top:16px;padding-top:12px;border-top:1px solid var(--border-subtle);">
                <summary style="cursor:pointer;font-size:12.5px;font-weight:600;color:var(--text-secondary);user-select:none;">
                  Advanced CPU Scheduler, Storage Backend &amp; Traffic Limits
                </summary>
                <div class="v3-form-grid" style="margin-top:12px;">
                  <div class="v3-field">
                    <label>Rootfs Backing Store</label>
                    <select id="cBacking" onchange="updateLxcBlueprint()">
                      <option value="dir">Directory Rootfs (dir &mdash; Default)</option>
                      <option value="btrfs">Btrfs Subvolume (btrfs)</option>
                      <option value="zfs">ZFS Dataset (zfs)</option>
                      <option value="lvm">LVM Logical Volume (lvm)</option>
                    </select>
                  </div>
                  <div class="v3-field">
                    <label>CPU Throttle Cap (%)</label>
                    <input id="cCpuLimit" type="number" min="5" max="100" value="100" oninput="updateLxcBlueprint()">
                  </div>
                  <div class="v3-field">
                    <label>CPU Scheduler Weight (Shares)</label>
                    <input id="cCpuShares" type="number" min="64" max="10240" value="1024">
                  </div>
                  <div class="v3-field">
                    <label>CPU Core Pinning (Optional)</label>
                    <input id="cCpuPin" placeholder="e.g. 0-1 or 0,2">
                  </div>
                  <div class="v3-field">
                    <label>Bandwidth Quota (GB, 0 = Unlimited)</label>
                    <input id="cBwQuota" type="number" min="0" value="0" oninput="updateLxcBlueprint()">
                  </div>
                </div>
              </details>
            </div>

            <!-- STEP 4: NETWORKING -->
            <div class="lxc-step-card">
              <div class="lxc-step-head">
                <div class="lxc-step-title-wrap">
                  <span class="lxc-step-badge">4</span>
                  <div>
                    <h3 class="lxc-step-title">Networking &amp; IP Allocation</h3>
                    <p class="lxc-step-sub">Attach to a host Linux bridge via automatic DHCP or static IPv4/IPv6 addressing.</p>
                  </div>
                </div>
                <div class="lxc-seg-group">
                  <button type="button" class="lxc-seg-btn active" id="ipModeDhcpBtn" onclick="setLxcIpMode('dhcp')">DHCP / Auto</button>
                  <button type="button" class="lxc-seg-btn" id="ipModeStaticBtn" onclick="setLxcIpMode('static')">Static IP</button>
                </div>
              </div>

              <div class="v3-form-grid" style="grid-template-columns:repeat(auto-fit,minmax(210px,1fr));">
                <div class="v3-field">
                  <label>Linux Bridge Interface</label>
                  <input id="cBridge" value="lxcbr0" oninput="updateLxcBlueprint()">
                  <div class="lxc-chip-row">
                    <button type="button" class="lxc-chip active" onclick="document.getElementById('cBridge').value='lxcbr0';updateLxcBlueprint()">lxcbr0</button>
                    <button type="button" class="lxc-chip" onclick="document.getElementById('cBridge').value='br0';updateLxcBlueprint()">br0</button>
                    <button type="button" class="lxc-chip" onclick="document.getElementById('cBridge').value='vmbr0';updateLxcBlueprint()">vmbr0</button>
                  </div>
                </div>

                <% if (_netPoolList.length > 0) { %>
                <div class="v3-field">
                  <label>Quick-Fill from Network Pool</label>
                  <select id="cNetPoolSelect" onchange="applyLxcNetworkPool(this.value)">
                    <option value="">&mdash; Custom Bridge Settings &mdash;</option>
                    <% _netPoolList.forEach(p => { %>
                      <option value="<%= p.id %>"><%= p.name %> (<%= p.bridge_name %><%= p.cidr ? ' • ' + p.cidr : '' %>)</option>
                    <% }) %>
                  </select>
                  <div style="font-size:11px;color:var(--text-muted);margin-top:4px;">Populates bridge, gateway &amp; VLAN automatically.</div>
                </div>
                <% } %>
              </div>

              <div id="lxcStaticIpFields" style="display:none;margin-top:14px;padding-top:14px;border-top:1px dashed var(--border-subtle);">
                <div class="v3-form-grid">
                  <div class="v3-field">
                    <label>Static IPv4 Address / CIDR</label>
                    <input id="cIp" placeholder="10.0.3.50 or 10.0.3.50/24" oninput="updateLxcBlueprint()">
                  </div>
                  <div class="v3-field">
                    <label>IPv4 Gateway</label>
                    <input id="cGateway" placeholder="10.0.3.1 or auto" oninput="updateLxcBlueprint()">
                  </div>
                  <div class="v3-field">
                    <label>Static IPv6 / CIDR (Optional)</label>
                    <input id="cIpv6" placeholder="fd00::50/64">
                  </div>
                  <div class="v3-field">
                    <label>802.1Q VLAN Tag (Optional)</label>
                    <input id="cVlan" type="number" min="1" max="4094" placeholder="e.g. 100">
                  </div>
                </div>
              </div>
            </div>

            <!-- STEP 5: ACCESS, SECURITY & LIFECYCLE -->
            <div class="lxc-step-card" style="margin-bottom:0;">
              <div class="lxc-step-head">
                <div class="lxc-step-title-wrap">
                  <span class="lxc-step-badge">5</span>
                  <div>
                    <h3 class="lxc-step-title">Access Credentials, Security &amp; Lifecycle</h3>
                    <p class="lxc-step-sub">Encrypted root credentials, OpenSSH public keys, Docker nesting, and expiry policies.</p>
                  </div>
                </div>
              </div>

              <div class="v3-form-grid" style="grid-template-columns:repeat(auto-fit,minmax(240px,1fr));margin-bottom:14px;">
                <div class="v3-field">
                  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:5px;">
                    <label style="margin:0;">Root Password</label>
                    <button type="button" class="lxc-chip" onclick="genCustomLxcPassword()">Generate Strong</button>
                  </div>
                  <div style="position:relative;">
                    <input id="cRootPw" type="password" placeholder="Leave blank to auto-generate 18-char password" autocomplete="new-password" style="padding-right:58px;" oninput="updateLxcBlueprint()">
                    <button type="button" onclick="toggleLxcPwVis()" id="cRootPwToggle"
                      style="position:absolute;right:8px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--text-muted);font-size:11px;font-weight:600;cursor:pointer;">
                      Show
                    </button>
                  </div>
                  <div style="font-size:11px;color:var(--text-muted);margin-top:4px;">Encrypted with AES-256-GCM at rest; never stored in plaintext.</div>
                </div>

                <div class="v3-field">
                  <label>Expiration Policy (Days, 0 = Never)</label>
                  <input id="cExp" type="number" min="0" value="0" oninput="updateLxcBlueprint()">
                  <div class="lxc-chip-row">
                    <button type="button" class="lxc-chip active" onclick="setNumericField('cExp',0)">Never (0)</button>
                    <button type="button" class="lxc-chip" onclick="setNumericField('cExp',7)">7 Days</button>
                    <button type="button" class="lxc-chip" onclick="setNumericField('cExp',30)">30 Days</button>
                    <button type="button" class="lxc-chip" onclick="setNumericField('cExp',90)">90 Days</button>
                    <button type="button" class="lxc-chip" onclick="setNumericField('cExp',365)">1 Year</button>
                  </div>
                </div>
              </div>

              <div class="v3-field" style="margin-bottom:14px;">
                <label>Authorized SSH Public Keys (Optional, one per line)</label>
                <textarea id="cSshKeys" rows="2" placeholder="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... admin@workstation" style="font-family:monospace;font-size:12px;" oninput="updateLxcBlueprint()"></textarea>
              </div>

              <div class="lxc-toggle-list">
                <label class="lxc-toggle-item">
                  <div>
                    <div style="font-size:13px;font-weight:600;color:var(--text-primary);">Container Nesting (Docker-Ready)</div>
                    <div style="font-size:11.5px;color:var(--text-muted);margin-top:2px;">Allows running Docker, Podman &amp; nested cgroups inside the VPS.</div>
                  </div>
                  <input type="checkbox" id="cNest" checked onchange="updateLxcBlueprint()">
                </label>

                <label class="lxc-toggle-item">
                  <div>
                    <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
                      <span style="font-size:13px;font-weight:600;color:var(--text-primary);">KVM Nesting (<code>/dev/kvm</code> Passthrough)</span>
                      <% if (capabilities && capabilities.kvmDevicePresent) { %>
                        <span class="v3-pill running" style="font-size:10px;padding:1px 6px;">Host /dev/kvm Ready</span>
                      <% } else { %>
                        <span class="v3-pill warning" style="font-size:10px;padding:1px 6px;">No Host /dev/kvm</span>
                      <% } %>
                    </div>
                    <div style="font-size:11.5px;color:var(--text-muted);margin-top:2px;">Passes <code>/dev/kvm</code> &amp; <code>/dev/net/tun</code> into LXC for hardware-accelerated QEMU/KVM VMs.</div>
                  </div>
                  <input type="checkbox" id="cKvmNest" onchange="updateLxcBlueprint()">
                </label>

                <label class="lxc-toggle-item">
                  <div>
                    <div style="font-size:13px;font-weight:600;color:var(--text-primary);">Boot Automatically with Host</div>
                    <div style="font-size:11.5px;color:var(--text-muted);margin-top:2px;">Sets <code>lxc.start.auto = 1</code> so container starts after node reboot.</div>
                  </div>
                  <input type="checkbox" id="cAutostart" checked onchange="updateLxcBlueprint()">
                </label>

                <label class="lxc-toggle-item">
                  <div>
                    <div style="font-size:13px;font-weight:600;color:var(--text-primary);">Privileged Container Mapping</div>
                    <div style="font-size:11.5px;color:var(--text-muted);margin-top:2px;">Recommended for systemd distros (AlmaLinux, Ubuntu, Debian) &amp; nested workloads.</div>
                  </div>
                  <input type="checkbox" id="cPriv" checked onchange="updateLxcBlueprint()">
                </label>

                <label class="lxc-toggle-item">
                  <div>
                    <div style="font-size:13px;font-weight:600;color:var(--text-primary);">Provision Immediately on Host</div>
                    <div style="font-size:11.5px;color:var(--text-muted);margin-top:2px;">Downloads OS rootfs, applies config &amp; boots container now.</div>
                  </div>
                  <input type="checkbox" id="cProv" <%= _lxcOk ? 'checked' : '' %> onchange="updateLxcBlueprint()">
                </label>
              </div>

              <div class="v3-field" style="margin-top:14px;">
                <label>Internal Admin Notes (Optional)</label>
                <input id="cNotes" placeholder="Customer order #1042, production workload, etc.">
              </div>
            </div>

          </div>

          <!-- RIGHT COLUMN: STICKY DEPLOYMENT BLUEPRINT -->
          <div class="lxc-summary-sticky">
            <div class="lxc-blueprint-card">
              <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px;padding-bottom:12px;border-bottom:1px solid var(--border-subtle);">
                <div>
                  <div style="font-size:11px;text-transform:uppercase;letter-spacing:0.7px;color:#22d3ee;font-weight:700;">Deployment Blueprint</div>
                  <h3 style="margin:3px 0 0;font-size:16px;font-weight:800;color:var(--text-primary);" id="bpTitle">vps-prod-01</h3>
                </div>
                <span class="v3-pill lxc">LXC NATIVE</span>
              </div>

              <div>
                <div class="lxc-bp-row"><span class="lxc-bp-k">Hostname</span><span class="lxc-bp-v" id="bpHost">vps-prod-01</span></div>
                <div class="lxc-bp-row"><span class="lxc-bp-k">Owner</span><span class="lxc-bp-v" id="bpOwner">—</span></div>
                <div class="lxc-bp-row"><span class="lxc-bp-k">Target Node</span><span class="lxc-bp-v" id="bpNode">—</span></div>
                <div class="lxc-bp-row"><span class="lxc-bp-k">OS Image</span><span class="lxc-bp-v" id="bpOs" style="color:#22d3ee;">—</span></div>
                <div class="lxc-bp-row"><span class="lxc-bp-k">Compute</span><span class="lxc-bp-v" id="bpCpu">2 vCPU (100%)</span></div>
                <div class="lxc-bp-row"><span class="lxc-bp-k">Memory / Swap</span><span class="lxc-bp-v" id="bpRam">2048 MB / 512 MB</span></div>
                <div class="lxc-bp-row"><span class="lxc-bp-k">Root Storage</span><span class="lxc-bp-v" id="bpDisk">20 GB (dir)</span></div>
                <div class="lxc-bp-row"><span class="lxc-bp-k">Networking</span><span class="lxc-bp-v" id="bpNet">lxcbr0 &bull; DHCP</span></div>
                <div class="lxc-bp-row"><span class="lxc-bp-k">Credentials</span><span class="lxc-bp-v" id="bpAuth">Auto 18-char Pw</span></div>
                <div class="lxc-bp-row"><span class="lxc-bp-k">Capabilities</span><span class="lxc-bp-v" id="bpFlags">Nesting, Autostart</span></div>
                <div class="lxc-bp-row"><span class="lxc-bp-k">Expiration</span><span class="lxc-bp-v" id="bpExp">Never expires</span></div>
              </div>

              <button type="submit" id="cSubmitBtn" class="lxc-deploy-btn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                <span>Deploy LXC Container</span>
              </button>

              <div id="createResultBox" style="display:none;margin-top:14px;" class="v3-code"></div>
            </div>
          </div>
        </div>
      </form>
      <% } %>

      <!-- SECTION: NODES -->
      <% if (section === 'nodes') { %>
      <div class="v3-toolbar">
        <div>
          <h2 style="margin:0;color:var(--text-primary);">Hypervisor &amp; Container Nodes</h2>
          <p style="margin:4px 0 0;font-size:13px;color:var(--text-muted);">Centralized health checks, circuit breakers, capability detection, and HMAC credential rotation.</p>
        </div>
      </div>
      <div class="v3-card">
        <h3>Register Remote Node Agent</h3>
        <form onsubmit="submitAddNode(event)" class="v3-form-grid">
          <div class="v3-field"><label>Node Name</label><input id="nName" required placeholder="eu-fra-node-02"></div>
          <div class="v3-field"><label>Hostname</label><input id="nHost" required placeholder="fra02.example.com"></div>
          <div class="v3-field"><label>IPv4 Address</label><input id="nIp" required placeholder="203.0.113.10"></div>
          <div class="v3-field"><label>Agent HTTPS URL</label><input id="nUrl" required placeholder="https://203.0.113.10:5055"></div>
          <div class="v3-field"><label>Location</label><input id="nLoc" value="Frankfurt, DE"></div>
          <div class="v3-field" style="display:flex;align-items:flex-end;"><button type="submit" class="btn btn-primary" style="width:100%;">Register Node</button></div>
        </form>
        <div id="nodeCredsOutput" class="v3-code" style="display:none;margin-top:12px;"></div>
      </div>
      <div class="v3-card v3-table-wrap">
        <table class="v3-table">
          <thead><tr><th>ID</th><th>Node</th><th>Endpoint</th><th>Capabilities</th><th>Circuit</th><th>Hardware</th><th>Status</th><th>Actions</th></tr></thead>
          <tbody id="nodesBody"><tr><td colspan="8">Loading nodes...</td></tr></tbody>
        </table>
      </div>
      <% } %>

      <!-- SECTION: STORAGE -->
      <% if (section === 'storage') { %>
      <div class="v3-toolbar">
        <h2 style="margin:0;color:var(--text-primary);">Storage Pools &amp; Capacity</h2>
        <button class="btn btn-outline" onclick="loadStorage(true)">Sync Real Disk Usage (df)</button>
      </div>
      <div class="v3-card">
        <h3>Add Storage Pool</h3>
        <form onsubmit="submitAddPool(event)" class="v3-form-grid">
          <div class="v3-field"><label>Node</label><select id="spNode"><% (nodes||[]).forEach(n => { %><option value="<%= n.id %>"><%= n.name %></option><% }) %></select></div>
          <div class="v3-field"><label>Pool Name</label><input id="spName" required placeholder="nvme-pool-01"></div>
          <div class="v3-field"><label>Backend Type</label>
            <select id="spType"><option value="dir">Directory</option><option value="qcow2">QCOW2 Images</option><option value="raw">RAW Images</option><option value="lvm-thin">LVM Thin</option><option value="zfs">ZFS Dataset</option><option value="btrfs">Btrfs Subvolume</option></select>
          </div>
          <div class="v3-field"><label>Engine Scope</label><select id="spScope"><option value="both">KVM + LXC</option><option value="kvm">KVM Only</option><option value="lxc">LXC Only</option></select></div>
          <div class="v3-field"><label>Host Path</label><input id="spPath" required placeholder="/var/lib/tgvpanel/nvme"></div>
          <div class="v3-field" style="display:flex;align-items:flex-end;"><button class="btn btn-primary" type="submit" style="width:100%;">Create Pool</button></div>
        </form>
      </div>
      <div class="v3-card v3-table-wrap">
        <table class="v3-table">
          <thead><tr><th>Pool</th><th>Node</th><th>Type</th><th>Scope</th><th>Path</th><th>Used / Total</th><th>Overcommit</th><th>Actions</th></tr></thead>
          <tbody id="storageBody"></tbody>
        </table>
      </div>
      <% } %>

      <!-- SECTION: ISOs -->
      <% if (section === 'isos') { %>
      <div class="v3-toolbar">
        <div>
          <h2 style="margin:0;color:var(--text-primary);">KVM Bootable ISO Library</h2>
          <p style="margin:4px 0 0;font-size:13px;color:var(--text-muted);">Download or manage bootable installation ISOs for QEMU/KVM Virtual Machines.</p>
        </div>
        <a href="/admin/vm-create" class="btn btn-primary">Use ISO in VM Wizard</a>
      </div>
      <div class="v3-card">
        <h3>Download Remote ISO URL</h3>
        <form onsubmit="submitDownloadIso(event)" class="v3-form-grid">
          <div class="v3-field" style="grid-column:span 2;"><label>Direct HTTPS ISO URL</label><input id="isoUrl" required placeholder="https://releases.ubuntu.com/24.04/ubuntu-24.04-live-server-amd64.iso"></div>
          <div class="v3-field"><label>Filename</label><input id="isoName" required placeholder="ubuntu-24.04.iso"></div>
          <div class="v3-field" style="display:flex;align-items:flex-end;"><button class="btn btn-primary" type="submit" style="width:100%;">Start Download</button></div>
        </form>
      </div>
      <div class="v3-card v3-table-wrap">
        <table class="v3-table">
          <thead><tr><th>Filename</th><th>Size</th><th>Actions</th></tr></thead>
          <tbody id="isosBody"></tbody>
        </table>
      </div>
      <% } %>

      <!-- SECTION: LXC TEMPLATES -->
      <% if (section === 'lxc-templates') { %>
      <div class="v3-toolbar">
        <h2 style="margin:0;color:var(--text-primary);">LXC OS Template Catalog</h2>
      </div>
      <div class="v3-card">
        <h3>Register or Upload Custom LXC Template</h3>
        <form onsubmit="submitLxcTemplate(event)" class="v3-form-grid">
          <div class="v3-field"><label>Slug</label><input id="ltSlug" required placeholder="ubuntu:24.04-custom"></div>
          <div class="v3-field"><label>Display Name</label><input id="ltName" required placeholder="Ubuntu 24.04 Hardened"></div>
          <div class="v3-field"><label>Distro</label><input id="ltDistro" required value="ubuntu"></div>
          <div class="v3-field"><label>Release</label><input id="ltRelease" required value="noble"></div>
          <div class="v3-field"><label>Rootfs Archive (.tar.xz/.tar.gz optional)</label><input id="ltFile" type="file"></div>
          <div class="v3-field" style="display:flex;align-items:flex-end;"><button class="btn btn-primary" type="submit" style="width:100%;">Save Template</button></div>
        </form>
      </div>
      <div class="v3-card v3-table-wrap">
        <table class="v3-table">
          <thead><tr><th>Slug</th><th>Name</th><th>Distro / Release</th><th>Arch</th><th>Min RAM / Disk</th><th>Source</th><th>Enabled</th><th>Actions</th></tr></thead>
          <tbody id="lxcTplBody"></tbody>
        </table>
      </div>
      <% } %>

      <!-- SECTION: NETWORKING -->
      <% if (section === 'networking') { %>
      <div class="v3-toolbar"><h2 style="margin:0;color:var(--text-primary);">Linux Bridges, VLANs &amp; IP Pools</h2></div>
      <div class="v3-card">
        <h3>Create Network Pool</h3>
        <form onsubmit="submitNetPool(event)" class="v3-form-grid">
          <div class="v3-field"><label>Node</label><select id="npNode"><% (nodes||[]).forEach(n => { %><option value="<%= n.id %>"><%= n.name %></option><% }) %></select></div>
          <div class="v3-field"><label>Pool Name</label><input id="npName" required placeholder="Public Bridge br0"></div>
          <div class="v3-field"><label>Mode</label><select id="npType"><option value="bridge">Bridge</option><option value="nat">NAT</option><option value="routed">Routed</option><option value="vlan">VLAN</option></select></div>
          <div class="v3-field"><label>Bridge Interface</label><input id="npBridge" required value="lxcbr0"></div>
          <div class="v3-field"><label>IPv4 CIDR</label><input id="npCidr" placeholder="10.0.3.0/24"></div>
          <div class="v3-field"><label>Gateway</label><input id="npGw" placeholder="10.0.3.1"></div>
          <div class="v3-field" style="display:flex;align-items:flex-end;"><button class="btn btn-primary" type="submit" style="width:100%;">Create Network Pool</button></div>
        </form>
      </div>
      <div class="v3-card v3-table-wrap">
        <table class="v3-table">
          <thead><tr><th>ID</th><th>Name</th><th>Node</th><th>Type</th><th>Bridge</th><th>IPv4 CIDR</th><th>Gateway</th><th>Add Pool IPs</th></tr></thead>
          <tbody id="netPoolsBody"></tbody>
        </table>
      </div>
      <% } %>

      <!-- SECTION: PORT FORWARDING -->
      <% if (section === 'ports') { %>
      <div class="v3-toolbar"><h2 style="margin:0;color:var(--text-primary);">NAT Port Forwarding &amp; User Quotas</h2></div>
      <div class="v3-card">
        <h3>User Port Quotas</h3>
        <div class="v3-table-wrap">
          <table class="v3-table">
            <thead><tr><th>User</th><th>Used Ports</th><th>Allocated Quota</th><th>Update Quota</th></tr></thead>
            <tbody>
              <% (users||[]).forEach(u => { %>
              <tr>
                <td><%= u.username %> (#<%= u.id %>)</td>
                <td><%= u.used_ports %></td>
                <td><input type="number" id="pq_<%= u.id %>" value="<%= u.allocated_ports %>" min="0" style="width:90px;padding:5px;border-radius:6px;background:var(--bg-secondary);color:var(--text-primary);border:1px solid var(--border-color);"></td>
                <td><button class="btn btn-outline" onclick="savePortQuota(<%= u.id %>)">Save</button></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
      <div class="v3-card v3-table-wrap">
        <h3>Active NAT Port Forwards</h3>
        <table class="v3-table">
          <thead><tr><th>ID</th><th>Owner</th><th>Instance</th><th>Host Port</th><th>Guest Target</th><th>Protocol</th><th>Description</th><th>Actions</th></tr></thead>
          <tbody id="portsBody"></tbody>
        </table>
      </div>
      <% } %>

      <!-- SECTION: FIREWALL -->
      <% if (section === 'firewall') { %>
      <div class="v3-toolbar"><h2 style="margin:0;color:var(--text-primary);">Firewall Policy Rules</h2></div>
      <div class="v3-card">
        <h3>Add Firewall Rule</h3>
        <form onsubmit="submitFwRule(event)" class="v3-form-grid">
          <div class="v3-field"><label>Node</label><select id="fwNode"><% (nodes||[]).forEach(n => { %><option value="<%= n.id %>"><%= n.name %></option><% }) %></select></div>
          <div class="v3-field"><label>Direction</label><select id="fwDir"><option value="in">Ingress (IN)</option><option value="out">Egress (OUT)</option></select></div>
          <div class="v3-field"><label>Action</label><select id="fwAct"><option value="ACCEPT">ACCEPT</option><option value="DROP">DROP</option><option value="REJECT">REJECT</option></select></div>
          <div class="v3-field"><label>Protocol</label><select id="fwProto"><option value="tcp">TCP</option><option value="udp">UDP</option><option value="icmp">ICMP</option><option value="all">ALL</option></select></div>
          <div class="v3-field"><label>Source CIDR (Optional)</label><input id="fwSrc" placeholder="0.0.0.0/0"></div>
          <div class="v3-field"><label>Dest Port</label><input id="fwPort" placeholder="443 or 8000:8010"></div>
          <div class="v3-field"><label>Comment</label><input id="fwComment" placeholder="Allow HTTPS"></div>
          <div class="v3-field" style="display:flex;align-items:flex-end;"><button class="btn btn-primary" type="submit" style="width:100%;">Add Rule</button></div>
        </form>
      </div>
      <div class="v3-card v3-table-wrap">
        <table class="v3-table">
          <thead><tr><th>ID</th><th>Node</th><th>Direction</th><th>Action</th><th>Proto</th><th>Source</th><th>Port</th><th>Comment</th><th>Delete</th></tr></thead>
          <tbody id="fwBody"></tbody>
        </table>
      </div>
      <% } %>

      <!-- SECTION: SNAPSHOTS -->
      <% if (section === 'snapshots') { %>
      <div class="v3-toolbar"><h2 style="margin:0;color:var(--text-primary);">Unified Instance Snapshots (QCOW2 &amp; LXC)</h2></div>
      <div class="v3-card">
        <div class="v3-form-grid">
          <div class="v3-field"><label>Select Instance</label><select id="snapInstSelect" onchange="loadAdminSnapshots()"></select></div>
          <div class="v3-field"><label>Snapshot Name</label><input id="snapName" placeholder="pre_upgrade"></div>
          <div class="v3-field"><label>Description</label><input id="snapDesc" placeholder="Before kernel update"></div>
          <div class="v3-field" style="display:flex;align-items:flex-end;"><button class="btn btn-primary" onclick="createAdminSnapshot()" style="width:100%;">Create Snapshot</button></div>
        </div>
      </div>
      <div class="v3-card v3-table-wrap">
        <table class="v3-table">
          <thead><tr><th>ID</th><th>Snapshot Name</th><th>Description</th><th>Created</th><th>Actions</th></tr></thead>
          <tbody id="snapsBody"></tbody>
        </table>
      </div>
      <% } %>

      <!-- SECTION: BACKUPS -->
      <% if (section === 'backups') { %>
      <div class="v3-toolbar">
        <div>
          <h2 style="margin:0;color:var(--text-primary);">Verified Backups &amp; Database Protection</h2>
          <p style="margin:4px 0 0;font-size:13px;color:var(--text-muted);">SHA-256 verified archive backups for KVM &amp; LXC plus SQLite controller snapshots.</p>
        </div>
        <button class="btn btn-outline" onclick="triggerDbBackup()">Snapshot Controller SQLite DB</button>
      </div>
      <div class="v3-card">
        <div class="v3-form-grid">
          <div class="v3-field"><label>Select Instance</label><select id="bkpInstSelect"></select></div>
          <div class="v3-field"><label>Backup Label</label><input id="bkpLabel" placeholder="weekly_full"></div>
          <div class="v3-field" style="display:flex;align-items:flex-end;"><button class="btn btn-primary" onclick="createAdminBackup()" style="width:100%;">Create Archive Backup</button></div>
        </div>
      </div>
      <div class="v3-card v3-table-wrap">
        <table class="v3-table">
          <thead><tr><th>ID</th><th>Type</th><th>Backup Name</th><th>Node</th><th>Size</th><th>SHA-256 Checksum</th><th>Created</th><th>Actions</th></tr></thead>
          <tbody id="backupsBody"></tbody>
        </table>
      </div>
      <% } %>

      <!-- SECTION: MIGRATIONS -->
      <% if (section === 'migrations') { %>
      <div class="v3-toolbar">
        <div>
          <h2 style="margin:0;color:var(--text-primary);">Offline Verified VPS Migration</h2>
          <p style="margin:4px 0 0;font-size:13px;color:var(--text-muted);">Safe 7-stage offline snapshot-transfer migration between LXC nodes with SHA-256 verification and automatic pre-commit rollback.</p>
        </div>
      </div>
      <div class="v3-card">
        <h3>Start Offline Snapshot-Transfer Migration</h3>
        <form onsubmit="submitMigration(event)" class="v3-form-grid">
          <div class="v3-field"><label>Source LXC Container</label><select id="migLxcSelect" required></select></div>
          <div class="v3-field"><label>Target Node</label><select id="migTargetNode"><% (nodes||[]).forEach(n => { %><option value="<%= n.id %>"><%= n.name %> (<%= n.ip_address %>)</option><% }) %></select></div>
          <div class="v3-field"><label>Target Bridge</label><input id="migBridge" value="lxcbr0"></div>
          <div class="v3-field"><label>Target IPv4 (Optional)</label><input id="migIp" placeholder="Keep existing"></div>
          <div class="v3-field" style="display:flex;align-items:flex-end;"><button class="btn btn-primary" type="submit" style="width:100%;">Execute Verified Migration</button></div>
        </form>
      </div>
      <div class="v3-card v3-table-wrap">
        <table class="v3-table">
          <thead><tr><th>Job #</th><th>Container</th><th>Mode</th><th>Source &rarr; Target</th><th>Status</th><th>Progress</th><th>SHA-256</th><th>Started</th></tr></thead>
          <tbody id="migrationsBody"></tbody>
        </table>
      </div>
      <% } %>

      <!-- SECTION: MONITORING -->
      <% if (section === 'monitoring') { %>
      <div class="v3-toolbar"><h2 style="margin:0;color:var(--text-primary);">Live &amp; Historical Telemetry + Threshold Alerts</h2></div>
      <div class="v3-card">
        <h3>Node Historical Telemetry</h3>
        <div style="margin-bottom:12px;">
          <select id="monNodeSelect" onchange="loadMonitoring()" style="padding:8px 12px;border-radius:8px;background:var(--bg-secondary);color:var(--text-primary);border:1px solid var(--border-color);">
            <% (nodes||[]).forEach(n => { %><option value="<%= n.id %>"><%= n.name %></option><% }) %>
          </select>
          <button class="btn btn-outline" onclick="pollNodeNow()">Collect Live Sample Now</button>
        </div>
        <div id="monMetricsBox" class="v3-table-wrap"></div>
      </div>
      <div class="v3-card">
        <h3>Resource Threshold Alert Rules</h3>
        <form onsubmit="submitAlertRule(event)" class="v3-form-grid" style="margin-bottom:14px;">
          <div class="v3-field"><label>Rule Name</label><input id="alName" required placeholder="High Host CPU"></div>
          <div class="v3-field"><label>Metric</label><select id="alMetric"><option value="cpu_percent">CPU %</option><option value="ram_percent">RAM %</option><option value="disk_percent">Disk %</option></select></div>
          <div class="v3-field"><label>Threshold (%)</label><input id="alThresh" type="number" value="90"></div>
          <div class="v3-field"><label>Severity</label><select id="alSev"><option value="warning">Warning</option><option value="critical">Critical</option></select></div>
          <div class="v3-field" style="display:flex;align-items:flex-end;"><button class="btn btn-primary" type="submit" style="width:100%;">Create Alert Rule</button></div>
        </form>
        <table class="v3-table"><thead><tr><th>Name</th><th>Metric</th><th>Condition</th><th>Severity</th><th>Last Triggered</th><th>Delete</th></tr></thead><tbody id="alertsBody"></tbody></table>
      </div>
      <% } %>

      <!-- SECTION: API KEYS & WEBHOOKS -->
      <% if (section === 'api-keys') { %>
      <div class="v3-toolbar"><h2 style="margin:0;color:var(--text-primary);">Scoped API Keys &amp; Signed Webhooks</h2></div>
      <div class="v3-card">
        <h3>Generate Scoped API Key (SHA-256 Hashed at Rest)</h3>
        <form onsubmit="submitApiKey(event)" class="v3-form-grid">
          <div class="v3-field"><label>Key Name</label><input id="akName" required placeholder="CI/CD Automation"></div>
          <div class="v3-field"><label>Scope</label><select id="akScope"><option value="read">Read-Only</option><option value="read,write">Read + Write</option><option value="read,write,admin">Full Admin</option></select></div>
          <div class="v3-field"><label>Description</label><input id="akDesc" placeholder="Terraform / Billing integration"></div>
          <div class="v3-field" style="display:flex;align-items:flex-end;"><button class="btn btn-primary" type="submit" style="width:100%;">Create Key</button></div>
        </form>
        <div id="akOnceBox" class="v3-code" style="display:none;margin-top:12px;"></div>
        <div class="v3-table-wrap" style="margin-top:14px;">
          <table class="v3-table"><thead><tr><th>Prefix</th><th>Name</th><th>Scopes</th><th>Last Used</th><th>Created</th><th>Revoke</th></tr></thead><tbody id="akBody"></tbody></table>
        </div>
      </div>
      <div class="v3-card">
        <h3>Outbound HMAC-SHA256 Webhooks</h3>
        <form onsubmit="submitWebhook(event)" class="v3-form-grid">
          <div class="v3-field"><label>Name</label><input id="whName" required placeholder="Ops Pager"></div>
          <div class="v3-field" style="grid-column:span 2;"><label>Endpoint URL</label><input id="whUrl" required placeholder="https://hooks.example.com/tgvpanel"></div>
          <div class="v3-field" style="display:flex;align-items:flex-end;"><button class="btn btn-primary" type="submit" style="width:100%;">Register Webhook</button></div>
        </form>
        <div class="v3-table-wrap" style="margin-top:14px;">
          <table class="v3-table"><thead><tr><th>Name</th><th>URL</th><th>Events</th><th>Last HTTP Status</th><th>Delete</th></tr></thead><tbody id="whBody"></tbody></table>
        </div>
      </div>
      <% } %>

      <!-- SECTION: AUDIT LOGS -->
      <% if (section === 'audit-logs') { %>
      <div class="v3-toolbar"><h2 style="margin:0;color:var(--text-primary);">Security &amp; Activity Audit Trail</h2></div>
      <div class="v3-card v3-table-wrap">
        <table class="v3-table">
          <thead><tr><th>ID</th><th>Timestamp</th><th>Actor</th><th>Action</th><th>Resource</th><th>Details</th></tr></thead>
          <tbody id="auditBody"></tbody>
        </table>
      </div>
      <% } %>

      <!-- SECTION: NODE CONSOLE -->
      <% if (section === 'node-console') { %>
      <%
        const _ncNodes = Array.isArray(nodes) ? nodes : [];
        const _ncPresets = [
          { id: 'uptime', cat: 'sys', label: 'Uptime & Load Avg', cmd: 'uptime', svg: '<circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 15"/>' },
          { id: 'uname', cat: 'sys', label: 'Kernel & Architecture', cmd: 'uname -a', svg: '<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/>' },
          { id: 'memory', cat: 'sys', label: 'Memory & Swap Usage', cmd: 'free -h', svg: '<path d="M6 19v-3M10 19v-3M14 19v-3M18 19v-3M4 6h16a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z"/>' },
          { id: 'disk', cat: 'sys', label: 'Filesystems & Storage', cmd: 'df -hT', svg: '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>' },
          { id: 'processes', cat: 'sys', label: 'Top Host Processes', cmd: 'ps aux --sort=-%mem', svg: '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>' },
          { id: 'network_links', cat: 'net', label: 'Network Interfaces & IPs', cmd: 'ip -br addr', svg: '<rect x="2" y="2" width="6" height="6" rx="1"/><rect x="16" y="16" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><path d="M5 8v8M8 5h11v11"/>' },
          { id: 'network_routes', cat: 'net', label: 'IPv4 Routing Table', cmd: 'ip route', svg: '<circle cx="6" cy="19" r="3"/><path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"/><circle cx="18" cy="5" r="3"/>' },
          { id: 'bridges', cat: 'net', label: 'Linux Bridges', cmd: 'ip link show type bridge', svg: '<path d="M4 18v-6a8 8 0 0 1 16 0v6"/><line x1="2" y1="18" x2="22" y2="18"/><line x1="8" y1="12" x2="8" y2="18"/><line x1="16" y1="12" x2="16" y2="18"/>' },
          { id: 'iptables_nat', cat: 'net', label: 'NAT & Masquerade Rules', cmd: 'iptables -t nat -S', svg: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>' },
          { id: 'sysctl_net', cat: 'net', label: 'IPv4 Packet Forwarding', cmd: 'sysctl net.ipv4.ip_forward', svg: '<polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/>' },
          { id: 'lxc_list', cat: 'virt', label: 'LXC Runtime Summary', cmd: 'lxc-ls -f', svg: '<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>' },
          { id: 'lxc_checkconfig', cat: 'virt', label: 'LXC Kernel Capabilities', cmd: 'lxc-checkconfig', svg: '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>' },
          { id: 'qemu_version', cat: 'virt', label: 'QEMU Hypervisor Version', cmd: 'qemu-system-x86_64 --version', svg: '<rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>' }
        ];
      %>
      <div class="nc-wrap">
        <!-- Hero Header -->
        <div class="nc-hero">
          <div class="nc-hero-left">
            <div class="nc-hero-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="4 17 10 11 4 5"></polyline>
                <line x1="12" y1="19" x2="20" y2="19"></line>
              </svg>
            </div>
            <div>
              <div class="nc-title-row">
                <h2 class="nc-title">Node Diagnostic &amp; Host Console</h2>
                <span class="v3-pill kvm" style="font-size:10.5px;letter-spacing:0.5px;">SUPER-ADMIN AUDITED</span>
                <span id="ncNodeStatePill" class="v3-pill online" style="font-size:10.5px;">&bull; ONLINE</span>
              </div>
              <p class="nc-sub">
                <span id="ncHostMeta">Inspecting live host state via shell-free allowlisted binaries</span>
                <span>&bull;</span>
                <span id="ncUptimeMeta">Telemetry ready</span>
              </p>
            </div>
          </div>

          <div class="nc-hero-actions">
            <div class="nc-node-select-wrap">
              <label for="diagNode">Target Node</label>
              <select id="diagNode" class="nc-node-select" onchange="onNodeConsoleSwitch()">
                <% _ncNodes.forEach(n => { %>
                  <option value="<%= n.id %>"><%= n.name %> (<%= n.is_local ? 'local' : n.ip_address %>)</option>
                <% }) %>
              </select>
            </div>
            <button type="button" class="btn btn-outline" id="ncRefreshTelemetryBtn" onclick="refreshNodeConsoleTelemetry()" style="padding:8px 13px;font-size:12.5px;">
              &#8635; Refresh Telemetry
            </button>
            <button type="button" class="btn btn-primary" id="ncHealthSuiteBtn" onclick="runNodeHealthSuite()" style="padding:8px 14px;font-size:12.5px;">
              &#9654; Run Full Health Check
            </button>
            <a href="/admin/audit-logs" class="btn btn-outline" style="padding:8px 12px;font-size:12.5px;">Audit Trail</a>
          </div>
        </div>

        <!-- Live 4-Card Host Telemetry Strip -->
        <div class="nc-telemetry-grid">
          <div class="nc-stat-card">
            <div class="nc-stat-top">
              <span class="nc-stat-label">CPU &amp; Load Average</span>
              <span class="nc-stat-val" id="ncCpuVal">&mdash;</span>
            </div>
            <div class="nc-bar-track">
              <div class="nc-bar-fill" id="ncCpuBar" style="width:0%;background:linear-gradient(90deg,#06b6d4,#6366f1);"></div>
            </div>
            <div class="nc-stat-foot">
              <span id="ncCpuCores">&mdash; Cores</span>
              <span id="ncLoadAvg">Load: &mdash;</span>
            </div>
          </div>

          <div class="nc-stat-card">
            <div class="nc-stat-top">
              <span class="nc-stat-label">Memory &amp; Swap</span>
              <span class="nc-stat-val" id="ncRamVal">&mdash;</span>
            </div>
            <div class="nc-bar-track">
              <div class="nc-bar-fill" id="ncRamBar" style="width:0%;background:linear-gradient(90deg,#8b5cf6,#ec4899);"></div>
            </div>
            <div class="nc-stat-foot">
              <span id="ncRamDetail">&mdash; / &mdash; MB</span>
              <span id="ncSwapDetail">Swap: &mdash;</span>
            </div>
          </div>

          <div class="nc-stat-card">
            <div class="nc-stat-top">
              <span class="nc-stat-label">Root Filesystem</span>
              <span class="nc-stat-val" id="ncDiskVal">&mdash;</span>
            </div>
            <div class="nc-bar-track">
              <div class="nc-bar-fill" id="ncDiskBar" style="width:0%;background:linear-gradient(90deg,#10b981,#06b6d4);"></div>
            </div>
            <div class="nc-stat-foot">
              <span id="ncDiskDetail">&mdash; / &mdash; GB</span>
              <span id="ncDiskFree">&mdash; free</span>
            </div>
          </div>

          <div class="nc-stat-card">
            <div class="nc-stat-top">
              <span class="nc-stat-label">Engine &amp; Policy Matrix</span>
              <span class="v3-pill lxc" style="font-size:10px;padding:1px 7px;" id="ncAgentVer">v3.0</span>
            </div>
            <div class="nc-cap-grid">
              <div class="nc-cap-chip"><span>KVM /dev/kvm</span><span class="nc-dot off" id="ncCapKvm"></span></div>
              <div class="nc-cap-chip"><span>QEMU Binary</span><span class="nc-dot off" id="ncCapQemu"></span></div>
              <div class="nc-cap-chip"><span>LXC Runtime</span><span class="nc-dot off" id="ncCapLxc"></span></div>
              <div class="nc-cap-chip"><span>Host PTY</span><span class="nc-dot <%= interactiveEnabled ? 'ok' : 'warn' %>"></span></div>
            </div>
          </div>
        </div>

        <!-- Safe Diagnostic Workbench (Sidebar + Terminal Output Window) -->
        <div class="nc-workbench">
          <div class="nc-preset-panel">
            <div class="nc-preset-head">
              <h3>Safe Diagnostic Presets</h3>
              <span class="v3-pill running" style="font-size:10px;padding:2px 8px;"><%= _ncPresets.length %> ALLOWLISTED</span>
            </div>
            <input type="text" id="ncPresetSearch" class="nc-search" placeholder="Filter diagnostics (e.g. ip, lxc, nat, disk)..." oninput="filterNcPresets()">
            <div class="nc-cat-tabs" role="tablist">
              <button type="button" class="nc-cat-btn active" data-cat="all" onclick="setNcCategory('all', this)">All</button>
              <button type="button" class="nc-cat-btn" data-cat="sys" onclick="setNcCategory('sys', this)">System</button>
              <button type="button" class="nc-cat-btn" data-cat="net" onclick="setNcCategory('net', this)">Network</button>
              <button type="button" class="nc-cat-btn" data-cat="virt" onclick="setNcCategory('virt', this)">Engines</button>
            </div>
            <div class="nc-preset-list" id="ncPresetList">
              <% _ncPresets.forEach((p, idx) => { %>
                <button type="button"
                  class="nc-preset-btn <%= idx === 0 ? 'active' : '' %>"
                  data-preset="<%= p.id %>"
                  data-cat="<%= p.cat %>"
                  data-search="<%= (p.id + ' ' + p.label + ' ' + p.cmd).toLowerCase() %>"
                  onclick="runDiag('<%= p.id %>')">
                  <span class="nc-preset-ico <%= p.cat %>">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%- p.svg %></svg>
                  </span>
                  <span class="nc-preset-meta">
                    <div class="nc-preset-name"><%= p.label %></div>
                    <div class="nc-preset-cmd">$ <%= p.cmd %></div>
                  </span>
                </button>
              <% }) %>
            </div>
          </div>

          <div class="nc-term-card">
            <div class="nc-term-bar">
              <div class="nc-term-left">
                <div class="nc-win-dots" aria-hidden="true">
                  <span style="background:#ef4444;"></span>
                  <span style="background:#f59e0b;"></span>
                  <span style="background:#10b981;"></span>
                </div>
                <div class="nc-cmd-badge" id="ncCmdDisplay"><span class="prompt">$</span>uptime</div>
                <span id="ncExitBadge" class="v3-pill online" style="display:none;font-size:10.5px;">EXIT 0</span>
                <span id="ncDurationBadge" style="font-size:11px;color:var(--text-muted);font-family:monospace;"></span>
              </div>
              <div class="nc-term-tools">
                <button type="button" class="nc-tool-btn primary" onclick="rerunActiveDiag()" title="Re-run active preset">&#8635; Re-run</button>
                <button type="button" class="nc-tool-btn" id="ncWrapBtn" onclick="toggleDiagWrap()">Wrap: Off</button>
                <button type="button" class="nc-tool-btn" onclick="copyDiagOutput()">Copy</button>
                <button type="button" class="nc-tool-btn" onclick="downloadDiagOutput()">.log</button>
                <button type="button" class="nc-tool-btn" onclick="clearDiagOutput()">Clear</button>
              </div>
            </div>
            <pre id="diagOutput" class="nc-term-body">Initializing live node diagnostic console...</pre>
            <div class="nc-term-foot">
              <div class="nc-history-row">
                <span style="font-weight:600;color:var(--text-secondary);">Recent runs:</span>
                <div id="ncHistoryChips" style="display:inline-flex;gap:5px;flex-wrap:wrap;">
                  <span style="color:var(--text-muted);">None yet</span>
                </div>
              </div>
              <span id="ncExecTimestamp">Zero-shell spawn (<code>shell: false</code>)</span>
            </div>
          </div>
        </div>

        <!-- Interactive Host PTY Shell Studio -->
        <div class="nc-pty-card" id="ncPtyCard">
          <div class="nc-term-bar">
            <div class="nc-term-left">
              <div class="nc-win-dots" aria-hidden="true">
                <span style="background:#ef4444;"></span>
                <span style="background:#f59e0b;"></span>
                <span style="background:#10b981;"></span>
              </div>
              <strong style="font-size:13.5px;color:#f8fafc;">Interactive Host PTY Shell</strong>
              <% if (interactiveEnabled) { %>
                <span class="v3-pill running" style="font-size:10.5px;">ENABLED &bull; LINE-AUDITED</span>
                <span id="ncPtyStateBadge" class="v3-pill stopped" style="font-size:10.5px;">Idle (Not Connected)</span>
              <% } else { %>
                <span class="v3-pill warning" style="font-size:10.5px;gap:5px;">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  LOCKED BY SERVER POLICY
                </span>
              <% } %>
            </div>
            <% if (interactiveEnabled) { %>
            <div class="nc-term-tools">
              <button type="button" class="nc-tool-btn primary" id="ncPtyConnectBtn" onclick="connectNodeShell()">&#9654; Connect Shell</button>
              <button type="button" class="nc-tool-btn" onclick="clearNodeShell()">Clear</button>
              <button type="button" class="nc-tool-btn" onclick="adjustNodeShellFont(-1)">A-</button>
              <button type="button" class="nc-tool-btn" onclick="adjustNodeShellFont(1)">A+</button>
              <button type="button" class="nc-tool-btn" id="ncPtyFsBtn" onclick="toggleNodeShellFullscreen()">&#9974; Fullscreen</button>
              <button type="button" class="nc-tool-btn danger" id="ncPtyDisconnectBtn" onclick="disconnectNodeShell()" style="display:none;">Disconnect</button>
            </div>
            <% } %>
          </div>

          <% if (!interactiveEnabled) { %>
          <div class="nc-pty-locked">
            <div>
              <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
                <span style="width:32px;height:32px;border-radius:9px;background:rgba(245,158,11,0.16);border:1px solid rgba(245,158,11,0.35);color:#fbbf24;display:inline-flex;align-items:center;justify-content:center;">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </span>
                <h4 style="margin:0;font-size:15px;font-weight:700;color:#f8fafc;">Zero-Trust Host PTY Protection Active</h4>
              </div>
              <p style="font-size:13px;line-height:1.6;color:#94a3b8;margin:0 0 14px;">
                Unrestricted root PTY access to the hypervisor host is disabled by default so that all routine troubleshooting runs safely through the <strong>Allowlisted Diagnostic Workbench</strong> above without exposing raw shell execution.
              </p>
              <div style="display:flex;gap:8px;flex-wrap:wrap;">
                <span class="v3-pill running" style="font-size:11px;">&#10003; 13 Allowlisted Presets Active</span>
                <span class="v3-pill lxc" style="font-size:11px;">&#10003; Per-Container PTY Available in LXC View</span>
                <span class="v3-pill kvm" style="font-size:11px;">&#10003; Command-Line Audit Logging</span>
              </div>
            </div>
            <div class="nc-env-snippet">
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
                <span style="font-size:11px;color:#94a3b8;font-weight:600;">Opt-in via server <code>.env</code> &amp; restart TGVPANEL:</span>
                <button type="button" class="nc-tool-btn primary" style="padding:3px 9px;font-size:11px;" onclick="copyNodeShellEnvFlag()">Copy .env Flag</button>
              </div>
              <div style="color:#64748b;margin-bottom:3px;"># Enable audited super-admin host PTY shell</div>
              <div style="color:#22d3ee;font-weight:700;">HKVM_ENABLE_NODE_SHELL=true</div>
            </div>
          </div>
          <% } else { %>
          <div id="nodeXtermBox" style="height:430px;background:#06070c;padding:8px;">
            <div style="height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#64748b;gap:10px;text-align:center;">
              <div style="font-family:monospace;font-size:13px;color:#94a3b8;">root@host:~# <span style="color:#22d3ee;">[Audited node-pty session ready]</span></div>
              <div style="font-size:12.5px;max-width:440px;">Click <strong>Connect Shell</strong> in the top-right bar to spawn a live WebSocket <code>xterm-256color</code> session on the selected node. Every command line is recorded in the Security Audit Trail.</div>
              <button type="button" class="btn btn-primary" onclick="connectNodeShell()" style="margin-top:4px;">&#9654; Launch Audited Host Shell</button>
            </div>
          </div>
          <% } %>
        </div>
      </div>
      <% } %>

      <!-- SECTION: LICENSE -->
      <% if (section === 'license') { %>
      <div class="v3-toolbar"><h2 style="margin:0;color:var(--text-primary);">TGVPANEL V3 Edition &amp; License</h2></div>
      <div class="v3-card">
        <h3>Unified Free &amp; Open Control Plane</h3>
        <p style="font-size:14px;color:var(--text-secondary);">This TGVPANEL V3 installation is permanently unlocked with multi-node QEMU/KVM + Native LXC support, offline verified migrations, RBAC, and REST API v1.</p>
        <div class="v3-code"><%= JSON.stringify(licenseInfo, null, 2) %></div>
      </div>
      <% } %>

    </div>
    <%- include('../partials/admin/footer') %>
  </div>
</div>

<script>
const CURRENT_SECTION = '<%= section %>';

async function instAction(engine, id, action) {
  let reason;
  if (action === 'suspend') {
    reason = prompt('Enter suspension reason:', 'Administrative suspension');
    if (reason === null) return;
  }
  if (action === 'delete' && !confirm('Permanently delete ' + engine.toUpperCase() + ' #' + id + '?')) return;
  try {
    await hkvmApi('/api/v1/instances/' + engine + '/' + id + '/action', {
      method: 'POST',
      body: { action, reason }
    });
    hkvmToast('Action "' + action + '" completed');
    if (CURRENT_SECTION === 'instances') loadUnifiedInstances();
    if (CURRENT_SECTION === 'lxc') loadLxcList();
  } catch (e) {
    hkvmToast(e.message, 'error');
  }
}

async function loadUnifiedInstances() {
  const engine = document.getElementById('instEngineFilter').value;
  const search = document.getElementById('instSearch').value;
  const q = new URLSearchParams();
  if (engine) q.set('engine', engine);
  if (search) q.set('search', search);
  const data = await hkvmApi('/api/v1/instances?' + q.toString());
  const tbody = document.getElementById('instTableBody');
  if (!data.instances.length) {
    tbody.innerHTML = '<tr><td colspan="9" style="text-align:center;color:var(--text-muted);">No instances match current filter.</td></tr>';
    return;
  }
  tbody.innerHTML = data.instances.map(i => {
    const manageHref = i.engine === 'kvm' ? '/admin/vm/' + i.refId : '/lxc/' + i.refId;
    const freezeBtn = i.capabilities.supportsFreeze
      ? (i.status === 'frozen'
          ? `<button class="btn btn-outline" onclick="instAction('lxc',${i.refId},'unfreeze')">Unfreeze</button>`
          : `<button class="btn btn-outline" onclick="instAction('lxc',${i.refId},'freeze')">Freeze</button>`)
      : '';
    const suspBtn = i.suspended
      ? `<button class="btn btn-outline" onclick="instAction('${i.engine}',${i.refId},'unsuspend')">Unsuspend</button>`
      : `<button class="btn btn-outline" onclick="instAction('${i.engine}',${i.refId},'suspend')">Suspend</button>`;
    return `<tr>
      <td><input type="checkbox" class="inst-chk" value="${i.uid}"></td>
      <td><span class="v3-pill ${i.engine}">${i.engine.toUpperCase()}</span></td>
      <td><strong>${hkvmEsc(i.name)}</strong><div style="font-size:11px;color:var(--text-muted);">${hkvmEsc(i.osLabel)}</div></td>
      <td>${hkvmEsc(i.ownerUsername || '#' + i.ownerId)}</td>
      <td>${hkvmEsc(i.nodeName || '#' + i.nodeId)}</td>
      <td>${i.cpuCores} vCPU • ${i.ramMb} MB • ${i.diskGb} GB</td>
      <td><code>${hkvmEsc(i.primaryIp || '-')}</code></td>
      <td><span class="v3-pill ${i.status}">${hkvmEsc(i.status)}</span></td>
      <td class="v3-btn-row">
        <a class="btn btn-primary" href="${manageHref}">Manage</a>
        <button class="btn btn-outline" onclick="instAction('${i.engine}',${i.refId},'start')">Start</button>
        <button class="btn btn-outline" onclick="instAction('${i.engine}',${i.refId},'stop')">Stop</button>
        ${freezeBtn}
        ${suspBtn}
        <button class="btn btn-outline" style="color:#ef4444;" onclick="instAction('${i.engine}',${i.refId},'delete')">Delete</button>
      </td>
    </tr>`;
  }).join('');
}

async function bulkSelected(action) {
  const targets = Array.from(document.querySelectorAll('.inst-chk:checked')).map(c => c.value);
  if (!targets.length) return hkvmToast('Select at least one instance first', 'warning');
  const res = await hkvmApi('/api/v1/instances/bulk-action', { method: 'POST', body: { action, targets } });
  const okCount = res.results.filter(r => r.ok).length;
  hkvmToast(`Bulk ${action}: ${okCount}/${targets.length} succeeded`);
  loadUnifiedInstances();
}

async function loadLxcList() {
  const data = await hkvmApi('/api/v1/instances?engine=lxc');
  const tbody = document.getElementById('lxcTableBody');
  if (!data.instances.length) {
    tbody.innerHTML = '<tr><td colspan="9" style="text-align:center;color:var(--text-muted);">No LXC containers created yet.</td></tr>';
    return;
  }
  tbody.innerHTML = data.instances.map(i => `<tr>
    <td>#${i.refId}</td>
    <td><strong>${hkvmEsc(i.name)}</strong></td>
    <td>${hkvmEsc(i.osLabel)}</td>
    <td>${hkvmEsc(i.ownerUsername || '#' + i.ownerId)}</td>
    <td>${hkvmEsc(i.nodeName || '#' + i.nodeId)}</td>
    <td>${i.cpuCores}c / ${i.ramMb}MB / ${i.diskGb}GB</td>
    <td><code>${hkvmEsc(i.primaryIp || 'DHCP')}</code></td>
    <td><span class="v3-pill ${i.status}">${hkvmEsc(i.status)}</span></td>
    <td class="v3-btn-row">
      <a class="btn btn-primary" href="/lxc/${i.refId}">Manage</a>
      <a class="btn btn-outline" href="/lxc/${i.refId}/console">PTY Console</a>
      <button class="btn btn-outline" onclick="renewLxc(${i.refId})">+30d Renew</button>
      <button class="btn btn-outline" style="color:#ef4444;" onclick="instAction('lxc',${i.refId},'delete')">Delete</button>
    </td>
  </tr>`).join('');
}

async function renewLxc(id) {
  await hkvmApi('/api/v1/lxc/' + id + '/renew', { method: 'POST', body: { days: 30 } });
  hkvmToast('Renewed expiration by +30 days');
  loadLxcList();
}

async function syncHostLxc() {
  const btn = document.getElementById('syncHostLxcBtn');
  if (btn) { btn.disabled = true; btn.textContent = 'Syncing...'; }
  try {
    const out = await hkvmApi('/api/v1/lxc/sync-host', { method: 'POST' });
    if (out.count > 0) {
      hkvmToast('Imported ' + out.count + ' host container(s): ' + out.imported.join(', '));
    } else {
      hkvmToast('All host LXC containers are already synced.');
    }
    loadLxcList();
  } catch (err) {
    hkvmToast(err.message, 'error');
  } finally {
    if (btn) { btn.disabled = false; btn.textContent = 'Sync Host Containers'; }
  }
}

let __lxcCreating = false;
let __lxcHostCustom = false;
let __lxcActiveCat = 'all';
let __lxcIpMode = 'dhcp';
let __lxcCatalog = [];
let __lxcNodes = [];
let __lxcNetPools = [];

function parseEmbeddedJson(id) {
  const el = document.getElementById(id);
  if (!el) return [];
  try { return JSON.parse(el.textContent || '[]'); } catch { return []; }
}

function getDistroBrand(t) {
  const d = String(t.distro || t.slug || '').toLowerCase();
  if (d.includes('ubuntu')) return { bg: 'rgba(233,84,32,0.16)', fg: '#fb923c', short: 'UB', cat: 'ubuntu' };
  if (d.includes('debian')) return { bg: 'rgba(215,10,83,0.16)', fg: '#f43f5e', short: 'DB', cat: 'debian' };
  if (d.includes('alma')) return { bg: 'rgba(16,185,129,0.16)', fg: '#34d399', short: 'AL', cat: 'rhel' };
  if (d.includes('rocky')) return { bg: 'rgba(6,182,212,0.16)', fg: '#22d3ee', short: 'RK', cat: 'rhel' };
  if (d.includes('centos')) return { bg: 'rgba(139,92,246,0.16)', fg: '#a78bfa', short: 'CS', cat: 'rhel' };
  if (d.includes('fedora')) return { bg: 'rgba(59,130,246,0.18)', fg: '#60a5fa', short: 'FD', cat: 'fedora' };
  if (d.includes('kali')) return { bg: 'rgba(168,85,247,0.18)', fg: '#c084fc', short: 'KL', cat: 'security' };
  if (d.includes('alpine')) return { bg: 'rgba(14,165,233,0.16)', fg: '#38bdf8', short: 'AP', cat: 'security' };
  return { bg: 'rgba(148,163,184,0.16)', fg: '#cbd5e1', short: 'LX', cat: 'security' };
}

function initLxcCreateStudio() {
  __lxcCatalog = parseEmbeddedJson('lxcCatalogJson');
  __lxcNodes = parseEmbeddedJson('lxcNodesJson');
  __lxcNetPools = parseEmbeddedJson('lxcNetPoolsJson');
  renderLxcOsGrid();
  updateSelectedOsBanner();
  updateLxcBlueprint();
}

function setLxcCat(cat, btnEl) {
  __lxcActiveCat = cat;
  document.querySelectorAll('#lxcCatBar .lxc-cat-pill').forEach(b => b.classList.remove('active'));
  if (btnEl) btnEl.classList.add('active');
  renderLxcOsGrid();
}

function renderLxcOsGrid() {
  const grid = document.getElementById('lxcOsGrid');
  const sel = document.getElementById('cTpl');
  if (!grid || !sel) return;
  const q = (document.getElementById('lxcTplSearch')?.value || '').trim().toLowerCase();
  const activeSlug = sel.value;

  const filtered = __lxcCatalog.filter(t => {
    const brand = getDistroBrand(t);
    if (__lxcActiveCat === 'custom' && !t.is_custom) return false;
    if (__lxcActiveCat !== 'all' && __lxcActiveCat !== 'custom' && brand.cat !== __lxcActiveCat) return false;
    if (q) {
      const hay = [t.name, t.label, t.slug, t.distro, t.release, t.description].join(' ').toLowerCase();
      if (!hay.includes(q)) return false;
    }
    return true;
  });

  if (!filtered.length) {
    grid.innerHTML = '<div style="grid-column:1/-1;padding:18px;text-align:center;color:var(--text-muted);font-size:12.5px;">No OS templates match this filter.</div>';
    return;
  }

  grid.innerHTML = filtered.map(t => {
    const b = getDistroBrand(t);
    const isSel = t.slug === activeSlug;
    const minRam = t.min_ram_mb || 256;
    const minDisk = t.min_disk_gb || 5;
    return `<div class="lxc-os-card ${isSel ? 'selected' : ''}" onclick="selectLxcTemplate('${hkvmEsc(t.slug)}')">
      <span class="lxc-os-check">&#10003;</span>
      <div class="lxc-os-top">
        <span class="lxc-os-icon" style="background:${b.bg};color:${b.fg};border:1px solid ${b.fg}33;">${b.short}</span>
        <div>
          <div class="lxc-os-name">${hkvmEsc(t.name || t.label || t.slug)}</div>
          <div style="font-size:11px;color:var(--text-muted);margin-top:1px;"><code>${hkvmEsc(t.distro || 'linux')}:${hkvmEsc(t.release || '')}</code> &bull; ${hkvmEsc(t.arch || 'amd64')}</div>
        </div>
      </div>
      <div class="lxc-os-meta">
        <span>&ge;${minRam}MB RAM</span>
        <span>&bull;</span>
        <span>&ge;${minDisk}GB Disk</span>
        ${t.is_custom ? '<span class="v3-pill kvm" style="font-size:10px;padding:1px 6px;">Custom</span>' : ''}
      </div>
    </div>`;
  }).join('');
}

function selectLxcTemplate(slug) {
  const sel = document.getElementById('cTpl');
  if (!sel) return;
  sel.value = slug;
  const tpl = __lxcCatalog.find(t => t.slug === slug);
  if (tpl) {
    const ramInput = document.getElementById('cRam');
    const diskInput = document.getElementById('cDisk');
    if (ramInput && tpl.min_ram_mb && Number(ramInput.value) < Number(tpl.min_ram_mb)) {
      ramInput.value = tpl.min_ram_mb;
    }
    if (diskInput && tpl.min_disk_gb && Number(diskInput.value) < Number(tpl.min_disk_gb)) {
      diskInput.value = tpl.min_disk_gb;
    }
  }
  renderLxcOsGrid();
  updateSelectedOsBanner();
  updateLxcBlueprint();
}

function updateSelectedOsBanner() {
  const banner = document.getElementById('lxcSelectedOsBanner');
  const sel = document.getElementById('cTpl');
  if (!banner || !sel) return;
  const tpl = __lxcCatalog.find(t => t.slug === sel.value) || __lxcCatalog[0];
  if (!tpl) { banner.style.display = 'none'; return; }
  banner.style.display = 'flex';
  banner.innerHTML =
    '<div><strong style="color:var(--text-primary);">Selected Image:</strong> ' + hkvmEsc(tpl.name || tpl.slug) +
    (tpl.description ? ' &mdash; <span style="color:var(--text-muted);">' + hkvmEsc(tpl.description) + '</span>' : '') + '</div>' +
    '<div><code>' + hkvmEsc(tpl.slug) + '</code></div>';
}

function selectLxcNode(nodeId) {
  const sel = document.getElementById('cNode');
  if (sel) sel.value = String(nodeId);
  document.querySelectorAll('#lxcNodeCards .lxc-node-card').forEach(el => {
    el.classList.toggle('selected', Number(el.getAttribute('data-node-id')) === Number(nodeId));
  });
  updateLxcBlueprint();
}

function onLxcNameInput() {
  const raw = document.getElementById('cName').value;
  const hint = document.getElementById('cNameHint');
  const hostEl = document.getElementById('cHost');
  if (!__lxcHostCustom && hostEl) {
    hostEl.placeholder = raw.trim() ? raw.trim() + '.local' : 'vps-prod-01.local';
  }
  if (hint) {
    if (!raw.trim()) {
      hint.innerHTML = 'Letters, digits, hyphens, underscores (e.g. <code>web-node-01</code>).';
      hint.style.color = 'var(--text-muted)';
    } else if (/^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,62}$/.test(raw.trim())) {
      hint.textContent = '✓ Valid LXC container identifier';
      hint.style.color = '#10b981';
    } else {
      hint.textContent = 'Must start with a letter/digit and contain only letters, digits, hyphens, dots, or underscores.';
      hint.style.color = '#ef4444';
    }
  }
  updateLxcBlueprint();
}

function onLxcHostInput() {
  const v = document.getElementById('cHost').value.trim();
  __lxcHostCustom = v.length > 0;
  updateLxcBlueprint();
}

function genRandomLxcName() {
  const sel = document.getElementById('cTpl');
  const base = (sel?.value || 'lxc').split('-')[0].replace(/[^a-z0-9]/gi, '').slice(0, 8) || 'lxc';
  const suffix = Math.random().toString(36).slice(2, 6);
  const generated = base + '-vps-' + suffix;
  const nameEl = document.getElementById('cName');
  if (nameEl) nameEl.value = generated;
  if (!__lxcHostCustom) {
    const hostEl = document.getElementById('cHost');
    if (hostEl) hostEl.value = generated + '.local';
  }
  onLxcNameInput();
}

function clearActivePreset() {
  document.querySelectorAll('#lxcPresetGrid .lxc-preset-card').forEach(b => b.classList.remove('active'));
}

function applyLxcPreset(key, cpu, ram, swap, disk, btnEl) {
  clearActivePreset();
  if (btnEl) btnEl.classList.add('active');
  syncLxcCpu(cpu, 'preset');
  document.getElementById('cRam').value = ram;
  document.getElementById('cSwap').value = swap;
  document.getElementById('cDisk').value = disk;
  updateLxcBlueprint();
}

function syncLxcCpu(val, source) {
  const n = Math.max(1, Math.min(128, Number(val) || 1));
  const numEl = document.getElementById('cCpu');
  const rngEl = document.getElementById('cCpuRange');
  if (numEl && source !== 'num') numEl.value = n;
  if (rngEl && source !== 'range') rngEl.value = Math.min(32, n);
  if (source !== 'preset') clearActivePreset();
  updateLxcBlueprint();
}

function setNumericField(id, val) {
  const el = document.getElementById(id);
  if (!el) return;
  el.value = val;
  if (id === 'cRam' || id === 'cSwap' || id === 'cDisk') clearActivePreset();
  updateLxcBlueprint();
}

function setLxcIpMode(mode) {
  __lxcIpMode = mode;
  document.getElementById('ipModeDhcpBtn')?.classList.toggle('active', mode === 'dhcp');
  document.getElementById('ipModeStaticBtn')?.classList.toggle('active', mode === 'static');
  const box = document.getElementById('lxcStaticIpFields');
  if (box) box.style.display = mode === 'static' ? 'block' : 'none';
  if (mode === 'dhcp') {
    const ipEl = document.getElementById('cIp');
    if (ipEl) ipEl.value = '';
  }
  updateLxcBlueprint();
}

function applyLxcNetworkPool(poolId) {
  if (!poolId) return;
  const pool = __lxcNetPools.find(p => Number(p.id) === Number(poolId));
  if (!pool) return;
  if (pool.bridge_name) document.getElementById('cBridge').value = pool.bridge_name;
  if (pool.gateway) {
    setLxcIpMode('static');
    const gwEl = document.getElementById('cGateway');
    if (gwEl) gwEl.value = pool.gateway;
  }
  if (pool.vlan_id) {
    setLxcIpMode('static');
    const vlanEl = document.getElementById('cVlan');
    if (vlanEl) vlanEl.value = pool.vlan_id;
  }
  updateLxcBlueprint();
}

function genCustomLxcPassword() {
  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#$%^&*';
  const arr = new Uint32Array(18);
  window.crypto.getRandomValues(arr);
  let pw = '';
  for (let i = 0; i < arr.length; i++) pw += chars[arr[i] % chars.length];
  const el = document.getElementById('cRootPw');
  if (el) {
    el.value = pw;
    el.type = 'text';
    const tog = document.getElementById('cRootPwToggle');
    if (tog) tog.textContent = 'Hide';
  }
  updateLxcBlueprint();
}

function toggleLxcPwVis() {
  const el = document.getElementById('cRootPw');
  const tog = document.getElementById('cRootPwToggle');
  if (!el) return;
  el.type = el.type === 'password' ? 'text' : 'password';
  if (tog) tog.textContent = el.type === 'password' ? 'Show' : 'Hide';
}

function copyCreatedLxcPw() {
  if (!window.__lastCreatedLxcPw) return;
  navigator.clipboard.writeText(window.__lastCreatedLxcPw).then(() => {
    hkvmToast('Root password copied to clipboard');
  }).catch(() => {
    hkvmToast('Copy manually from the highlighted code box', 'warning');
  });
}

function updateLxcBlueprint() {
  if (CURRENT_SECTION !== 'instances-create') return;
  const name = (document.getElementById('cName')?.value || '').trim() || 'unnamed-lxc';
  const host = (document.getElementById('cHost')?.value || '').trim() || name;
  const userSel = document.getElementById('cUser');
  const ownerTxt = userSel?.options[userSel.selectedIndex]?.text || '—';
  const nodeSel = document.getElementById('cNode');
  const nodeTxt = nodeSel?.options[nodeSel.selectedIndex]?.text || 'localhost';
  const tplSlug = document.getElementById('cTpl')?.value || '';
  const tplObj = __lxcCatalog.find(t => t.slug === tplSlug);

  const cpu = Math.max(1, Number(document.getElementById('cCpu')?.value || 2));
  const cpuLim = Number(document.getElementById('cCpuLimit')?.value || 100);
  const ram = Math.max(128, Number(document.getElementById('cRam')?.value || 2048));
  const swap = Math.max(0, Number(document.getElementById('cSwap')?.value || 0));
  const disk = Math.max(2, Number(document.getElementById('cDisk')?.value || 20));
  const backing = document.getElementById('cBacking')?.value || 'dir';
  const bridge = (document.getElementById('cBridge')?.value || 'lxcbr0').trim();
  const staticIp = (document.getElementById('cIp')?.value || '').trim();
  const exp = Math.max(0, Number(document.getElementById('cExp')?.value || 0));
  const customPw = (document.getElementById('cRootPw')?.value || '').trim();
  const sshRaw = (document.getElementById('cSshKeys')?.value || '').trim();
  const sshCount = sshRaw ? sshRaw.split('\n').map(s => s.trim()).filter(Boolean).length : 0;

  const cpuBadge = document.getElementById('cCpuBadge');
  if (cpuBadge) cpuBadge.textContent = cpu + (cpu === 1 ? ' Core' : ' Cores');
  const ramBadge = document.getElementById('cRamBadge');
  if (ramBadge) ramBadge.textContent = ram >= 1024 ? (Math.round((ram / 1024) * 100) / 100) + ' GB' : ram + ' MB';
  const swapBadge = document.getElementById('cSwapBadge');
  if (swapBadge) swapBadge.textContent = swap === 0 ? 'Disabled' : (swap >= 1024 ? (Math.round((swap / 1024) * 100) / 100) + ' GB' : swap + ' MB');
  const diskBadge = document.getElementById('cDiskBadge');
  if (diskBadge) diskBadge.textContent = disk + ' GB';

  const setTxt = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };
  setTxt('bpTitle', name);
  setTxt('bpHost', host);
  setTxt('bpOwner', ownerTxt);
  setTxt('bpNode', nodeTxt);
  setTxt('bpOs', tplObj ? (tplObj.name || tplObj.slug) : tplSlug);
  setTxt('bpCpu', cpu + ' vCPU (' + cpuLim + '% cap)');
  setTxt('bpRam', ram + ' MB / ' + (swap ? swap + ' MB swap' : 'No swap'));
  setTxt('bpDisk', disk + ' GB (' + backing + ')');
  setTxt('bpNet', bridge + ' • ' + (__lxcIpMode === 'static' && staticIp ? staticIp : 'DHCP'));
  setTxt('bpAuth', (customPw ? 'Custom Pw' : 'Auto 18-char Pw') + (sshCount ? ' + ' + sshCount + ' SSH key' + (sshCount > 1 ? 's' : '') : ''));

  const flags = [];
  if (document.getElementById('cNest')?.checked) flags.push('Nesting');
  if (document.getElementById('cKvmNest')?.checked) flags.push('KVM (/dev/kvm)');
  if (document.getElementById('cAutostart')?.checked) flags.push('Autostart');
  if (document.getElementById('cPriv')?.checked) flags.push('Privileged');
  if (!document.getElementById('cProv')?.checked) flags.push('DB-Only');
  setTxt('bpFlags', flags.length ? flags.join(', ') : 'Standard');
  setTxt('bpExp', exp > 0 ? exp + ' days (auto-suspend)' : 'Never expires');
}

async function submitCreateLxc(e) {
  e.preventDefault();
  if (__lxcCreating) {
    hkvmToast('Provisioning is already in progress — please wait for the OS image download to finish.', 'warning');
    return;
  }

  const ctName = document.getElementById('cName').value.trim();
  const tplSlug = document.getElementById('cTpl').value;
  const provOnHost = document.getElementById('cProv').checked;
  const btn = document.getElementById('cSubmitBtn');
  const box = document.getElementById('createResultBox');

  const sshKeys = (document.getElementById('cSshKeys')?.value || '')
    .split('\n')
    .map(s => s.trim())
    .filter(Boolean);
  const customRootPw = (document.getElementById('cRootPw')?.value || '').trim();
  const staticIpVal = __lxcIpMode === 'static' ? (document.getElementById('cIp')?.value || '').trim() : '';
  const gwVal = __lxcIpMode === 'static' ? (document.getElementById('cGateway')?.value || '').trim() : '';
  const ipv6Val = __lxcIpMode === 'static' ? (document.getElementById('cIpv6')?.value || '').trim() : '';
  const vlanVal = __lxcIpMode === 'static' ? Number(document.getElementById('cVlan')?.value || 0) : 0;

  __lxcCreating = true;
  let elapsedSec = 0;
  let timerId = null;

  if (btn) {
    btn.disabled = true;
    btn.innerHTML = provOnHost
      ? '<span>Provisioning Container... (0s)</span>'
      : '<span>Registering Container...</span>';
  }

  const renderProgress = (sec) => {
    const phase = sec < 4
      ? 'Validating parameters &amp; preparing LXC store...'
      : sec < 25
      ? 'Downloading &amp; extracting OS rootfs from images.linuxcontainers.org...'
      : 'Applying cgroup limits, root credentials &amp; starting container...';
    box.style.display = 'block';
    box.innerHTML =
      '<div style="font-family:sans-serif;">' +
      '<div style="display:flex;justify-content:space-between;align-items:center;font-size:12.5px;font-weight:700;color:#22d3ee;">' +
      '<span>Deploying ' + hkvmEsc(ctName) + ' (' + hkvmEsc(tplSlug) + ')</span>' +
      '<span>' + sec + 's</span></div>' +
      '<div class="lxc-prog-track"><div class="lxc-prog-bar"></div></div>' +
      '<div style="font-size:11.5px;color:var(--text-secondary);">' + phase + '</div>' +
      '<div style="font-size:11px;color:var(--text-muted);margin-top:4px;">First-time OS template downloads take ~20–90s; cached templates finish in ~3s.</div>' +
      '</div>';
  };

  if (provOnHost) {
    renderProgress(0);
    hkvmToast('Provisioning "' + ctName + '" — downloading OS image, please wait...', 'warning');
    timerId = setInterval(() => {
      elapsedSec += 1;
      if (btn) btn.innerHTML = '<span>Provisioning Container... (' + elapsedSec + 's)</span>';
      renderProgress(elapsedSec);
    }, 1000);
  } else {
    box.style.display = 'block';
    box.textContent = 'Registering LXC container "' + ctName + '" in database...';
  }

  try {
    const out = await hkvmApi('/api/v1/lxc', {
      method: 'POST',
      body: {
        containerName: ctName,
        hostname: (document.getElementById('cHost')?.value || '').trim() || undefined,
        userId: Number(document.getElementById('cUser').value),
        nodeId: Number(document.getElementById('cNode').value),
        templateSlug: tplSlug,
        cpuCores: Number(document.getElementById('cCpu').value),
        cpuLimitPercent: Number(document.getElementById('cCpuLimit')?.value || 100),
        cpuShares: Number(document.getElementById('cCpuShares')?.value || 1024),
        cpuPinning: (document.getElementById('cCpuPin')?.value || '').trim() || null,
        ramMb: Number(document.getElementById('cRam').value),
        swapMb: Number(document.getElementById('cSwap').value),
        diskGb: Number(document.getElementById('cDisk').value),
        backingStore: document.getElementById('cBacking')?.value || 'dir',
        bandwidthQuotaGb: Number(document.getElementById('cBwQuota')?.value || 0),
        bridge: document.getElementById('cBridge').value,
        ipv4Address: staticIpVal || null,
        ipv4Gateway: gwVal || null,
        ipv6Address: ipv6Val || null,
        vlanId: vlanVal > 0 ? vlanVal : null,
        expirationDays: Number(document.getElementById('cExp').value || 0),
        rootPassword: customRootPw || undefined,
        sshPublicKeys: sshKeys,
        nesting: document.getElementById('cNest').checked,
        kvmNesting: Boolean(document.getElementById('cKvmNest')?.checked),
        autostart: Boolean(document.getElementById('cAutostart')?.checked),
        privileged: document.getElementById('cPriv') ? document.getElementById('cPriv').checked : true,
        notes: (document.getElementById('cNotes')?.value || '').trim() || undefined,
        provisionOnHost: provOnHost
      }
    });
    window.__lastCreatedLxcPw = out.generatedRootPassword;
    const stPillClass = out.instance.status === 'running' ? 'running' : 'stopped';
    box.style.display = 'block';
    box.innerHTML =
      '<div style="font-family:sans-serif;display:flex;flex-direction:column;gap:8px;">' +
      '<div style="display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;">' +
      '<strong style="color:#10b981;font-size:13px;">&#10003; Created ' + hkvmEsc(out.instance.name) + ' (#' + out.instance.refId + ')</strong>' +
      '<span class="v3-pill ' + stPillClass + '">' + hkvmEsc(out.instance.status) + '</span>' +
      '</div>' +
      '<div style="padding:8px 10px;border-radius:7px;background:rgba(0,0,0,0.35);border:1px solid var(--border-subtle);display:flex;align-items:center;justify-content:space-between;gap:8px;">' +
      '<div style="overflow:hidden;text-overflow:ellipsis;"><div style="font-size:10.5px;color:var(--text-muted);">Root Password (encrypted at rest)</div>' +
      '<code style="font-size:12.5px;color:#22d3ee;">' + hkvmEsc(out.generatedRootPassword) + '</code></div>' +
      '<button type="button" class="btn btn-outline" style="padding:4px 9px;font-size:11px;flex-shrink:0;" onclick="copyCreatedLxcPw()">Copy</button>' +
      '</div>' +
      (out.warning ? '<div style="font-size:11.5px;color:#f59e0b;line-height:1.4;">Note: ' + hkvmEsc(out.warning) + '</div>' : '') +
      '<div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:2px;">' +
      '<a class="btn btn-primary" style="flex:1;text-align:center;font-size:12px;padding:7px 10px;" href="/lxc/' + out.instance.refId + '">Manage &rarr;</a>' +
      '<a class="btn btn-outline" style="font-size:12px;padding:7px 10px;" href="/lxc/' + out.instance.refId + '/console">PTY Console</a>' +
      '<a class="btn btn-outline" style="font-size:12px;padding:7px 10px;" href="/admin/lxc">All LXC</a>' +
      '</div>' +
      '</div>';
    hkvmToast('LXC instance "' + out.instance.name + '" deployed!');
  } catch (err) {
    box.style.display = 'block';
    box.innerHTML =
      '<div style="font-family:sans-serif;color:#ef4444;font-size:12.5px;line-height:1.45;">' +
      '<strong>Provisioning Error:</strong> ' + hkvmEsc(err.message) + '</div>';
    hkvmToast(err.message, 'error');
  } finally {
    if (timerId) clearInterval(timerId);
    __lxcCreating = false;
    if (btn) {
      btn.disabled = false;
      btn.innerHTML =
        '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>' +
        '<span>Deploy LXC Container</span>';
    }
  }
}

