      method: 'POST',
      body: {
        lxcId: Number(lxcId),
        targetNodeId: Number(document.getElementById('migTargetNode').value),
        targetBridge: document.getElementById('migBridge').value,
        targetIpv4: document.getElementById('migIp').value || undefined
      }
    });
    hkvmToast('Offline migration completed & verified');
    loadMigrations();
  } catch (err) { hkvmToast(err.message, 'error'); loadMigrations(); }
}

async function loadMonitoring() {
  const nodeId = document.getElementById('monNodeSelect').value;
  const [mData, aData] = await Promise.all([
    hkvmApi('/api/v1/nodes/' + nodeId + '/metrics?hours=24'),
    hkvmApi('/api/v1/monitoring/alerts')
  ]);
  const rows = mData.history.slice(-15).reverse();
  document.getElementById('monMetricsBox').innerHTML = rows.length
    ? `<table class="v3-table"><thead><tr><th>Recorded At</th><th>CPU %</th><th>Load (1m)</th><th>RAM Used</th><th>Disk Used</th></tr></thead><tbody>` +
      rows.map(r => `<tr><td>${hkvmEsc(r.recorded_at)}</td><td>${r.cpu_percent}%</td><td>${r.load_avg_1}</td><td>${r.ram_used_mb} / ${r.ram_total_mb} MB</td><td>${r.disk_used_gb} / ${r.disk_total_gb} GB</td></tr>`).join('') +
      `</tbody></table>`
    : '<p style="color:var(--text-muted);font-size:13px;">Click "Collect Live Sample Now" to record an immediate telemetry sample.</p>';

  document.getElementById('alertsBody').innerHTML = aData.rules.map(a => `<tr>
    <td><strong>${hkvmEsc(a.name)}</strong></td><td>${hkvmEsc(a.metric)}</td>
    <td>${hkvmEsc(a.operator)} ${a.threshold}%</td><td><span class="v3-pill warning">${hkvmEsc(a.severity)}</span></td>
    <td>${hkvmEsc(a.last_triggered_at || 'Never')}</td>
    <td><button class="btn btn-outline" onclick="delAlert(${a.id})">Delete</button></td>
  </tr>`).join('');
}

async function pollNodeNow() {
  const nodeId = document.getElementById('monNodeSelect').value;
  await hkvmApi('/api/v1/nodes/' + nodeId + '/check', { method: 'POST' });
  hkvmToast('Live sample collected');
  loadMonitoring();
}

async function submitAlertRule(e) {
  e.preventDefault();
  await hkvmApi('/api/v1/monitoring/alerts', {
    method: 'POST',
    body: {
      name: document.getElementById('alName').value,
      metric: document.getElementById('alMetric').value,
      threshold: Number(document.getElementById('alThresh').value),
      severity: document.getElementById('alSev').value
    }
  });
  loadMonitoring();
}

async function delAlert(id) {
  await hkvmApi('/api/v1/monitoring/alerts/' + id, { method: 'DELETE' });
  loadMonitoring();
}

async function loadApiKeysAndWebhooks() {
  const [kData, wData] = await Promise.all([
    hkvmApi('/api/v1/api-keys?all=1'),
    hkvmApi('/api/v1/webhooks')
  ]);
  document.getElementById('akBody').innerHTML = kData.apiKeys.map(k => `<tr>
    <td><code>${hkvmEsc(k.key_prefix)}...</code></td><td><strong>${hkvmEsc(k.name)}</strong></td>
    <td><code>${hkvmEsc(k.permissions)}</code></td><td>${hkvmEsc(k.last_used_at || 'Never')}</td>
    <td>${hkvmEsc(k.created_at)}</td><td><button class="btn btn-outline" onclick="delApiKey(${k.id})">Revoke</button></td>
  </tr>`).join('');
  document.getElementById('whBody').innerHTML = wData.webhooks.map(w => `<tr>
    <td><strong>${hkvmEsc(w.name)}</strong></td><td><code>${hkvmEsc(w.url)}</code></td>
    <td><code>${hkvmEsc(w.events)}</code></td><td>${w.last_status_code || '-'}</td>
    <td><button class="btn btn-outline" onclick="delWebhook(${w.id})">Delete</button></td>
  </tr>`).join('');
}

async function submitApiKey(e) {
  e.preventDefault();
  const out = await hkvmApi('/api/v1/api-keys', {
    method: 'POST',
    body: {
      name: document.getElementById('akName').value,
      permissions: document.getElementById('akScope').value.split(','),
      description: document.getElementById('akDesc').value
    }
  });
  const box = document.getElementById('akOnceBox');
  box.style.display = 'block';
  box.textContent = 'API Key Created (copy now — stored as SHA-256 hash only):\nBearer ' + out.rawApiKey;
  loadApiKeysAndWebhooks();
}

async function delApiKey(id) {
  await hkvmApi('/api/v1/api-keys/' + id, { method: 'DELETE' });
  loadApiKeysAndWebhooks();
}

async function submitWebhook(e) {
  e.preventDefault();
  const out = await hkvmApi('/api/v1/webhooks', {
    method: 'POST',
    body: { name: document.getElementById('whName').value, url: document.getElementById('whUrl').value }
  });
  hkvmToast('Webhook registered (HMAC Secret: ' + out.signingSecret.slice(0, 10) + '...)');
  loadApiKeysAndWebhooks();
}

async function delWebhook(id) {
  await hkvmApi('/api/v1/webhooks/' + id, { method: 'DELETE' });
  loadApiKeysAndWebhooks();
}

async function loadAuditLogs() {
  const data = await hkvmApi('/api/v1/audit-logs?limit=150');
  document.getElementById('auditBody').innerHTML = data.logs.map(l => `<tr>
    <td>#${l.id}</td><td>${hkvmEsc(l.created_at)}</td><td>${hkvmEsc(l.username || 'System')}</td>
    <td><code>${hkvmEsc(l.action)}</code></td><td>${hkvmEsc((l.resource_type || '') + ' ' + (l.resource_id || ''))}</td>
    <td><code style="font-size:11px;">${hkvmEsc((l.details || '').slice(0, 120))}</code></td>
  </tr>`).join('');
}

async function runDiag(preset) {
  const nodeId = document.getElementById('diagNode').value;
  const outEl = document.getElementById('diagOutput');
  outEl.textContent = 'Running ' + preset + '...';
  try {
    const res = await hkvmApi('/api/v1/nodes/' + nodeId + '/diagnostics/' + preset, { method: 'POST' });
    outEl.textContent = `[${res.executedAt}] ${res.description} (exit=${res.exitCode})\n\n${res.output}`;
  } catch (err) { outEl.textContent = 'Error: ' + err.message; }
}

function connectNodeShell() {
  const box = document.getElementById('nodeXtermBox');
  box.innerHTML = '';
  const term = new Terminal({ cursorBlink: true, fontSize: 13, theme: { background: '#08080d' } });
  const fitAddon = new FitAddon.FitAddon();
  term.loadAddon(fitAddon);
  term.open(box);
  fitAddon.fit();
  const nodeId = document.getElementById('diagNode').value;
  const proto = location.protocol === 'https:' ? 'wss:' : 'ws:';
  const ws = new WebSocket(`${proto}//${location.host}/ws/nodes/${nodeId}/shell?cols=${term.cols}&rows=${term.rows}`);
  ws.onmessage = (ev) => {
    try {
      const m = JSON.parse(ev.data);
      if (m.type === 'output') term.write(m.data);
      if (m.type === 'error') term.writeln('\r\n\x1b[31m' + m.message + '\x1b[0m');
    } catch { term.write(ev.data); }
  };
  term.onData(d => ws.readyState === 1 && ws.send(JSON.stringify({ type: 'input', data: d })));
}

document.addEventListener('DOMContentLoaded', async () => {
  if (CURRENT_SECTION === 'instances') loadUnifiedInstances();
  if (CURRENT_SECTION === 'instances-create') initLxcCreateStudio();
  if (CURRENT_SECTION === 'lxc') loadLxcList();
  if (CURRENT_SECTION === 'nodes') loadNodes();
  if (CURRENT_SECTION === 'storage') loadStorage(true);
  if (CURRENT_SECTION === 'isos') loadIsos();
  if (CURRENT_SECTION === 'lxc-templates') loadLxcTemplates();
  if (CURRENT_SECTION === 'networking') loadNetworking();
  if (CURRENT_SECTION === 'ports') loadPorts();
  if (CURRENT_SECTION === 'firewall') loadFirewall();
  if (CURRENT_SECTION === 'snapshots') { await populateInstanceDropdown('snapInstSelect'); loadAdminSnapshots(); }
  if (CURRENT_SECTION === 'backups') { await populateInstanceDropdown('bkpInstSelect'); loadBackups(); }
  if (CURRENT_SECTION === 'migrations') { await populateInstanceDropdown('migLxcSelect', 'lxc'); loadMigrations(); }
  if (CURRENT_SECTION === 'monitoring') loadMonitoring();
  if (CURRENT_SECTION === 'api-keys') loadApiKeysAndWebhooks();
  if (CURRENT_SECTION === 'audit-logs') loadAuditLogs();
});
</script>
