function pinProbedSelfSignedCert() {
  if (!__lastProbedTlsPem) return;
  __pendingPinnedTlsPem = __lastProbedTlsPem;
  const sslEl = document.getElementById('nVerifySsl');
  if (sslEl) sslEl.checked = true;
  const banner = document.getElementById('nodeProbeBanner');
  if (banner) {
    banner.style.border = '1px solid rgba(16,185,129,0.45)';
    banner.style.background = 'rgba(16,185,129,0.1)';
    banner.innerHTML = '<strong style="color:#34d399;">&#10003; Self-signed Node Agent X.509 certificate pinned!</strong> Click <strong>Register Node</strong> below to save with cryptographic TLS certificate pinning.';
  }
  hkvmToast('Node X.509 TLS certificate pinned for registration');
}

function useUnverifiedSelfSignedTls() {
  __pendingPinnedTlsPem = null;
  const sslEl = document.getElementById('nVerifySsl');
  if (sslEl) { sslEl.checked = false; sslEl.dataset.touched = '1'; }
  testNewNodeConnection();
}

async function testNewNodeConnection() {
  const urlVal = (document.getElementById('nUrl')?.value || '').trim();
  const verifySsl = document.getElementById('nVerifySsl') ? document.getElementById('nVerifySsl').checked : true;
  const banner = document.getElementById('nodeProbeBanner');
  const btn = document.getElementById('testNodeConnBtn');
  if (!urlVal) {
    hkvmToast('Enter the Agent Endpoint URL first', 'warning');
    return;
  }
  if (btn) { btn.disabled = true; btn.textContent = 'Probing...'; }
  try {
    const res = await hkvmApi('/api/v1/nodes/test-connection', {
      method: 'POST',
      body: { url: urlVal, verifySsl }
    });
    if (res.url && document.getElementById('nUrl')) {
      document.getElementById('nUrl').value = res.url;
    }
    __lastProbedTlsPem = res.tls?.certPem || null;
    if (banner) {
      banner.style.display = 'block';
      if (res.reachable) {
        banner.style.border = '1px solid rgba(16,185,129,0.4)';
        banner.style.background = 'rgba(16,185,129,0.08)';
        const tlsExtra = res.tls
          ? ` &bull; TLS: <code>${hkvmEsc(res.tls.protocol || 'TLS')}</code> (CN: ${hkvmEsc(res.tls.subjectCN || 'n/a')}, ${res.tls.authorized ? 'CA-verified' : 'self-signed'})`
          : '';
        const skewExtra = typeof res.clockSkewSec === 'number' ? ` &bull; Clock drift: <code>${res.clockSkewSec}s</code>` : '';
        const pinAction = (res.tls && !res.tls.authorized && res.tls.certPem)
          ? ` <button type="button" class="st-copy-mini" style="margin-left:8px;" onclick="pinProbedSelfSignedCert()">Pin TLS Cert</button>`
          : '';
        banner.innerHTML = `<strong style="color:#34d399;">&#10003; ${hkvmEsc(res.message)}</strong>${tlsExtra}${skewExtra}${pinAction}`;
      } else if (res.selfSignedAgentDetected && res.tls?.certPem) {
        banner.style.border = '1px solid rgba(245,158,11,0.45)';
        banner.style.background = 'rgba(245,158,11,0.09)';
        const fpShort = res.tls.fingerprintSha256 ? res.tls.fingerprintSha256.slice(0, 16) + '...' : 'self-signed';
        banner.innerHTML = `<div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;">
          <div><strong style="color:#fbbf24;">&#9888; ${hkvmEsc(res.message)}</strong><div style="font-size:11.5px;color:var(--text-muted);margin-top:3px;">Cert CN: <code>${hkvmEsc(res.tls.subjectCN || 'n/a')}</code> &bull; SHA-256: <code>${hkvmEsc(fpShort)}</code></div></div>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <button type="button" class="btn btn-primary" style="font-size:12px;padding:6px 12px;" onclick="pinProbedSelfSignedCert()">Pin &amp; Trust Self-Signed Cert</button>
            <button type="button" class="btn btn-outline" style="font-size:12px;padding:6px 10px;" onclick="useUnverifiedSelfSignedTls()">Skip Strict Verify</button>
          </div>
        </div>`;
      } else {
        banner.style.border = '1px solid rgba(239,68,68,0.4)';
        banner.style.background = 'rgba(239,68,68,0.08)';
        banner.innerHTML = `<strong style="color:#f87171;">&#10005; ${hkvmEsc(res.message)}</strong>`;
      }
    }
  } catch (err) {
    hkvmToast(err.message, 'error');
  } finally {
    if (btn) { btn.disabled = false; btn.textContent = 'Test Reachability'; }
  }
}

async function loadNodes() {
  const data = await hkvmApi('/api/v1/nodes');
  __cachedNodes = data.nodes || [];

  const total = __cachedNodes.length;
  const online = __cachedNodes.filter(n => n.status === 'online').length;
  const cordoned = __cachedNodes.filter(n => n.maintenance_mode).length;
  const localCnt = __cachedNodes.filter(n => n.is_local).length;
  const remoteCnt = total - localCnt;
  const totalCores = __cachedNodes.reduce((s, n) => s + Number(n.cpu_cores || 0), 0);
  const allocCores = __cachedNodes.reduce((s, n) => s + Number(n.allocated_vcpus || 0), 0);
  const totalInst = __cachedNodes.reduce((s, n) => s + Number(n.total_instances || 0), 0);
  const runInst = __cachedNodes.reduce((s, n) => s + Number(n.running_instances || 0), 0);
  const totalRamMb = __cachedNodes.reduce((s, n) => s + Number(n.ram_total_mb || 0), 0);
  const allocRamMb = __cachedNodes.reduce((s, n) => s + Number(n.allocated_ram_mb || 0), 0);
  const kvmReady = __cachedNodes.filter(n => n.kvm_available).length;
  const lxcReady = __cachedNodes.filter(n => n.lxc_available).length;
  const openCircuits = __cachedNodes.filter(n => n.circuit_state === 'open').length;
  const latSamples = __cachedNodes.map(n => n.latency_ms).filter(v => typeof v === 'number' && v > 0);
  const avgLat = latSamples.length ? Math.round(latSamples.reduce((a, b) => a + b, 0) / latSamples.length) : null;

  const setTxt = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
  setTxt('nkTotalVal', online + ' / ' + total + ' Online');
  setTxt('nkTotalSub', localCnt + ' local • ' + remoteCnt + ' remote' + (cordoned ? ' • ' + cordoned + ' cordoned' : ''));
  const pill = document.getElementById('nkOnlinePill');
  if (pill) {
    pill.className = 'st-tag ' + (online === total && total > 0 ? 'emerald' : (online > 0 ? 'amber' : 'red'));
    pill.textContent = cordoned > 0 ? (cordoned + ' Maint') : (online === total && total > 0 ? 'All Healthy' : (total - online) + ' Degraded');
  }

  setTxt('nkCoresVal', totalCores + ' Cores • ' + totalInst + ' Guests');
  setTxt('nkCpuModelSub', runInst + ' running • ' + allocCores + ' vCPU provisioned');

  const ramPct = totalRamMb > 0 ? Math.min(100, (allocRamMb / totalRamMb) * 100) : 0;
  setTxt('nkRamVal', fmtMbAsGb(totalRamMb));
  setTxt('nkStorageSub', fmtMbAsGb(allocRamMb) + ' provisioned (' + ramPct.toFixed(0) + '%)');
  const rBar = document.getElementById('nkRamAllocBar');
  if (rBar) {
    rBar.style.width = ramPct.toFixed(1) + '%';
    rBar.className = 'st-bar-fill ' + barToneClass(ramPct);
  }

  setTxt('nkEnginesVal', 'KVM ' + kvmReady + ' • LXC ' + lxcReady);
  setTxt('nkCircuitSub', (openCircuits === 0 ? 'Circuits closed' : openCircuits + ' circuit open') + (avgLat ? ' • ~' + avgLat + 'ms RTT' : ''));

  renderNodeTagFilters();
  renderNodesView();
}

function getFilteredNodesList() {
  const q = (document.getElementById('nodeSearchInput')?.value || '').trim().toLowerCase();
  return __cachedNodes.filter(n => {
    if (__nodeStatusFilter === 'online' && (n.status !== 'online' || n.maintenance_mode)) return false;
    if (__nodeStatusFilter === 'maintenance' && !n.maintenance_mode) return false;
    if (__nodeStatusFilter === 'offline' && n.status === 'online') return false;
    const tags = parseNodeTags(n.tags);
    if (__nodeTagFilter && !tags.includes(__nodeTagFilter)) return false;
    if (q) {
      const hay = [n.name, n.hostname, n.ip_address, n.location, n.url, n.cpu_model, n.notes, ...tags].join(' ').toLowerCase();
      if (!hay.includes(q)) return false;
    }
    return true;
  });
}

