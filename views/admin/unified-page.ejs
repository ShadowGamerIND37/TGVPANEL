        </div>
      </div>
      <div class="v3-card v3-table-wrap">
        <table class="v3-table">
          <thead><tr><th>ID</th><th>Type</th><th>Backup Name</th><th>Node</th><th>Size</th><th>SHA-256 Checksum</th><th>Created</th><th>Actions</th></tr></thead>
          <tbody id="backupsBody"></tbody>
        </table>
      </div>
