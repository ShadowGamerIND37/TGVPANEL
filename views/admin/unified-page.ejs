let __pendingPinnedTlsPem = null;
let __lastProbedTlsPem = null;
let __activePairNodeId = null;

function autoFillAgentUrl() {
  const ip = (document.getElementById('nIp')?.value || '').trim();
  const hostVal = (document.getElementById('nHost')?.value || '').trim();
  const urlEl = document.getElementById('nUrl');
  const hostEl = document.getElementById('nHost');
  const sslEl = document.getElementById('nVerifySsl');
  const isIpv4 = /^(?:\d{1,3}\.){3}\d{1,3}$/.test(ip);
  const isDomain = hostVal && hostVal.includes('.') && !/^(?:\d{1,3}\.){3}\d{1,3}$/.test(hostVal) && !hostVal.includes(':');
  if (ip && hostEl && !hostEl.dataset.touched) {
    hostEl.value = ip;
  }
  if (ip && urlEl && !urlEl.dataset.touched) {
    if (ip.includes('.') && !isIpv4 && !ip.includes(':')) {
      // User pasted a Cloudflare Tunnel / domain into IP box
      urlEl.value = 'https://' + ip.replace(/^https?:\/\//i, '').replace(/\/+$/, '');
      if (sslEl && !sslEl.dataset.touched) sslEl.checked = true;
    } else {
      const bracketIp = ip.includes(':') && !ip.startsWith('[') ? '[' + ip + ']' : ip;
      urlEl.value = 'https://' + bracketIp + ':8443';
      if (sslEl && !sslEl.dataset.touched && !__pendingPinnedTlsPem && (isIpv4 || ip.includes(':'))) {
        sslEl.checked = false;
      }
    }
  } else if (!ip && isDomain && urlEl && !urlEl.dataset.touched) {
    // Domain-only / Cloudflare Tunnel node with no IPv4 IP
    urlEl.value = 'https://' + hostVal.replace(/^https?:\/\//i, '').replace(/\/+$/, '');
    if (sslEl && !sslEl.dataset.touched) {
      sslEl.checked = true;
    }
  }
}

function autoFillFromAgentUrl() {
  const rawUrl = (document.getElementById('nUrl')?.value || '').trim();
  const hostEl = document.getElementById('nHost');
  const sslEl = document.getElementById('nVerifySsl');
  if (!rawUrl) return;
  try {
    const withProto = /^https?:\/\//i.test(rawUrl) ? rawUrl : 'https://' + rawUrl;
    const parsed = new URL(withProto);
    const cleanHost = (parsed.hostname || '').replace(/^\[|\]$/g, '');
    if (cleanHost && hostEl && !hostEl.dataset.touched) {
      hostEl.value = cleanHost;
    }
    const isDomain = cleanHost.includes('.') && !/^(?:\d{1,3}\.){3}\d{1,3}$/.test(cleanHost) && !cleanHost.includes(':');
    if (isDomain && parsed.protocol === 'https:' && !parsed.port && sslEl && !sslEl.dataset.touched) {
      sslEl.checked = true;
    }
  } catch (_err) {
    // Ignore partial URL while user is still typing
  }
}

