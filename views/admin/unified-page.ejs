  document.getElementById('monMetricsBox').innerHTML = rows.length
    ? `<table class="v3-table"><thead><tr><th>Recorded At</th><th>CPU %</th><th>Load (1m)</th><th>RAM Used</th><th>Disk Used</th></tr></thead><tbody>` +
      rows.map(r => `<tr><td>${hkvmEsc(r.recorded_at)}</td><td>${r.cpu_percent}%</td><td>${r.load_avg_1}</td><td>${r.ram_used_mb} / ${r.ram_total_mb} MB</td><td>${r.disk_used_gb} / ${r.disk_total_gb} GB</td></tr>`).join('') +
      `</tbody></table>`
    : '<p style="color:var(--text-muted);font-size:13px;">Click "Collect Live Sample Now" to record an immediate telemetry sample.</p>';

  document.getElementById('alertsBody').innerHTML = aData.rules.map(a => `<tr>
    <td><strong>${hkvmEsc(a.name)}</strong></td><td>${hkvmEsc(a.metric)}</td>
    <td>${hkvmEsc(a.operator)} ${a.threshold}%</td><td><span class="v3-pill warning">${hkvmEsc(a.severity)}</span></td>
    <td>${hkvmEsc(a.last_triggered_at || 'Never')}</td>
