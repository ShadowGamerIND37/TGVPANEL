async function loadAdminSnapshots() {
  const val = document.getElementById('snapInstSelect').value;
  if (!val) { document.getElementById('snapsBody').innerHTML = '<tr><td colspan="5">Create an instance first.</td></tr>'; return; }
  const [engine, id] = val.split(':');
  const data = await hkvmApi('/api/v1/snapshots/' + engine + '/' + id);
  document.getElementById('snapsBody').innerHTML = data.snapshots.length
    ? data.snapshots.map(s => `<tr>
        <td>#${s.id}</td><td><strong>${hkvmEsc(s.snapshot_name)}</strong></td><td>${hkvmEsc(s.description || '')}</td><td>${hkvmEsc(s.created_at)}</td>
        <td class="v3-btn-row">
          <button class="btn btn-outline" onclick="restoreSnap('${engine}',${id},${s.id})">Restore</button>
          <button class="btn btn-outline" style="color:#ef4444;" onclick="delSnap('${engine}',${id},${s.id})">Delete</button>
        </td>
      </tr>`).join('')
    : '<tr><td colspan="5" style="color:var(--text-muted);">No snapshots for this instance.</td></tr>';
