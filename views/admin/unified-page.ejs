              ${instances.length ? instances.map(i => `<tr>
                <td><span class="st-tag ${i.engine === 'kvm' ? 'indigo' : 'cyan'}">${hkvmEsc(i.engine.toUpperCase())}</span></td>
                <td><strong>${hkvmEsc(i.name)}</strong><div style="font-size:11px;color:var(--text-muted);">${hkvmEsc(i.osLabel)}</div></td>
                <td>${i.cpuCores} vCPU &bull; ${fmtMbAsGb(i.ramMb)} &bull; ${i.diskGb} GB</td>
                <td><code>${hkvmEsc(i.ipAddress || 'DHCP')}</code></td>
                <td><span class="v3-pill ${i.status}">${hkvmEsc(i.status)}</span></td>
                <td style="text-align:right;"><a class="btn btn-outline" style="font-size:12px;padding:5px 10px;" href="${i.manageUrl}">Open &rarr;</a></td>
              </tr>`).join('') : '<tr><td colspan="6" style="text-align:center;color:var(--text-muted);padding:22px;">No KVM VMs or LXC containers assigned to this node.</td></tr>'}
            </tbody>
          </table>
        </div>
      </div>`;
    return;
  }

  if (__inspectorTab === 'settings') {
    body.innerHTML = `
      <form onsubmit="saveInspectorSettings(event)">
        <div class="v3-form-grid" style="grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px;">
          <div class="v3-field"><label>Node Name</label><input id="niEditName" required value="${hkvmEsc(n.name)}"></div>
          <div class="v3-field"><label>Datacenter / Location</label><input id="niEditLoc" value="${hkvmEsc(n.location || '')}"></div>
          <div class="v3-field"><label>Hostname / FQDN</label><input id="niEditHost" value="${hkvmEsc(n.hostname || '')}"></div>
          <div class="v3-field"><label>IPv4 Address</label><input id="niEditIp" value="${hkvmEsc(n.ip_address || '')}"></div>
          <div class="v3-field"><label>Agent Endpoint URL</label><input id="niEditUrl" value="${hkvmEsc(n.url || '')}" ${n.is_local ? 'readonly' : ''}></div>
          <div class="v3-field"><label>Max Instances Quota</label><input id="niEditMax" type="number" min="1" max="5000" value="${Number(n.max_instances || 100)}"></div>
          <div class="v3-field" style="grid-column: span 2;">
            <label>Cluster Tags (comma-separated)</label>
            <input id="niEditTags" value="${hkvmEsc((n.parsedTags || []).join(', '))}" placeholder="nvme, production, eu-fra">
          </div>
          <div class="v3-field">
            <label>Scheduling Policies</label>
            <div style="display:flex;gap:8px;flex-wrap:wrap;">
              <label class="st-switch-box" style="flex:1;"><span style="font-size:12px;font-weight:600;">Allow KVM</span><input type="checkbox" id="niEditKvm" ${Number(n.supports_kvm ?? 1) !== 0 ? 'checked' : ''}></label>
              <label class="st-switch-box" style="flex:1;"><span style="font-size:12px;font-weight:600;">Allow LXC</span><input type="checkbox" id="niEditLxc" ${Number(n.supports_lxc ?? 1) !== 0 ? 'checked' : ''}></label>
            </div>
          </div>
          <div class="v3-field">
            <label>Maintenance &amp; TLS</label>
            <div style="display:flex;gap:8px;flex-wrap:wrap;">
              <label class="st-switch-box" style="flex:1;"><span style="font-size:12px;font-weight:600;">Maintenance (Cordon)</span><input type="checkbox" id="niEditMaint" ${n.maintenance_mode ? 'checked' : ''}></label>
              <label class="st-switch-box" style="flex:1;"><span style="font-size:12px;font-weight:600;">Verify TLS</span><input type="checkbox" id="niEditSsl" ${n.verify_ssl ? 'checked' : ''}></label>
            </div>
          </div>
          <div class="v3-field" style="grid-column: span 2;">
            <label>Operator Notes</label>
            <textarea id="niEditNotes" rows="3" placeholder="Hardware rack, uplink, maintenance window notes...">${hkvmEsc(n.notes || '')}</textarea>
          </div>
        </div>
        <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:18px;padding-top:14px;border-top:1px solid var(--border-subtle);">
          <button type="submit" class="btn btn-primary">Save Node Configuration</button>
        </div>
      </form>`;
    return;
  }

  if (__inspectorTab === 'diagnostics') {
    const presets = [
      { key: 'uptime', label: 'System Uptime' },
      { key: 'uname', label: 'Kernel uname -a' },
      { key: 'memory', label: 'Memory (free -h)' },
      { key: 'disk', label: 'Disk Usage (df -hT)' },
      { key: 'network_links', label: 'Network IPs' },
      { key: 'bridges', label: 'Linux Bridges' },
      { key: 'lxc_list', label: 'LXC Containers' },
      { key: 'sysctl_net', label: 'IPv4 Forwarding' }
    ];
    body.innerHTML = `
      <div style="margin-bottom:16px;">
        <div style="font-size:12.5px;font-weight:700;color:var(--text-primary);margin-bottom:8px;">Safe Allowlisted Host Diagnostic Presets</div>
        <div class="nd-diag-grid">
          ${presets.map(p => `<button type="button" class="nd-diag-btn" onclick="runInspectorDiag('${p.key}')">&#9654; ${p.label}</button>`).join('')}
        </div>
        <div id="niDiagOut" class="v3-code" style="min-height:140px;max-height:240px;">Select a diagnostic preset above to run it live on ${hkvmEsc(n.name)}...</div>
      </div>

      <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:14px 16px;border-radius:11px;border:1px solid var(--border-subtle);background:rgba(255,255,255,0.02);">
        <div>
          <strong style="font-size:13px;color:var(--text-primary);">Circuit Breaker, TLS Pinning &amp; HMAC Pairing Controls</strong>
          <div style="font-size:11.5px;color:var(--text-muted);margin-top:2px;">Circuit state: <strong>${hkvmEsc(n.circuit_state || 'closed')}</strong> (${Number(n.consecutive_failures || 0)} consecutive errors)${n.tls_pinned ? ' &bull; <span style="color:#34d399;">TLS X.509 Pinned</span>' : ''}</div>
        </div>
        <div class="v3-btn-row">
          <button type="button" class="btn btn-outline" onclick="resetNodeCircuit(${n.id})">Reset Circuit &amp; Probe</button>
          ${(!n.is_local && String(n.url || '').startsWith('https://')) ? `<button type="button" class="btn btn-outline" onclick="trustNodeTls(${n.id})">Pin TLS Cert</button>` : ''}
          ${!n.is_local ? `<button type="button" class="btn btn-outline" onclick="closeNodeInspector();openNodePairDrawer(${n.id});">Pair / .env</button>` : ''}
          <button type="button" class="btn btn-outline" onclick="rotateNode(${n.id})">Rotate HMAC Keys</button>
          <a href="/admin/node-console" class="btn btn-outline">Open Interactive Shell &rarr;</a>
        </div>
      </div>`;
  }
}

async function saveInspectorSettings(e) {
  e.preventDefault();
  if (!__inspectorNodeId) return;
  try {
    await hkvmApi('/api/v1/nodes/' + __inspectorNodeId, {
      method: 'PATCH',
      body: {
        name: document.getElementById('niEditName').value.trim(),
        location: document.getElementById('niEditLoc').value.trim(),
        hostname: document.getElementById('niEditHost').value.trim(),
        ipAddress: document.getElementById('niEditIp').value.trim(),
        url: document.getElementById('niEditUrl').value.trim(),
        maxInstances: Number(document.getElementById('niEditMax').value || 100),
        tags: document.getElementById('niEditTags').value,
        supportsKvm: document.getElementById('niEditKvm').checked,
        supportsLxc: document.getElementById('niEditLxc').checked,
        maintenanceMode: document.getElementById('niEditMaint').checked,
        verifySsl: document.getElementById('niEditSsl').checked,
        notes: document.getElementById('niEditNotes').value
      }
    });
    hkvmToast('Node configuration saved');
    await reloadInspectorNode();
  } catch (err) {
    hkvmToast(err.message, 'error');
  }
}

async function runInspectorDiag(preset) {
  if (!__inspectorNodeId) return;
  const out = document.getElementById('niDiagOut');
  if (out) out.textContent = 'Running "' + preset + '" on node #' + __inspectorNodeId + '...';
  try {
    const res = await hkvmApi('/api/v1/nodes/' + __inspectorNodeId + '/diagnostics/' + encodeURIComponent(preset), { method: 'POST' });
    if (out) {
      out.textContent = '$ ' + (res.command || preset) + '  (' + (res.durationMs ?? 0) + 'ms, exit ' + (res.exitCode ?? 0) + ')\n\n' + (res.output || res.stdout || res.stderr || '(no output)');
    }
  } catch (err) {
    if (out) out.textContent = 'Diagnostic failed: ' + err.message;
  }
}

async function evacuateInspectorLxc() {
  if (!__inspectorNodeId) return;
  const targetNodeId = Number(document.getElementById('niEvacTarget')?.value || 0);
  const targetBridge = (document.getElementById('niEvacBridge')?.value || 'lxcbr0').trim();
  if (!targetNodeId) return;
  if (!confirm('Cordon this node and migrate all LXC containers to target node #' + targetNodeId + '?')) return;
  const btn = document.getElementById('niEvacBtn');
  const box = document.getElementById('niEvacResult');
  if (btn) { btn.disabled = true; btn.textContent = 'Evacuating LXC workloads...'; }
  try {
    const res = await hkvmApi('/api/v1/nodes/' + __inspectorNodeId + '/evacuate-lxc', {
      method: 'POST',
      body: { targetNodeId, targetBridge, cordonSource: true }
    });
    if (box) {
      box.style.display = 'block';
      box.textContent = `Evacuation complete: ${res.succeeded}/${res.attempted} succeeded\n` +
        (res.results || []).map(r => ` - ${r.name} (#${r.lxcId}): ${r.ok ? 'MIGRATED (job #' + r.jobId + ')' : 'FAILED: ' + r.error}`).join('\n');
    }
    hkvmToast(`Node evacuation finished: ${res.succeeded}/${res.attempted} migrated`);
    await reloadInspectorNode();
  } catch (err) {
    hkvmToast(err.message, 'error');
  } finally {
    if (btn) { btn.disabled = false; btn.textContent = 'Cordon & Evacuate LXC'; }
  }
}

async function refreshAllNodesHealth() {
  const btn = document.getElementById('refreshAllNodesBtn');
  if (btn) { btn.disabled = true; btn.textContent = 'Checking...'; }
  try {
    for (const n of __cachedNodes) {
      await hkvmApi('/api/v1/nodes/' + n.id + '/check', { method: 'POST' }).catch(() => null);
    }
    await loadNodes();
    hkvmToast('Cluster health & capabilities synchronized');
  } finally {
    if (btn) { btn.disabled = false; btn.textContent = 'Check All Nodes'; }
  }
}

async function submitAddNode(e) {
  e.preventDefault();
  try {
    const out = await hkvmApi('/api/v1/nodes', {
      method: 'POST',
      body: {
        name: document.getElementById('nName').value.trim(),
        hostname: document.getElementById('nHost').value.trim(),
        ipAddress: document.getElementById('nIp').value.trim(),
        url: document.getElementById('nUrl').value.trim(),
        location: document.getElementById('nLoc').value.trim(),
        maxInstances: Number(document.getElementById('nMaxInst')?.value || 100),
        tags: (document.getElementById('nTags')?.value || '').trim(),
        supportsKvm: document.getElementById('nSupKvm') ? document.getElementById('nSupKvm').checked : true,
        supportsLxc: document.getElementById('nSupLxc') ? document.getElementById('nSupLxc').checked : true,
        notes: (document.getElementById('nNotes')?.value || '').trim() || undefined,
        tlsCaPem: __pendingPinnedTlsPem || undefined,
        verifySsl: document.getElementById('nVerifySsl') ? document.getElementById('nVerifySsl').checked : true
      }
    });
    __pendingPinnedTlsPem = null;
    await loadNodes();
    await openNodePairDrawer(out.node.id, out.bootstrapCredentials);
    hkvmToast('Node "' + out.node.name + '" registered! Run the 1-Command Auto-Join below on your remote server.');
  } catch (err) { hkvmToast(err.message, 'error'); }
}

async function openNodePairDrawer(nodeId, freshCreds) {
  __activePairNodeId = nodeId;
  const wrap = document.getElementById('nodeCredsWrap');
  const box = document.getElementById('nodeCredsOutput');
  const joinSec = document.getElementById('nodeJoinTokenSection');
  const joinOut = document.getElementById('nodeJoinCmdOutput');
  const joinMeta = document.getElementById('nodeJoinExpMeta');
  const copyJoinBtn = document.getElementById('copyJoinCmdBtn');
  const titleEl = document.getElementById('nodeCredsTitle');
  const ctrlInput = document.getElementById('joinCtrlUrlInput');
  const ctrlUrl = (ctrlInput?.value || window.location.origin).trim() || window.location.origin;

  if (wrap) wrap.style.display = 'block';
  if (box) box.style.display = 'block';

  try {
    const [boot, joinRes] = await Promise.all([
      hkvmApi('/api/v1/nodes/' + nodeId + '/bootstrap?controllerUrl=' + encodeURIComponent(ctrlUrl)),
      hkvmApi('/api/v1/nodes/' + nodeId + '/join-token', {
        method: 'POST',
        body: { controllerUrl: ctrlUrl, ttlMinutes: 30 }
      })
    ]);
    if (titleEl) titleEl.textContent = 'Pair Remote Node #' + nodeId + ' (' + (boot.nodeName || '') + ')';
    if (box) box.textContent = boot.envSnippet;
    if (joinSec && joinOut) {
      joinSec.style.display = 'block';
      joinOut.textContent = joinRes.curlJoinCommand;
      if (copyJoinBtn) copyJoinBtn.style.display = 'inline-flex';
      if (joinMeta) {
        joinMeta.textContent = 'Single-use token valid for ' + joinRes.ttlMinutes + ' minutes (expires ' + new Date(joinRes.expiresAt).toLocaleTimeString() + '). Local checkout command: ' + joinRes.localJoinCommand;
      }
    }
    if (wrap) wrap.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  } catch (err) {
    if (freshCreds && box) {
      box.textContent =
        '# Remote Node Bootstrap Credentials — paste into /opt/tgvpanel/.env:\n' +
        'TGVPANEL_NODE_ID=' + nodeId + '\n' +
        'TGVPANEL_AGENT_HOST=0.0.0.0\n' +
        'TGVPANEL_AGENT_PORT=8443\n' +
        'TGVPANEL_NODE_API_KEY=' + freshCreds.apiKey + '\n' +
        'TGVPANEL_NODE_HMAC_SECRET=' + freshCreds.hmacSecret;
    } else {
      hkvmToast(err.message, 'error');
    }
  }
}

async function regenerateJoinTokenForActiveNode() {
  if (!__activePairNodeId) return;
  await openNodePairDrawer(__activePairNodeId);
  hkvmToast('Generated fresh 30-minute single-use Join Token');
}

async function trustNodeTls(nodeId) {
  try {
    const res = await hkvmApi('/api/v1/nodes/' + nodeId + '/trust-tls', { method: 'POST' });
    const fpShort = res.fingerprintSha256 ? res.fingerprintSha256.slice(0, 16) + '…' : '';
    hkvmToast('Pinned TLS certificate (' + fpShort + ')' + (res.probeOk ? ' — Node #' + nodeId + ' is ONLINE!' : ''));
    await loadNodes();
    if (__inspectorNodeId === nodeId) await reloadInspectorNode();
  } catch (err) {
    hkvmToast(err.message, 'error');
  }
}

async function syncClusterContainers(targetNodeId) {
  const btn = document.getElementById('syncClusterContainersBtn');
  if (btn) { btn.disabled = true; btn.textContent = 'Syncing...'; }
  try {
    const res = await hkvmApi('/api/v1/lxc/sync-host', {
      method: 'POST',
      body: targetNodeId ? { nodeId: targetNodeId } : {}
    });
    hkvmToast(res.count > 0 ? ('Imported ' + res.count + ' container(s): ' + (res.imported || []).join(', ')) : 'Cluster containers synchronized (0 untracked found)');
    await loadNodes();
    if (__inspectorNodeId) await reloadInspectorNode();
  } catch (err) {
    hkvmToast(err.message, 'error');
  } finally {
    if (btn) { btn.disabled = false; btn.textContent = 'Sync Containers'; }
  }
}

async function checkNode(id) {
