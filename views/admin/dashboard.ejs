<!DOCTYPE html>
<html lang="en">
<head>
  <script>(function(){try{var t=localStorage.getItem('pm.theme')||'dark';var d=document.documentElement;if(t==='light')d.classList.add('pm-theme-light');d.style.colorScheme=t==='light'?'light':'dark';}catch(e){}})();</script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#06070c">
  <title><%= title || 'Admin Dashboard · ' + siteName %></title>
  <link rel="icon" href="<%= siteLogo %>" type="image/png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/premium.css">
  <style>
    .kpi-card { padding: 18px; }
    .kpi-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
    .kpi-label { font-size: 11.5px; color: var(--pm-text-dim); display: flex; align-items: center; gap: 7px; font-weight: 500; }
    .kpi-value { font-size: 30px; font-weight: 700; letter-spacing: -0.04em; line-height: 1.05; margin-top: 10px; font-variant-numeric: tabular-nums; }
    .kpi-foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 6px; font-size: 11px; color: var(--pm-text-dim); }
    .kpi-icon { width: 34px; height: 34px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .resource-ring-row { display: flex; align-items: center; gap: 18px; padding: 4px 0 8px; }
    .resource-cell { display: flex; align-items: center; gap: 12px; flex: 1; }
    .resource-cell .label { font-size: 11.5px; color: var(--pm-text-dim); }
    .resource-cell .value { font-size: 14px; font-weight: 650; }
    .host-meta { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 8px; }
    .host-meta div { font-size: 11px; color: var(--pm-text-dim); }
    .host-meta strong { display: block; color: var(--pm-text); font-size: 12.5px; font-weight: 600; margin-top: 2px; }
    .vm-toolbar-input { max-width: 300px; }
    .vm-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 14px; }
    .vm-card-enhanced { padding: 16px; border-radius: 15px; display: flex; flex-direction: column; gap: 13px; }
    .vm-card-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
    .vm-title-block { display: flex; gap: 11px; min-width: 0; flex: 1; }
    .vm-os-icon {
      width: 38px; height: 38px; border-radius: 10px; overflow: hidden; flex-shrink: 0;
      background: rgba(148,163,184,.1); border: 1px solid var(--pm-line);
      display: flex; align-items: center; justify-content: center;
    }
    .vm-os-icon img { width: 100%; height: 100%; object-fit: cover; }
    .vm-name-enhanced { font-size: 14px; font-weight: 650; color: var(--pm-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .vm-meta-enhanced { display: flex; align-items: center; gap: 7px; flex-wrap: wrap; font-size: 11px; color: var(--pm-text-dim); margin-top: 2px; }
    .vm-id-chip { font-family: ui-monospace, monospace; font-size: 10px; padding: 1px 5px; border-radius: 5px; background: rgba(148,163,184,.12); }
    .status-badge {
      display: inline-flex; align-items: center; gap: 5px; padding: 3px 8px; border-radius: 99px;
      font-size: 10px; font-weight: 650; text-transform: capitalize; flex-shrink: 0;
      border: 1px solid var(--pm-line);
    }
    .status-badge .status-dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
    .status-badge.running { color: #34d399; background: rgba(52,211,153,.12); border-color: rgba(52,211,153,.3); }
    .status-badge.stopped { color: var(--pm-text-soft); background: rgba(148,163,184,.1); }
    .status-badge.error { color: #fb7185; background: rgba(251,113,133,.12); border-color: rgba(251,113,133,.3); }
    .vm-specs { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; }
    .spec-item { display: flex; align-items: center; gap: 8px; min-width: 0; }
    .spec-icon { width: 26px; height: 26px; border-radius: 7px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .spec-icon.mem { background: rgba(52,211,153,.12); color: #34d399; }
    .spec-icon.cpu { background: rgba(236,72,153,.12); color: #f472b6; }
    .spec-icon.disk { background: rgba(34,211,238,.12); color: #22d3ee; }
    .spec-icon.net { background: rgba(96,165,250,.12); color: #60a5fa; }
    .spec-content { min-width: 0; }
    .spec-label { font-size: 9px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--pm-text-dim); line-height: 1.2; }
    .spec-value { font-size: 11.5px; font-weight: 600; color: var(--pm-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .vm-actions-enhanced { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 7px; margin-top: auto; }
    .btn-action { display: inline-flex; align-items: center; justify-content: center; gap: 5px; padding: 7px 8px; font-size: 11.5px; }
    .empty-enhanced { grid-column: 1 / -1; padding: 46px 20px; border-radius: 16px; text-align: center; border: 1px dashed var(--pm-line-strong); background: var(--pm-surface); }
    .empty-icon-wrap { width: 50px; height: 50px; margin: 0 auto 12px; border-radius: 14px; display: flex; align-items: center; justify-content: center; color: var(--pm-brand-2); background: var(--pm-brand-gradient-soft); border: 1px solid var(--pm-brand-line); }
    .empty-title { font-size: 14px; font-weight: 650; }
    .empty-desc { font-size: 12px; color: var(--pm-text-dim); margin: 5px 0 14px; }
    .skeleton-card { height: 210px; border-radius: 15px; }
  </style>
</head>
<body>

<div class="admin-wrapper">
  <%- include('../partials/admin/sidebar') %>

  <div class="admin-main">
    <%- include('../partials/admin/header') %>

    <div class="admin-content">

      <!-- ================= HERO ================= -->
      <section class="pm-hero">
        <div class="pm-hero-inner">
          <div style="max-width:640px">
            <div class="pm-hero-eyebrow">
              <span style="width:6px;height:6px;border-radius:50%;background:var(--pm-brand-2);box-shadow:0 0 10px var(--pm-brand-2)"></span>
              Control plane
            </div>
            <h1 class="pm-hero-title" id="heroGreeting">Welcome back, <span><%= user.username %></span></h1>
            <p class="pm-hero-sub">
              Your fleet at a glance — live health, activity and every machine under one roof.
            </p>
            <div class="pm-toolbar" style="margin-top:16px">
              <span class="pm-chip brand"><span class="dot"></span><span id="heroRunning">Loading fleet…</span></span>
              <span class="pm-chip" id="heroUptime">Host —</span>
              <span class="pm-chip" id="heroSync">Sync —</span>
            </div>
          </div>
          <div class="pm-hero-actions">
            <a href="/admin/vm-create" class="btn btn-primary btn-lg">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
              New virtual machine
            </a>
            <button class="btn btn-ghost btn-lg" onclick="if(window.PM)PM.openPalette('')">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
              Search
              <span class="pm-kbd" style="margin-left:2px">⌘K</span>
            </button>
            <button class="btn btn-outline btn-lg" id="refreshBtn" onclick="loadAdminData()">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline>
                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
              </svg>
              Refresh
            </button>
          </div>
        </div>
      </section>

      <!-- ================= KPIs ================= -->
      <div class="pm-grid cols-4" style="margin-bottom:16px">
        <div class="pm-card kpi-card">
          <div class="kpi-top">
            <div>
              <div class="kpi-label">Total machines</div>
              <div class="kpi-value" id="totalVMs">—</div>
            </div>
            <span class="kpi-icon" style="background:rgba(129,140,248,.14);color:#818cf8;border:1px solid rgba(129,140,248,.25)">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="7" rx="2"></rect><rect x="2" y="13" width="20" height="7" rx="2"></rect><path d="M6 7.5h.01M6 16.5h.01"></path>
              </svg>
            </span>
          </div>
          <div class="pm-spark" id="sparkTotal"></div>
          <div class="kpi-foot"><span>Registered in panel</span><span class="pm-chip" style="font-size:10px;padding:2px 7px">all time</span></div>
        </div>

        <div class="pm-card kpi-card">
          <div class="kpi-top">
            <div>
              <div class="kpi-label">Running now</div>
              <div class="kpi-value" id="runningVMs" style="color:#34d399">—</div>
            </div>
            <span class="kpi-icon" style="background:rgba(52,211,153,.14);color:#34d399;border:1px solid rgba(52,211,153,.25)">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><polygon points="7 4 20 12 7 20 7 4"/></svg>
            </span>
          </div>
          <div class="pm-spark" id="sparkRunning"></div>
          <div class="kpi-foot"><span id="runningRatio">—</span><span class="pm-chip" style="font-size:10px;padding:2px 7px">live</span></div>
        </div>

        <div class="pm-card kpi-card">
          <div class="kpi-top">
            <div>
              <div class="kpi-label">Stopped</div>
              <div class="kpi-value" id="stoppedVMs">—</div>
            </div>
            <span class="kpi-icon" style="background:rgba(148,163,184,.12);color:var(--pm-text-soft);border:1px solid var(--pm-line)">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>
            </span>
          </div>
          <div class="pm-spark" id="sparkStopped"></div>
          <div class="kpi-foot"><span>Ready to boot</span><span class="pm-chip" style="font-size:10px;padding:2px 7px">idle</span></div>
        </div>

        <div class="pm-card kpi-card">
          <div class="kpi-top">
            <div>
              <div class="kpi-label">Team members</div>
              <div class="kpi-value" id="totalUsers">—</div>
            </div>
            <span class="kpi-icon" style="background:rgba(168,85,247,.14);color:#c084fc;border:1px solid rgba(168,85,247,.25)">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </span>
          </div>
          <div class="pm-spark" id="sparkUsers"></div>
          <div class="kpi-foot"><span>Panel accounts</span><a href="/admin/users" class="pm-chip" style="font-size:10px;padding:2px 7px">Manage</a></div>
        </div>
      </div>

      <!-- ================= HOST + ACTIVITY ================= -->
      <div class="pm-grid split" style="margin-bottom:16px">
        <div class="pm-card">
          <div class="pm-card-head">
            <h3 class="pm-card-title">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
              Host resources
            </h3>
            <span class="pm-chip" id="hostChip">QEMU/KVM</span>
          </div>
          <div class="pm-card-body">
            <div class="resource-ring-row">
              <div class="resource-cell">
                <div class="pm-ring" id="ringCpu"><div class="pm-ring-label">0%</div></div>
                <div>
                  <div class="label">CPU load</div>
                  <div class="value" id="cpuValue">—</div>
                  <div class="pm-muted" style="font-size:10.5px" id="cpuCores">— cores</div>
                </div>
              </div>
              <div class="resource-cell">
                <div class="pm-ring" id="ringMem"><div class="pm-ring-label">0%</div></div>
                <div>
                  <div class="label">Memory</div>
                  <div class="value" id="memValue">—</div>
                  <div class="pm-muted" style="font-size:10.5px" id="memTotal">—</div>
                </div>
              </div>
            </div>

            <div style="margin-top:10px">
              <div class="pm-spread" style="font-size:11.5px;color:var(--pm-text-dim);margin-bottom:6px">
                <span>Disk · VM storage</span><span id="diskValue">—</span>
              </div>
              <div class="pm-bar" id="diskBar"><i style="width:0%"></i></div>
            </div>

            <div class="host-meta">
              <div>Operating system<strong id="hostOs">—</strong></div>
              <div>Hostname<strong id="hostName">—</strong></div>
              <div>Uptime<strong id="hostUptime">—</strong></div>
              <div>Node runtime<strong id="hostNode">—</strong></div>
            </div>
          </div>
        </div>

        <div class="pm-card">
          <div class="pm-card-head">
            <h3 class="pm-card-title">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
              Recent activity
            </h3>
            <span class="badge-count" id="activityCount">0</span>
          </div>
          <div class="pm-activity-feed" id="activityList" style="max-height:344px;overflow-y:auto">
            <div style="padding:26px;text-align:center;color:var(--pm-text-dim);font-size:12px">Loading activity…</div>
          </div>
          <div class="pm-card-foot pm-spread">
            <span>Auto-refresh every 30s</span>
            <a href="/admin/vms" class="pm-chip" style="font-size:10.5px">All machines →</a>
          </div>
        </div>
      </div>

      <!-- ================= QUICK ACTIONS ================= -->
      <div class="pm-quick-actions" style="margin-bottom:20px">
        <a href="/admin/vm-create" class="quick-action-card">
          <span class="quick-action-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span>
          <span class="quick-action-text"><h4>Create VM</h4><p>Deploy from a template</p></span>
          <span class="quick-action-arrow">→</span>
        </a>
        <a href="/admin/users" class="quick-action-card">
          <span class="quick-action-icon info"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></span>
          <span class="quick-action-text"><h4>Users &amp; access</h4><p>Invite and manage members</p></span>
          <span class="quick-action-arrow">→</span>
        </a>
        <a href="/admin/templates" class="quick-action-card">
          <span class="quick-action-icon warning"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/></svg></span>
          <span class="quick-action-text"><h4>OS templates</h4><p>Images, ISOs and caching</p></span>
          <span class="quick-action-arrow">→</span>
        </a>
        <a href="/admin/settings" class="quick-action-card">
          <span class="quick-action-icon success"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6h.09A1.65 1.65 0 0 0 10 3.09V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9v.09a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></span>
          <span class="quick-action-text"><h4>Panel settings</h4><p>Branding &amp; Discord login</p></span>
          <span class="quick-action-arrow">→</span>
        </a>
      </div>

      <!-- ================= MACHINES ================= -->
      <div class="pm-card">
        <div class="pm-card-head" style="flex-wrap:wrap">
          <div class="pm-row">
            <h3 class="pm-card-title">Virtual machines</h3>
            <span class="badge-count" id="vmCount">0</span>
          </div>
          <div class="pm-toolbar">
            <div class="search-input-wrapper vm-toolbar-input">
              <svg class="search-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
              <input type="text" class="search-input" id="vmSearch" placeholder="Filter machines…" style="height:34px;font-size:12px" oninput="renderMachines()">
            </div>
            <div class="pm-segmented" id="vmFilter">
              <button class="active" data-filter="">All</button>
              <button data-filter="running">Running</button>
              <button data-filter="stopped">Stopped</button>
            </div>
            <button class="btn btn-ghost btn-sm" onclick="loadAdminData()" title="Refresh machines">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline>
                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
              </svg>
            </button>
          </div>
        </div>
        <div class="pm-card-body">
          <div class="vm-grid" id="allVMContainer">
            <div class="skeleton skeleton-card"></div>
            <div class="skeleton skeleton-card"></div>
            <div class="skeleton skeleton-card"></div>
          </div>
        </div>
      </div>

    </div>

    <%- include('../partials/admin/footer') %>
  </div>
</div>

<script>
  let allVMs = [];
  let currentFilter = '';

  function escHtml(str) {
    if (str == null) return '';
    return String(str).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  function toast(msg, type) {
    if (window.PM) PM.toast(msg, type || 'info');
  }

  function history(key, value) {
    const storeKey = 'pm.hist.' + key;
    let arr = [];
    try {
      arr = JSON.parse(localStorage.getItem(storeKey) || '[]');
      if (!Array.isArray(arr)) arr = [];
    } catch (e) { arr = []; }
    arr.push(Number(value) || 0);
    if (arr.length > 24) arr = arr.slice(arr.length - 24);
    try { localStorage.setItem(storeKey, JSON.stringify(arr)); } catch (e) {}
    return arr.length > 1 ? arr : [arr[0], arr[0]];
  }

  function paintSpark(id, values, color) {
    if (window.PM) PM.sparkline(document.getElementById(id), values, { color: color, height: 34 });
  }

  function greeting() {
    const h = new Date().getHours();
    let text = 'Welcome back, ';
    if (h < 5) text = 'Burning the midnight oil, ';
    else if (h < 12) text = 'Good morning, ';
    else if (h < 18) text = 'Good afternoon, ';
    else text = 'Good evening, ';
    const node = document.getElementById('heroGreeting');
    if (node) node.innerHTML = text + '<span><%= user.username %></span>';
  }

  function renderMachines() {
    const container = document.getElementById('allVMContainer');
    if (!container) return;
    const q = (document.getElementById('vmSearch')?.value || '').toLowerCase();

    const filtered = allVMs.filter((vm) => {
      const matchesFilter = !currentFilter || (vm.status || 'stopped') === currentFilter;
      const hay = [vm.vm_name, vm.vm_id, vm.os_type, vm.template_name, vm.ipv4_address, vm.owner_username]
        .join(' ').toLowerCase();
      return matchesFilter && (!q || hay.indexOf(q) !== -1);
    });

    if (!filtered.length) {
      container.innerHTML =
        '<div class="empty-enhanced">' +
          '<div class="empty-icon-wrap">' +
            '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="7" rx="2"/><rect x="2" y="13" width="20" height="7" rx="2"/></svg>' +
          '</div>' +
          '<div class="empty-title">' + (allVMs.length ? 'No machines match this view' : 'No virtual machines yet') + '</div>' +
          '<div class="empty-desc">' + (allVMs.length
            ? 'Try another filter or clear the search to see every machine.'
            : 'Spin up your first machine from an OS template in under a minute.') + '</div>' +
          (allVMs.length
            ? '<button class="btn btn-ghost btn-sm" onclick="currentFilter=\'\';document.getElementById(\'vmSearch\').value=\'\';document.querySelectorAll(\'#vmFilter button\').forEach(b=>b.classList.toggle(\'active\',b.dataset.filter===\'\'));renderMachines()">Clear filters</button>'
            : '<a href="/admin/vm-create" class="btn btn-primary btn-sm">Create virtual machine</a>') +
        '</div>';
      return;
    }

    container.innerHTML = filtered.map(renderVMCard).join('');
  }

  function renderVMCard(vm) {
    const status = vm.status || 'stopped';
    const icon = vm.template_icon && String(vm.template_icon).startsWith('http')
      ? vm.template_icon
      : '/images/logo.png';
    const mem = vm.memory ? (vm.memory >= 1024 ? (vm.memory / 1024).toFixed(1) + ' GB' : vm.memory + ' MB') : '—';

    return `
      <div class="pm-card vm-card-enhanced ${escHtml(status)}">
        <div class="vm-card-header">
          <div class="vm-title-block">
            <div class="vm-os-icon"><img src="${escHtml(icon)}" alt="" onerror="this.style.display='none'"></div>
            <div style="min-width:0;flex:1">
              <div class="vm-name-enhanced" title="${escHtml(vm.vm_name)}">${escHtml(vm.vm_name)}</div>
              <div class="vm-meta-enhanced">
                <span>${escHtml(vm.template_name || vm.os_type || 'Custom OS')}</span>
                <span class="vm-id-chip">#${vm.vm_id}</span>
                <span>${escHtml(vm.owner_username || 'Unassigned')}</span>
              </div>
            </div>
          </div>
          <span class="status-badge ${escHtml(status)}"><span class="status-dot"></span>${escHtml(status)}</span>
        </div>

        <div class="vm-specs">
          <div class="spec-item">
            <span class="spec-icon mem"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/></svg></span>
            <span class="spec-content"><span class="spec-label">Memory</span><span class="spec-value">${mem}</span></span>
          </div>
          <div class="spec-item">
            <span class="spec-icon cpu"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M1 9h3M1 15h3M20 9h3M20 15h3"/></svg></span>
            <span class="spec-content"><span class="spec-label">vCPU</span><span class="spec-value">${vm.cpus || '—'} cores</span></span>
          </div>
          <div class="spec-item">
            <span class="spec-icon disk"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/></svg></span>
            <span class="spec-content"><span class="spec-label">Storage</span><span class="spec-value">${escHtml(vm.disk_size || '—')}</span></span>
          </div>
          <div class="spec-item">
            <span class="spec-icon net"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18z"/></svg></span>
            <span class="spec-content"><span class="spec-label">Network</span><span class="spec-value">${escHtml(vm.ipv4_address || (vm.network_type === 'nat' ? 'DHCP' : '—'))}</span></span>
          </div>
        </div>

        <div class="vm-actions-enhanced">
          ${status === 'running'
            ? `<button class="btn btn-action pm-no-loader" style="background:rgba(251,113,133,.14);border-color:rgba(251,113,133,.3);color:#fb7185" onclick="vmAction('stop', ${vm.vm_id}, '${escHtml(vm.vm_name)}')">Stop</button>`
            : `<button class="btn btn-action pm-no-loader" style="background:rgba(52,211,153,.14);border-color:rgba(52,211,153,.3);color:#34d399" onclick="vmAction('start', ${vm.vm_id}, '${escHtml(vm.vm_name)}')">Start</button>`}
          <a href="/admin/vm/${vm.vm_id}" class="btn btn-action btn-ghost">Details</a>
          <a href="/admin/vm/${vm.vm_id}/console" class="btn btn-action btn-ghost">Console</a>
        </div>
      </div>
    `;
  }

  async function loadAdminData() {
    const btn = document.getElementById('refreshBtn');
    if (btn) btn.classList.add('spinning');

    try {
      const [stats, vms] = await Promise.all([
        fetch('/api/admin/dashboard').then((r) => r.json()).catch(() => ({})),
        fetch('/api/admin/vms').then((r) => r.json())
      ]);

      const total = stats.totalVMs != null ? stats.totalVMs : (Array.isArray(vms) ? vms.length : 0);
      const running = stats.runningVMs != null ? stats.runningVMs : (vms || []).filter((v) => v.status === 'running').length;
      const stopped = Math.max(0, total - running);
      const users = stats.totalUsers || 0;

      if (window.PM) {
        PM.countUp(document.getElementById('totalVMs'), total);
        PM.countUp(document.getElementById('runningVMs'), running);
        PM.countUp(document.getElementById('stoppedVMs'), stopped);
        PM.countUp(document.getElementById('totalUsers'), users);
      }

      paintSpark('sparkTotal', history('total', total), '#818cf8');
      paintSpark('sparkRunning', history('running', running), '#34d399');
      paintSpark('sparkStopped', history('stopped', stopped), '#94a3b8');
      paintSpark('sparkUsers', history('users', users), '#c084fc');

      const ratio = total ? Math.round((running / total) * 100) : 0;
      const ratioEl = document.getElementById('runningRatio');
      if (ratioEl) ratioEl.textContent = ratio + '% of fleet active';

      const heroRunning = document.getElementById('heroRunning');
      if (heroRunning) heroRunning.textContent = running + ' of ' + total + ' machines running';

      document.getElementById('vmCount').textContent = total;
      const vmCountBadge = document.getElementById('vmCountBadge');
      if (vmCountBadge) { vmCountBadge.textContent = total; vmCountBadge.style.display = total ? 'inline-flex' : 'none'; }
      const runningBadge = document.getElementById('runningBadge');
      if (runningBadge) { runningBadge.textContent = running; runningBadge.style.display = running ? 'inline-flex' : 'none'; }

      allVMs = Array.isArray(vms) ? vms : [];
      renderMachines();
    } catch (e) {
      document.getElementById('allVMContainer').innerHTML =
        '<div class="empty-enhanced">' +
          '<div class="empty-icon-wrap" style="color:#fb7185;background:rgba(251,113,133,.12);border-color:rgba(251,113,133,.3)">' +
            '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><path d="M12 9v4M12 17h.01"/></svg>' +
          '</div>' +
          '<div class="empty-title">Could not reach the panel API</div>' +
          '<div class="empty-desc">' + escHtml(e.message) + '</div>' +
          '<button class="btn btn-ghost btn-sm" onclick="loadAdminData()">Try again</button>' +
        '</div>';
    } finally {
      if (btn) setTimeout(() => btn.classList.remove('spinning'), 600);
      const sync = document.getElementById('heroSync');
      if (sync) sync.textContent = 'Synced ' + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }

    loadHostMetrics();
    loadRecentActivity();
  }

  async function loadHostMetrics() {
    if (!window.PM) return;
    try {
      const m = await PM.fetchJSON('/api/system/metrics');

      PM.ring(document.getElementById('ringCpu'), m.cpu.percent);
      PM.ring(document.getElementById('ringMem'), m.memory.percent);

      document.getElementById('cpuValue').textContent = m.cpu.percent.toFixed(1) + '%';
      document.getElementById('cpuCores').textContent = m.cpu.cores + ' cores · load ' + (m.cpu.load1 || 0).toFixed(2);
      document.getElementById('memValue').textContent = PM.formatBytes(m.memory.used);
      document.getElementById('memTotal').textContent = 'of ' + PM.formatBytes(m.memory.total);

      if (m.disk) {
        document.getElementById('diskValue').textContent = PM.formatBytes(m.disk.used) + ' / ' + PM.formatBytes(m.disk.total);
        const bar = document.querySelector('#diskBar > i');
        if (bar) {
          bar.style.width = Math.min(100, m.disk.percent).toFixed(1) + '%';
          bar.parentElement.className = 'pm-bar ' + (m.disk.percent > 88 ? 'red' : m.disk.percent > 70 ? 'amber' : 'green');
        }
      } else {
        document.getElementById('diskValue').textContent = 'Unavailable';
      }

      document.getElementById('hostOs').textContent = m.platform || '—';
      document.getElementById('hostName').textContent = m.hostname || '—';
      document.getElementById('hostUptime').textContent = PM.formatUptime(m.uptime);
      document.getElementById('hostNode').textContent = m.node || '—';
      document.getElementById('hostChip').textContent = m.arch ? m.arch + ' · ' + m.cpu.cores + ' threads' : 'QEMU/KVM';

      const heroUptime = document.getElementById('heroUptime');
      if (heroUptime) heroUptime.textContent = 'Host up ' + PM.formatUptime(m.uptime);
    } catch (e) {
      /* telemetry is best-effort */
    }
  }

  async function loadRecentActivity() {
    if (!window.PM) return;
    try {
      const rows = await PM.fetchJSON('/api/admin/activity?limit=14');
      const list = document.getElementById('activityList');
      const count = document.getElementById('activityCount');
      if (count) count.textContent = rows.length;

      if (!rows.length) {
        list.innerHTML = '<div style="padding:30px 18px;text-align:center;color:var(--pm-text-dim);font-size:12px">' +
          '<div class="pm-empty-icon" style="margin-bottom:10px">' + PM.icon('sparkles', 20) + '</div>' +
          'No activity recorded yet.<br><span style="font-size:11px;opacity:.8">VM actions appear here in real time.</span></div>';
        return;
      }

      list.innerHTML = rows.map((row) => {
        const kind = row.status === 'error' || row.action === 'delete' ? 'error'
          : row.action === 'start' ? 'start'
          : row.action === 'create' ? 'create' : 'stop';
        const icon = row.action === 'start' ? 'play' : row.action === 'stop' ? 'stop'
          : row.action === 'create' ? 'plus' : row.action === 'delete' ? 'x' : 'info';
        return '<div class="pm-feed-item">' +
            '<span class="pm-feed-icon ' + kind + '">' + PM.icon(icon, 13) + '</span>' +
            '<span class="pm-feed-body">' +
              '<span class="pm-feed-title">' + escHtml(row.message || row.action) + '</span>' +
              '<span class="pm-feed-meta">' + escHtml(row.vm_name ? 'VM · ' + row.vm_name : 'Panel · #' + (row.vm_id || '—')) +
                (row.status ? ' · ' + escHtml(row.status) : '') + '</span>' +
            '</span>' +
            '<span class="pm-feed-time">' + PM.timeAgo(row.timestamp) + '</span>' +
          '</div>';
      }).join('');
    } catch (e) {
      const list = document.getElementById('activityList');
      if (list) list.innerHTML = '<div style="padding:24px;text-align:center;color:var(--pm-text-dim);font-size:12px">Activity feed unavailable</div>';
    }
  }

  async function vmAction(action, vmId, vmName) {
    const verb = action === 'start' ? 'Start' : action === 'stop' ? 'Stop' : action;
    const confirmed = window.PM
      ? await PM.confirm(verb + ' “' + vmName + '”? The machine will ' + (action === 'start' ? 'boot immediately.' : 'shut down gracefully.'), {
          title: verb + ' virtual machine',
          confirmText: verb,
          danger: action !== 'start'
        })
      : window.confirm(verb + ' ' + vmName + '?');
    if (!confirmed) return;

    try {
      toast(verb + 'ping ' + vmName + '…', 'info');
      const res = await fetch('/api/vms/' + vmId + '/' + action, { method: 'POST' });
      const data = await res.json().catch(() => ({}));
      if (res.ok && (data.success !== false)) {
        toast(vmName + ' ' + (action === 'start' ? 'is booting' : 'is shutting down'), 'success');
        setTimeout(loadAdminData, 1400);
      } else {
        toast(data.error || 'Action failed', 'error');
      }
    } catch (e) {
      toast('Request failed: ' + e.message, 'error');
    }
  }

  document.addEventListener('DOMContentLoaded', function () {
    greeting();
    const filter = document.getElementById('vmFilter');
    if (filter) {
      filter.addEventListener('click', (e) => {
        const btn = e.target.closest('button[data-filter]');
        if (!btn) return;
        currentFilter = btn.getAttribute('data-filter');
        filter.querySelectorAll('button').forEach((b) => b.classList.toggle('active', b === btn));
        renderMachines();
      });
    }
    loadAdminData();
    setInterval(loadAdminData, 30000);
    setInterval(loadHostMetrics, 15000);
  });
</script>
  <script src="/js/premium.js"></script>
</body>
</html>
