<%
  const _pageName = typeof pageName !== 'undefined' ? pageName : (currentPage || '');
  const _pageTitle = typeof pageTitle !== 'undefined' ? pageTitle : (title || '');
  const _role = (user && user.role) ? user.role : 'user';
  const _admin = _role === 'admin';
  const _crumb = _pageTitle.split(' - ')[0];
%>
<header class="admin-header" id="adminHeader">

  <!-- Left: nav controls + breadcrumb -->
  <div class="header-left">
    <button class="sidebar-toggle" id="sidebarToggle" onclick="toggleSidebar()" aria-label="Toggle navigation">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="15" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>


    <nav class="breadcrumb" aria-label="Breadcrumb">
      <span class="breadcrumb-item" aria-hidden="true">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
        </svg>
      </span>
      <span class="breadcrumb-separator"></span>
      <span class="breadcrumb-item"><%= siteName %></span>
      <span class="breadcrumb-separator"></span>
      <span class="breadcrumb-item active"><%= (_pageName && _pageName !== 'dashboard') ? _crumb : 'Dashboard' %></span>
    </nav>
  </div>

  <!-- Center: command palette trigger -->
  <div class="header-search">
    <div class="search-input-wrapper">
      <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.35-4.35"></path>
      </svg>
      <input
        type="text"
        class="search-input"
        id="globalSearch"
        placeholder="Search VMs, users or actions…"
        autocomplete="off"
        aria-label="Open command palette"
        readonly
      >
      <span class="search-kbd"><kbd>⌘</kbd><kbd>K</kbd></span>
    </div>
  </div>

  <!-- Right: status + actions + account -->
  <div class="header-right">
    <div class="header-status" id="systemStatus" data-pm-tip="All services operational">
      <span class="status-dot"></span>
      <span>Online</span>
    </div>

    <span class="pm-hide-sm pm-mono" id="pmClock" style="font-size:11.5px;color:var(--pm-text-dim);min-width:44px;text-align:center"></span>

    <!-- Appearance studio -->
    <button class="header-btn" id="pmStudioBtn" title="Appearance & preferences" aria-label="Appearance settings">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="13.5" cy="6.5" r="1.5"></circle>
        <circle cx="17.5" cy="10.5" r="1.5"></circle>
        <circle cx="8.5" cy="7.5" r="1.5"></circle>
        <circle cx="6.5" cy="12.5" r="1.5"></circle>
        <path d="M12 2a10 10 0 1 0 0 20c1.1 0 2-.9 2-2 0-.5-.2-1-.5-1.3-.3-.4-.5-.8-.5-1.2 0-1.1.9-2 2-2h2.5c2.5 0 4.5-2 4.5-4.5C22 5.6 17.5 2 12 2z"></path>
      </svg>
    </button>

    <!-- Theme quick switch (kept for keyboard users) -->
    <div class="theme-switcher" role="group" aria-label="Theme">
      <button class="theme-btn active" id="darkThemeBtn" onclick="setTheme('dark')" title="Dark theme" aria-label="Dark theme">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
      <button class="theme-btn" id="lightThemeBtn" onclick="setTheme('light')" title="Light theme" aria-label="Light theme">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="4.5"></circle>
          <line x1="12" y1="2" x2="12" y2="4"></line>
          <line x1="12" y1="20" x2="12" y2="22"></line>
          <line x1="4.2" y1="4.2" x2="5.6" y2="5.6"></line>
          <line x1="18.4" y1="18.4" x2="19.8" y2="19.8"></line>
          <line x1="2" y1="12" x2="4" y2="12"></line>
          <line x1="20" y1="12" x2="22" y2="12"></line>
          <line x1="4.2" y1="19.8" x2="5.6" y2="18.4"></line>
          <line x1="18.4" y1="5.6" x2="19.8" y2="4.2"></line>
        </svg>
      </button>
    </div>

    <!-- Notifications -->
    <div class="dropdown">
      <button class="header-btn" id="notifBtn" title="Activity" aria-label="Activity" onclick="toggleDropdown('notifMenu')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
        <span class="notification-dot" id="pmNotifDot" style="display:none"></span>
      </button>
      <div class="dropdown-menu" id="notifMenu" style="width:330px;padding:0;overflow:hidden">
        <div class="pm-spread" style="padding:13px 14px;border-bottom:1px solid var(--pm-line-soft)">
          <div style="font-size:12.5px;font-weight:650">Recent activity</div>
          <span class="pm-chip brand" style="font-size:10px">Live</span>
        </div>
        <div id="pmNotifList" style="max-height:320px;overflow-y:auto"></div>
        <div style="padding:10px 14px;border-top:1px solid var(--pm-line-soft);display:flex;gap:8px">
          <a href="<%= _admin ? '/admin/dashboard' : '/dashboard' %>" class="pm-chip" style="flex:1;justify-content:center">View dashboard</a>
          <button class="pm-chip" style="cursor:pointer" onclick="openShortcutsHint()">Shortcuts</button>
        </div>
      </div>
    </div>

    <!-- Fullscreen -->
    <button class="header-btn pm-hide-sm" onclick="toggleFullscreen()" title="Fullscreen" aria-label="Toggle fullscreen">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" id="fsIcon">
        <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
      </svg>
    </button>

    <!-- Account -->
    <div class="dropdown">
      <div class="header-user" id="userMenuBtn" onclick="toggleDropdown('userMenu')" tabindex="0" role="button" aria-label="Account menu">
        <div class="header-user-avatar" id="headerAvatar">
          <%= (user && user.username) ? user.username.charAt(0).toUpperCase() : 'A' %>
        </div>
        <div class="pm-hide-sm">
          <div class="header-user-name"><%= (user && user.username) ? user.username : 'Admin' %></div>
          <div class="header-user-role"><%= _role.charAt(0).toUpperCase() + _role.slice(1) %></div>
        </div>
        <svg class="pm-hide-sm" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--pm-text-dim)">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>

      <div class="dropdown-menu" id="userMenu" style="min-width:250px">
        <div style="padding:12px;border-bottom:1px solid var(--pm-line-soft);display:flex;gap:10px;align-items:center">
          <div class="pm-avatar" id="menuAvatar"><%= (user && user.username) ? user.username.charAt(0).toUpperCase() : 'A' %></div>
          <div style="min-width:0">
            <div style="font-size:13px;font-weight:650;color:var(--pm-text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
              <%= (user && user.username) ? user.username : 'Admin' %>
            </div>
            <div style="font-size:10.5px;color:var(--pm-text-dim)" id="menuRole"><%= _role.charAt(0).toUpperCase() + _role.slice(1) %> account</div>
          </div>
        </div>

        <a href="/profile" class="dropdown-item" style="margin-top:6px">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          My profile
        </a>
        <% if (_admin) { %>
        <a href="/admin/settings" class="dropdown-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6h.09A1.65 1.65 0 0 0 10 3.09V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9v.09a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
          </svg>
          Panel settings
        </a>
        <% } %>
        <button class="dropdown-item" onclick="openShortcutsHint()">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="6" width="20" height="12" rx="2"></rect>
            <path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M8 14h8"></path>
          </svg>
          Keyboard shortcuts
          <span class="pm-kbd pm-right">?</span>
        </button>
        <button class="dropdown-item" onclick="toggleThemeQuick()">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4.5"></circle>
            <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
          Switch theme
          <span class="pm-kbd pm-right">T</span>
        </button>
        <div class="dropdown-divider"></div>
        <button class="dropdown-item danger" onclick="logout()">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
          Sign out
        </button>
        <div style="padding:8px 12px 4px;font-size:10px;color:var(--pm-text-dim);display:flex;justify-content:space-between">
          <span><%= siteName %></span><span><%= panelVersion %></span>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  /* Header interactions (theme lives in premium.js) */
  function openShortcutsHint() {
    if (window.PM && PM.openShortcuts) PM.openShortcuts();
  }
  function toggleThemeQuick() {
    if (window.PM) PM.toggleTheme();
  }

  // Discord avatar (progressive enhancement)
  async function loadUserAvatar() {
    try {
      const res = await fetch('/api/discord-account-info');
      if (!res.ok) return;
      const account = await res.json();
      if (!account || !account.discord_avatar || !account.discord_id) return;
      const url = `https://cdn.discordapp.com/avatars/${account.discord_id}/${account.discord_avatar}.png?size=256`;
      ['headerAvatar', 'menuAvatar'].forEach((id) => {
        const node = document.getElementById(id);
        if (!node) return;
        node.style.backgroundImage = `url('${url}')`;
        node.style.backgroundSize = 'cover';
        node.style.backgroundPosition = 'center';
        node.textContent = '';
      });
    } catch (e) { /* no linked account */ }
  }

  function toggleFullscreen() {
    if (!document.fullscreenElement) {
      document.documentElement.requestFullscreen().catch(() => {});
    } else {
      document.exitFullscreen().catch(() => {});
    }
  }

  async function logout() {
    try { await fetch('/api/logout', { method: 'POST' }); } catch (e) {}
    window.location.href = '/login';
  }

  function toggleDropdown(id) {
    const menu = document.getElementById(id);
    if (!menu) return;
    document.querySelectorAll('.dropdown-menu').forEach((m) => { if (m.id !== id) m.classList.remove('show'); });
    menu.classList.toggle('show');
    if (id === 'notifMenu' && window.PM) PM.markNotificationsRead();
  }

  document.addEventListener('click', (e) => {
    if (!e.target.closest('.dropdown')) {
      document.querySelectorAll('.dropdown-menu.show').forEach((m) => m.classList.remove('show'));
    }
  });

  function initializeTheme() {
    if (window.PM) PM.applyPrefs();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => { loadUserAvatar(); initializeTheme(); });
  } else {
    loadUserAvatar();
    initializeTheme();
  }
</script>
