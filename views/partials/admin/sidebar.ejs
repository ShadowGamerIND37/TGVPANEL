<%
  const cp = currentPage || '';
  const u = user || {};
%>

<!-- Admin Sidebar -->
<aside class="admin-sidebar" id="adminSidebar">

  <!-- Brand -->
  <a href="/admin/dashboard" class="sidebar-brand">
    <div class="sidebar-brand-icon" style="display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: var(--radius-md); overflow: hidden; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
      <img src="<%= siteLogo %>" style="width: 100%; height: 100%; border-radius: var(--radius-md); object-fit: cover; padding: 2px;" alt="<%= siteName %> Logo">
    </div>
    <div class="sidebar-brand-text">
      <div class="sidebar-brand-name"><%= siteName %></div>
      <div class="sidebar-brand-version"><%= panelVersion %>  HKVM PANEL</div>
    </div>
  </a>

  <!-- Navigation (23 Unified HKVM V3 Admin Sidebar Items) -->
  <nav class="sidebar-nav">

    <!-- Overview & Compute -->
    <div class="nav-section">
      <div class="nav-section-label">Overview &amp; Compute</div>

      <!-- 1. Dashboard -->
      <a href="/admin/dashboard" class="nav-item <%= cp === 'dashboard' ? 'active' : '' %>">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9" rx="1"></rect><rect x="14" y="3" width="7" height="5" rx="1"></rect><rect x="14" y="12" width="7" height="9" rx="1"></rect><rect x="3" y="16" width="7" height="5" rx="1"></rect></svg></span>
        <span class="nav-text">Dashboard</span>
        <span class="nav-badge" id="runningBadge" style="display:none">0</span>
      </a>

      <!-- 2. Unified Instances -->
      <a href="/admin/instances" class="nav-item <%= cp === 'instances' ? 'active' : '' %>">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="7" rx="1"></rect><rect x="2" y="14" width="20" height="7" rx="1"></rect><circle cx="6" cy="6.5" r="1"></circle><circle cx="6" cy="17.5" r="1"></circle></svg></span>
        <span class="nav-text">Instances</span>
      </a>

      <!-- 3. KVM VMs -->
      <a href="/admin/vms" class="nav-item <%= cp === 'vms' || cp === 'vm-detail' ? 'active' : '' %>">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="M8 20h8"></path><path d="M12 16v4"></path><circle cx="12" cy="12" r="3"></circle></svg></span>
        <span class="nav-text">KVM VMs</span>
        <span class="nav-badge" id="vmCountBadge" style="display:none">0</span>
      </a>

      <!-- 4. LXC Containers -->
      <a href="/admin/lxc" class="nav-item <%= cp === 'lxc' ? 'active' : '' %>">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg></span>
        <span class="nav-text">LXC Containers</span>
      </a>

      <!-- 5. Create Instance -->
      <a href="/admin/instances/create" class="nav-item <%= cp === 'instances-create' || cp === 'vm-create' ? 'active' : '' %>">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg></span>
        <span class="nav-text">Create Instance</span>
      </a>
    </div>

    <!-- Infrastructure & Images -->
    <div class="nav-section">
      <div class="nav-section-label">Infrastructure &amp; Images</div>

      <!-- 6. Nodes -->
      <a href="/admin/nodes" class="nav-item <%= cp === 'nodes' ? 'active' : '' %>">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2"></rect><rect x="2" y="14" width="20" height="8" rx="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg></span>
        <span class="nav-text">Nodes</span>
      </a>

      <!-- 7. Storage -->
      <a href="/admin/storage" class="nav-item <%= cp === 'storage' ? 'active' : '' %>">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg></span>
        <span class="nav-text">Storage</span>
      </a>

      <!-- 8. ISOs -->
      <a href="/admin/isos" class="nav-item <%= cp === 'isos' ? 'active' : '' %>">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="3"></circle></svg></span>
        <span class="nav-text">ISOs</span>
      </a>

      <!-- 9. OS Templates (KVM) -->
      <a href="/admin/templates" class="nav-item <%= cp === 'templates' ? 'active' : '' %>">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg></span>
        <span class="nav-text">OS Templates (KVM)</span>
      </a>

      <!-- 10. LXC Templates -->
      <a href="/admin/lxc-templates" class="nav-item <%= cp === 'lxc-templates' ? 'active' : '' %>">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg></span>
        <span class="nav-text">LXC Templates</span>
      </a>
    </div>

    <!-- Network & Data Protection -->
    <div class="nav-section">
      <div class="nav-section-label">Network &amp; Protection</div>

      <!-- 11. Networking -->
      <a href="/admin/networking" class="nav-item <%= cp === 'networking' ? 'active' : '' %>">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="5" r="3"></circle><circle cx="5" cy="19" r="3"></circle><circle cx="19" cy="19" r="3"></circle><line x1="12" y1="8" x2="5" y2="16"></line><line x1="12" y1="8" x2="19" y2="16"></line></svg></span>
        <span class="nav-text">Networking</span>
      </a>

      <!-- 12. Port Forwarding -->
      <a href="/admin/ports" class="nav-item <%= cp === 'ports' ? 'active' : '' %>">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 3 21 3 21 8"></polyline><line x1="4" y1="20" x2="21" y2="3"></line><polyline points="21 16 21 21 16 21"></polyline><line x1="15" y1="15" x2="21" y2="21"></line></svg></span>
        <span class="nav-text">Port Forwarding</span>
      </a>

      <!-- 13. Firewall -->
      <a href="/admin/firewall" class="nav-item <%= cp === 'firewall' ? 'active' : '' %>">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg></span>
        <span class="nav-text">Firewall</span>
      </a>

      <!-- 14. Snapshots -->
      <a href="/admin/snapshots" class="nav-item <%= cp === 'snapshots' ? 'active' : '' %>">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg></span>
        <span class="nav-text">Snapshots</span>
      </a>

      <!-- 15. Backups -->
      <a href="/admin/backups" class="nav-item <%= cp === 'backups' ? 'active' : '' %>">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg></span>
        <span class="nav-text">Backups</span>
      </a>

      <!-- 16. Migrations -->
      <a href="/admin/migrations" class="nav-item <%= cp === 'migrations' ? 'active' : '' %>">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="17 1 21 5 17 9"></polyline><path d="M3 11V9a4 4 0 0 1 4-4h14"></path><polyline points="7 23 3 19 7 15"></polyline><path d="M21 13v2a4 4 0 0 1-4 4H3"></path></svg></span>
        <span class="nav-text">Migrations</span>
      </a>

      <!-- 17. Monitoring -->
      <a href="/admin/monitoring" class="nav-item <%= cp === 'monitoring' ? 'active' : '' %>">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg></span>
        <span class="nav-text">Monitoring</span>
      </a>
    </div>

    <!-- Governance & System -->
    <div class="nav-section">
      <div class="nav-section-label">Governance &amp; System</div>

      <!-- 18. Users -->
      <a href="/admin/users" class="nav-item <%= cp === 'users' ? 'active' : '' %>">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></span>
        <span class="nav-text">Users</span>
      </a>

      <!-- 19. API Keys & Webhooks -->
      <a href="/admin/api-keys" class="nav-item <%= cp === 'api-keys' ? 'active' : '' %>">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path></svg></span>
        <span class="nav-text">API Keys &amp; Webhooks</span>
      </a>

      <!-- 20. Audit Logs -->
      <a href="/admin/audit-logs" class="nav-item <%= cp === 'audit-logs' ? 'active' : '' %>">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg></span>
        <span class="nav-text">Audit Logs</span>
      </a>

      <!-- 21. Node Console -->
      <a href="/admin/node-console" class="nav-item <%= cp === 'node-console' ? 'active' : '' %>">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg></span>
        <span class="nav-text">Node Console</span>
      </a>

      <!-- 22. License -->
      <a href="/admin/license" class="nav-item <%= cp === 'license' ? 'active' : '' %>">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg></span>
        <span class="nav-text">License</span>
      </a>

      <!-- 23. Settings -->
      <a href="/admin/settings" class="nav-item <%= cp === 'settings' ? 'active' : '' %>">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg></span>
        <span class="nav-text">Settings</span>
      </a>
    </div>

    <!-- Switch Panel & Tools -->
    <div class="nav-section">
      <div class="nav-section-label">Quick Switch</div>
      <a href="/dashboard" class="nav-item nav-item-highlight">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"></path><path d="M12 19l-7-7 7-7"></path></svg></span>
        <span class="nav-text">User Panel</span>
      </a>
      <div class="nav-item" onclick="openQuickActions()">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg></span>
        <span class="nav-text">Quick Actions</span>
      </div>
      <div class="nav-item" onclick="openSystemInfo()">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg></span>
        <span class="nav-text">System Info</span>
      </div>
    </div>

  </nav>

  <!-- Sidebar Footer -->
  <div class="sidebar-footer">

    <!-- User Info -->
    <div class="sidebar-user" onclick="toggleDropdown('sidebarUserMenu')">
      <div class="user-avatar" id="sidebarUserAvatar" style="background-size: cover; background-position: center; position: relative;">
        <span id="userInitial"><%= u.username ? u.username.charAt(0).toUpperCase() : 'A' %></span>
        <span id="discordBadge" style="position: absolute; bottom: -2px; right: -2px; width: 14px; height: 14px; background: #5865F2; border-radius: 50%; display: none; border: 2px solid var(--bg-primary);"></span>
      </div>
      <div class="user-info">
        <div class="user-name"><%= u.username || 'Admin' %></div>
        <div class="user-role">
          <% if (u.role === 'admin') { %>
          <span style="display: inline-flex; align-items: center; gap: 4px;">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.2H22l-6 4.6 2.3 7.2-6.3-4.6-6.3 4.6L8 13.8l-6-4.6h7.6z"/></svg>
            Administrator
          </span>
          <% } else { %>
          <span style="display: inline-flex; align-items: center; gap: 4px;">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            User
          </span>
          <% } %>
        </div>
      </div>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--text-muted); flex-shrink:0;">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </div>

    <!-- Sidebar User Dropdown -->
    <div class="dropdown-menu" id="sidebarUserMenu" style="bottom: 100%; top: auto; margin-bottom: 6px; right: 0; left: 0; min-width: unset;">
      <a href="/admin/settings" class="dropdown-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
        Profile & Settings
      </a>
      <div class="dropdown-divider"></div>
      <button class="dropdown-item danger" onclick="logout()">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        Sign Out
      </button>
    </div>
  </div>
</aside>

<!-- Quick Actions Modal -->
<div class="modal-overlay" id="quickActionsModal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
        Quick Actions
      </div>
      <button class="modal-close" onclick="closeModal('quickActionsModal')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="modal-body">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
        <a href="/admin/vm-create" class="btn btn-primary btn-lg" style="justify-content: center;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="16"></line>
            <line x1="8" y1="12" x2="16" y2="12"></line>
          </svg>
          Create VM
        </a>
        <a href="/admin/vms" class="btn btn-outline btn-lg" style="justify-content: center;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="M8 20h8"></path>
            <path d="M12 16v4"></path>
          </svg>
          View All VMs
        </a>
        <% if (u.role === 'admin') { %>
        <a href="/admin/users" class="btn btn-ghost btn-lg" style="justify-content: center;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
          </svg>
          Manage Users
        </a>
        <a href="/admin/settings" class="btn btn-ghost btn-lg" style="justify-content: center;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
