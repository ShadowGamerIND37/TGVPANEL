<script>
// Load Discord profile picture if available
async function loadSidebarUserAvatar() {
  try {
    console.log('[DEBUG] loadSidebarUserAvatar called');
    
    const avatar = document.getElementById('sidebarUserAvatar');
    console.log('[DEBUG] sidebarUserAvatar element:', avatar);
    
    if (!avatar) {
      console.error('[DEBUG] sidebarUserAvatar element not found');
      return;
    }
    
    const res = await fetch('/api/discord-account-info');
    console.log('[DEBUG] Discord account info response:', res.ok);
    
    if (res.ok) {
      const discordAccount = await res.json();
      console.log('[DEBUG] Discord account data:', discordAccount);
      
      if (discordAccount && discordAccount.discord_avatar && discordAccount.discord_id) {
        // Build Discord CDN avatar URL with hash
        const discordAvatarUrl = `https://cdn.discordapp.com/avatars/${discordAccount.discord_id}/${discordAccount.discord_avatar}.png?size=128`;
        console.log('[DEBUG] Discord avatar URL:', discordAvatarUrl);
        
        const initial = document.getElementById('userInitial');
        const badge = document.getElementById('discordBadge');
        
        console.log('[DEBUG] Initial element:', initial);
        console.log('[DEBUG] Badge element:', badge);
        
        // Set background image
        avatar.style.backgroundImage = `url('${discordAvatarUrl}')`;
        avatar.style.backgroundSize = 'cover';
        avatar.style.backgroundPosition = 'center';
        
        // Hide the initial text
        if (initial) {
          initial.style.display = 'none';
          console.log('[DEBUG] Hidden initial text');
        }
        
        // Show Discord badge
        if (badge) {
          badge.style.display = 'block';
          console.log('[DEBUG] Showing Discord badge');
        }
        
        console.log('[DEBUG] Discord avatar applied successfully!');
      } else {
        console.log('[DEBUG] No Discord avatar data:', { avatar: discordAccount?.discord_avatar, id: discordAccount?.discord_id });
      }
    } else {
      console.log('[DEBUG] Discord account info fetch not ok:', res.status);
    }
  } catch(e) {
    console.error('[Discord Avatar Error]', e);
  }
}

// Sidebar functionality
function toggleSidebar() {
  const sidebar = document.getElementById('adminSidebar');
  const overlay = document.getElementById('sidebarOverlay');
  sidebar.classList.toggle('open');
  overlay.classList.toggle('open');
  document.body.style.overflow = sidebar.classList.contains('open') ? 'hidden' : '';
}

function closeSidebar() {
  const sidebar = document.getElementById('adminSidebar');
  const overlay = document.getElementById('sidebarOverlay');
  sidebar.classList.remove('open');
  overlay.classList.remove('open');
  document.body.style.overflow = '';
}

// Modal functions
function openModal(id) {
  document.getElementById(id).classList.add('show');
  document.body.style.overflow = 'hidden';
}

function closeModal(id) {
  document.getElementById(id).classList.remove('show');
  document.body.style.overflow = '';
}

function openQuickActions() { openModal('quickActionsModal'); }
function openSystemInfo() { openModal('systemInfoModal'); }

// Close modal on overlay click
document.addEventListener('click', (e) => {
  if (e.target.classList.contains('modal-overlay')) {
    document.querySelectorAll('.modal-overlay').forEach(m => {
      m.classList.remove('show');
    });
    document.body.style.overflow = '';
  }
});

// Load sidebar stats
async function loadSidebarStats() {
  try {
    const [vmsRes, settingsRes] = await Promise.all([
      fetch('/api/vms'),
      fetch('/api/settings')
    ]);
    
    if (vmsRes.ok) {
      const vms = await vmsRes.json();
      const runningCount = vms.filter(vm => vm.status === 'running').length;
      const vmCountBadge = document.getElementById('vmCountBadge');
      const runningBadge = document.getElementById('runningBadge');
      
      if (vmCountBadge) {
        vmCountBadge.textContent = vms.length;
        vmCountBadge.style.display = 'inline-flex';
      }
      
      if (runningBadge) {
        runningBadge.textContent = runningCount;
        runningBadge.style.display = runningCount > 0 ? 'inline-flex' : 'none';
      }
    }
    
    if (settingsRes.ok) {
      const settings = await settingsRes.json();
      const siteName = settings['site_name'] || '<%= siteName %>';
      const nameEl = document.getElementById('sidebarName');
      if (nameEl) {
        nameEl.textContent = siteName;
      }
    }
  } catch(e) {
    console.error('Failed to load sidebar data:', e);
  }
}

// Load sidebar data on page load
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', loadSidebarStats);
} else {
  loadSidebarStats();
}

// Refresh stats every 30 seconds
setInterval(loadSidebarStats, 30000);

// === LOAD DISCORD AVATAR ===
// Call on page load with multiple triggers
document.addEventListener('DOMContentLoaded', () => {
  setTimeout(loadSidebarUserAvatar, 300);
});

window.addEventListener('load', () => {
  setTimeout(loadSidebarUserAvatar, 300);
});

// If page is already loaded
if (document.readyState === 'complete' || document.readyState === 'interactive') {
  setTimeout(loadSidebarUserAvatar, 500);
}
</script>