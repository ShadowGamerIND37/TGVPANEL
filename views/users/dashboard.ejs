<!DOCTYPE html>
<html lang="en">
<head>
  <script>(function(){try{var t=localStorage.getItem('pm.theme')||'dark';var d=document.documentElement;if(t==='light')d.classList.add('pm-theme-light');d.style.colorScheme=t==='light'?'light':'dark';}catch(e){}})();</script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#06070c">
  <title><%= title || 'Dashboard · ' + siteName %></title>
  <link rel="icon" href="<%= siteLogo %>" type="image/png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/premium.css">
  <style>
    .kpi-card { padding: 18px; }
    .kpi-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
    .kpi-label { font-size: 11.5px; color: var(--pm-text-dim); display: flex; align-items: center; gap: 7px; font-weight: 500; }
    .kpi-value { font-size: 30px; font-weight: 700; letter-spacing: -0.04em; line-height: 1.05; margin-top: 10px; font-variant-numeric: tabular-nums; }
    .kpi-foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 6px; font-size: 11px; color: var(--pm-text-dim); }
    .kpi-icon { width: 34px; height: 34px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .vm-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(310px, 1fr)); gap: 14px; }
    .vm-card-enhanced { padding: 16px; border-radius: 15px; display: flex; flex-direction: column; gap: 12px; }
    .vm-card-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
    .vm-title-block { display: flex; gap: 11px; min-width: 0; flex: 1; }
    .vm-os-icon { width: 38px; height: 38px; border-radius: 10px; overflow: hidden; flex-shrink: 0; background: rgba(148,163,184,.1); border: 1px solid var(--pm-line); display: flex; align-items: center; justify-content: center; }
    .vm-os-icon img { width: 100%; height: 100%; object-fit: cover; }
    .vm-name-enhanced { font-size: 14px; font-weight: 650; color: var(--pm-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .vm-meta-enhanced { display: flex; align-items: center; gap: 7px; flex-wrap: wrap; font-size: 11px; color: var(--pm-text-dim); margin-top: 2px; }
    .vm-id-chip { font-family: ui-monospace, monospace; font-size: 10px; padding: 1px 5px; border-radius: 5px; background: rgba(148,163,184,.12); }
    .status-badge { display: inline-flex; align-items: center; gap: 5px; padding: 3px 8px; border-radius: 99px; font-size: 10px; font-weight: 650; text-transform: capitalize; flex-shrink: 0; border: 1px solid var(--pm-line); }
    .status-badge .status-dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
    .status-badge.running { color: #34d399; background: rgba(52,211,153,.12); border-color: rgba(52,211,153,.3); }
    .status-badge.stopped { color: var(--pm-text-soft); background: rgba(148,163,184,.1); }
    .status-badge.error { color: #fb7185; background: rgba(251,113,133,.12); border-color: rgba(251,113,133,.3); }
    .vm-specs { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; }
    .spec-item { display: flex; align-items: center; gap: 8px; min-width: 0; }
    .spec-icon { width: 26px; height: 26px; border-radius: 7px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .spec-icon.mem { background: rgba(52,211,153,.12); color: #34d399; }
    .spec-icon.cpu { background: rgba(236,72,153,.12); color: #f472b6; }
    .spec-icon.disk { background: rgba(34,211,238,.12); color: #22d3ee; }
    .spec-icon.net { background: rgba(96,165,250,.12); color: #60a5fa; }
    .spec-content { min-width: 0; }
    .spec-label { font-size: 9px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--pm-text-dim); line-height: 1.2; }
    .spec-value { font-size: 11.5px; font-weight: 600; color: var(--pm-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ssh-info-box {
      display: flex; align-items: center; gap: 9px; padding: 8px 10px;
      background: rgba(var(--pm-brand-rgb), .09);
      border: 1px solid rgba(var(--pm-brand-rgb), .22);
      border-radius: 10px; font-size: 11px;
    }
    .ssh-icon-wrap { width: 24px; height: 24px; border-radius: 7px; background: rgba(var(--pm-brand-rgb),.16); color: #c4b5fd; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .ssh-details { flex: 1; min-width: 0; font-family: ui-monospace, monospace; color: var(--pm-text-dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ssh-details strong { color: var(--pm-text); font-weight: 600; }
    .ssh-copy-btn { background: transparent; border: 1px solid rgba(var(--pm-brand-rgb),.3); color: #c4b5fd; padding: 3px 7px; border-radius: 7px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
    .ssh-copy-btn:hover { background: rgba(var(--pm-brand-rgb),.16); }
    .vm-actions-enhanced { display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px; margin-top: auto; }
    .btn-action { display: inline-flex; align-items: center; justify-content: center; gap: 5px; padding: 7px 8px; font-size: 11.5px; }
    .empty-enhanced { grid-column: 1 / -1; padding: 46px 20px; border-radius: 16px; text-align: center; border: 1px dashed var(--pm-line-strong); background: var(--pm-surface); }
    .empty-icon-wrap { width: 50px; height: 50px; margin: 0 auto 12px; border-radius: 14px; display: flex; align-items: center; justify-content: center; color: var(--pm-brand-2); background: var(--pm-brand-gradient-soft); border: 1px solid var(--pm-brand-line); }
    .empty-title { font-size: 14px; font-weight: 650; }
    .empty-desc { font-size: 12px; color: var(--pm-text-dim); margin: 5px 0 14px; }
    .skeleton-card { height: 220px; border-radius: 15px; }
    .snapshot-row { display: flex; align-items: center; justify-content: space-between; padding: 9px 0; border-bottom: 1px solid var(--pm-line-soft); font-size: 12px; }
    .snapshot-row:last-child { border-bottom: none; }
    .snapshot-row span:first-child { color: var(--pm-text-dim); }
    .snapshot-row span:last-child { color: var(--pm-text); font-weight: 600; }
  </style>
</head>
<body>

<div class="admin-wrapper">
  <%- include('../partials/users/sidebar') %>

  <div class="admin-main">
    <%- include('../partials/admin/header') %>

    <div class="admin-content">

      <!-- HERO -->
      <section class="pm-hero">
        <div class="pm-hero-inner">
          <div style="max-width:640px">
            <div class="pm-hero-eyebrow">
              <span style="width:6px;height:6px;border-radius:50%;background:var(--pm-brand-2);box-shadow:0 0 10px var(--pm-brand-2)"></span>
              Your workspace
            </div>
            <h1 class="pm-hero-title" id="heroGreeting">Welcome back, <span><%= user.username %></span></h1>
            <p class="pm-hero-sub">Power on, connect and manage every machine assigned to you — all from one place.</p>
            <div class="pm-toolbar" style="margin-top:16px">
              <span class="pm-chip brand"><span class="dot"></span><span id="heroRunning">Loading machines…</span></span>
              <span class="pm-chip" id="heroRam">RAM —</span>
              <span class="pm-chip" id="heroSync">Sync —</span>
            </div>
          </div>
          <div class="pm-hero-actions">
            <a href="/vms" class="btn btn-primary btn-lg">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="7" rx="2"></rect><rect x="2" y="13" width="20" height="7" rx="2"></rect>
              </svg>
              All machines
            </a>
            <button class="btn btn-ghost btn-lg" onclick="if(window.PM)PM.openPalette('')">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
              Search <span class="pm-kbd" style="margin-left:2px">⌘K</span>
            </button>
            <button class="btn btn-outline btn-lg" id="refreshBtn" onclick="loadMyVMs()">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline>
                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
              </svg>
              Refresh
            </button>
          </div>
        </div>
      </section>

      <!-- KPIs -->
      <div class="pm-grid cols-4" style="margin-bottom:16px">
        <div class="pm-card kpi-card">
          <div class="kpi-top">
            <div><div class="kpi-label">My machines</div><div class="kpi-value" id="myTotal">—</div></div>
            <span class="kpi-icon" style="background:rgba(129,140,248,.14);color:#818cf8;border:1px solid rgba(129,140,248,.25)">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="7" rx="2"/><rect x="2" y="13" width="20" height="7" rx="2"/></svg>
            </span>
          </div>
          <div class="pm-spark" id="sparkTotal"></div>
          <div class="kpi-foot"><span>Assigned to you</span><a href="/vms" class="pm-chip" style="font-size:10px;padding:2px 7px">View all</a></div>
        </div>

        <div class="pm-card kpi-card">
          <div class="kpi-top">
            <div><div class="kpi-label">Running</div><div class="kpi-value" id="myRunning" style="color:#34d399">—</div></div>
            <span class="kpi-icon" style="background:rgba(52,211,153,.14);color:#34d399;border:1px solid rgba(52,211,153,.25)">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><polygon points="7 4 20 12 7 20 7 4"/></svg>
            </span>
          </div>
          <div class="pm-spark" id="sparkRunning"></div>
          <div class="kpi-foot"><span id="runningRatio">—</span><span class="pm-chip" style="font-size:10px;padding:2px 7px">live</span></div>
        </div>

        <div class="pm-card kpi-card">
          <div class="kpi-top">
            <div><div class="kpi-label">Stopped</div><div class="kpi-value" id="myStopped">—</div></div>
            <span class="kpi-icon" style="background:rgba(148,163,184,.12);color:var(--pm-text-soft);border:1px solid var(--pm-line)">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>
            </span>
          </div>
          <div class="pm-spark" id="sparkStopped"></div>
          <div class="kpi-foot"><span>Ready to boot</span><span class="pm-chip" style="font-size:10px;padding:2px 7px">idle</span></div>
        </div>

        <div class="pm-card kpi-card">
          <div class="kpi-top">
            <div><div class="kpi-label">Allocated RAM</div><div class="kpi-value" id="myTotalMem">—</div></div>
            <span class="kpi-icon" style="background:rgba(34,211,238,.14);color:#22d3ee;border:1px solid rgba(34,211,238,.25)">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/></svg>
            </span>
          </div>
          <div class="pm-spark" id="sparkMem"></div>
          <div class="kpi-foot"><span>Across your fleet</span><span class="pm-chip" style="font-size:10px;padding:2px 7px">memory</span></div>
        </div>
      </div>

      <!-- MACHINES + ASIDE -->
      <div class="pm-grid split">
        <div class="pm-card">
          <div class="pm-card-head" style="flex-wrap:wrap">
            <div class="pm-row">
              <h3 class="pm-card-title">My virtual machines</h3>
              <span class="badge-count" id="vmCount">0</span>
            </div>
            <div class="pm-toolbar">
              <div class="search-input-wrapper" style="max-width:250px">
                <svg class="search-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                <input type="text" class="search-input" id="vmSearch" placeholder="Filter…" style="height:34px;font-size:12px" oninput="renderMachines()">
              </div>
              <div class="pm-segmented" id="vmFilter">
                <button class="active" data-filter="">All</button>
                <button data-filter="running">Running</button>
                <button data-filter="stopped">Stopped</button>
              </div>
            </div>
          </div>
          <div class="pm-card-body">
            <div class="vm-grid" id="vmContainer">
              <div class="skeleton skeleton-card"></div>
              <div class="skeleton skeleton-card"></div>
            </div>
          </div>
        </div>

        <div class="pm-stack">
          <div class="pm-card">
            <div class="pm-card-head">
              <h3 class="pm-card-title">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                Account
              </h3>
              <a href="/profile" class="pm-chip" style="font-size:10.5px">Edit</a>
            </div>
            <div class="pm-card-body" style="padding-top:6px">
              <div class="snapshot-row"><span>Username</span><span><%= user.username %></span></div>
              <div class="snapshot-row"><span>Role</span><span><%= user.role === 'admin' ? 'Administrator' : 'Member' %></span></div>
              <div class="snapshot-row"><span>Machines</span><span id="snapMachines">—</span></div>
              <div class="snapshot-row"><span>Running</span><span id="snapRunning">—</span></div>
            </div>
          </div>

          <div class="pm-card">
            <div class="pm-card-head">
              <h3 class="pm-card-title">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
                Quick connect
              </h3>
            </div>
            <div class="pm-card-body">
              <p class="pm-muted" style="font-size:11.5px;margin:0 0 10px">
                Open a browser console or SSH session from any machine card. Commands are one click from your clipboard.
              </p>
              <div class="pm-stack" style="gap:9px">
                <button class="btn btn-ghost btn-sm pm-no-loader" onclick="if(window.PM)PM.openPalette('')" style="justify-content:flex-start">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                  Find a machine <span class="pm-kbd pm-right">⌘K</span>
                </button>
                <a href="/profile" class="btn btn-ghost btn-sm" style="justify-content:flex-start">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  Security &amp; password
                </a>
                <button class="btn btn-ghost btn-sm pm-no-loader" onclick="if(window.PM)PM.openShortcuts()" style="justify-content:flex-start">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2"/></svg>
                  Keyboard shortcuts <span class="pm-kbd pm-right">?</span>
                </button>
              </div>
            </div>
          </div>

          <div class="pm-card">
            <div class="pm-card-head"><h3 class="pm-card-title">Need something new?</h3></div>
            <div class="pm-card-body">
              <p class="pm-muted" style="font-size:11.5px;margin:0 0 10px">Ask a panel administrator to provision another machine for your workspace.</p>
              <button class="btn btn-primary btn-sm pm-no-loader" style="width:100%" onclick="requestMachine()">Request a machine</button>
            </div>
          </div>
        </div>
      </div>

    </div>

    <%- include('../partials/admin/footer') %>
  </div>
</div>

<script>
  let allVMs = [];
  let currentFilter = '';

  function escHtml(str) {
    if (str == null) return '';
    return String(str).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }
  function toast(msg, type) { if (window.PM) PM.toast(msg, type || 'info'); }

  function history(key, value) {
    const storeKey = 'pm.hist.' + key;
    let arr = [];
    try { arr = JSON.parse(localStorage.getItem(storeKey) || '[]'); if (!Array.isArray(arr)) arr = []; } catch (e) { arr = []; }
    arr.push(Number(value) || 0);
    if (arr.length > 24) arr = arr.slice(arr.length - 24);
    try { localStorage.setItem(storeKey, JSON.stringify(arr)); } catch (e) {}
    return arr.length > 1 ? arr : [arr[0], arr[0]];
  }
  function paintSpark(id, values, color) {
    if (window.PM) PM.sparkline(document.getElementById(id), values, { color: color, height: 34 });
  }

  function greeting() {
    const h = new Date().getHours();
    const text = h < 5 ? 'Burning the midnight oil, ' : h < 12 ? 'Good morning, ' : h < 18 ? 'Good afternoon, ' : 'Good evening, ';
    const node = document.getElementById('heroGreeting');
    if (node) node.innerHTML = text + '<span><%= user.username %></span>';
  }

  function formatMem(mb) {
    if (!mb) return '—';
    return mb >= 1024 ? (mb / 1024).toFixed(1) + ' GB' : Math.round(mb) + ' MB';
  }

  function renderMachines() {
    const container = document.getElementById('vmContainer');
    if (!container) return;
    const q = (document.getElementById('vmSearch')?.value || '').toLowerCase();

    const filtered = allVMs.filter((vm) => {
      const matches = !currentFilter || (vm.status || 'stopped') === currentFilter;
      const hay = [vm.vm_name, vm.vm_id, vm.os_type, vm.template_name, vm.ipv4_address].join(' ').toLowerCase();
      return matches && (!q || hay.indexOf(q) !== -1);
    });

    if (!filtered.length) {
      container.innerHTML =
        '<div class="empty-enhanced">' +
          '<div class="empty-icon-wrap"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="7" rx="2"/><rect x="2" y="13" width="20" height="7" rx="2"/></svg></div>' +
          '<div class="empty-title">' + (allVMs.length ? 'Nothing matches that filter' : 'No machines yet') + '</div>' +
          '<div class="empty-desc">' + (allVMs.length ? 'Adjust your search or status filter.' : 'An administrator can assign a virtual machine to your workspace.') + '</div>' +
          (allVMs.length
            ? '<button class="btn btn-ghost btn-sm" onclick="currentFilter=\'\';document.getElementById(\'vmSearch\').value=\'\';document.querySelectorAll(\'#vmFilter button\').forEach(b=>b.classList.toggle(\'active\',b.dataset.filter===\'\'));renderMachines()">Clear filters</button>'
            : '<button class="btn btn-primary btn-sm" onclick="requestMachine()">Request a machine</button>') +
        '</div>';
      return;
    }

    container.innerHTML = filtered.map(renderVMCard).join('');
  }

  function renderVMCard(vm) {
    const status = vm.status || 'stopped';
    const icon = vm.template_icon && String(vm.template_icon).startsWith('http') ? vm.template_icon : '/images/logo.png';
    const sshPort = vm.ssh_port || vm.ssh_port_static || 22;
    const sshCmd = 'ssh ' + (vm.username || 'root') + '@localhost -p ' + sshPort;

    return `
      <div class="pm-card vm-card-enhanced ${escHtml(status)}">
        <div class="vm-card-header">
          <div class="vm-title-block">
            <div class="vm-os-icon"><img src="${escHtml(icon)}" alt="" onerror="this.style.display='none'"></div>
            <div style="min-width:0;flex:1">
              <div class="vm-name-enhanced" title="${escHtml(vm.vm_name)}">${escHtml(vm.vm_name)}</div>
              <div class="vm-meta-enhanced">
                <span>${escHtml(vm.template_name || vm.os_type || 'Custom OS')}</span>
                <span class="vm-id-chip">#${vm.vm_id}</span>
              </div>
            </div>
          </div>
          <span class="status-badge ${escHtml(status)}"><span class="status-dot"></span>${escHtml(status)}</span>
        </div>

        <div class="vm-specs">
          <div class="spec-item">
            <span class="spec-icon mem"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/></svg></span>
            <span class="spec-content"><span class="spec-label">Memory</span><span class="spec-value">${formatMem(vm.memory)}</span></span>
          </div>
          <div class="spec-item">
            <span class="spec-icon cpu"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/></svg></span>
            <span class="spec-content"><span class="spec-label">vCPU</span><span class="spec-value">${vm.cpus || '—'} cores</span></span>
          </div>
          <div class="spec-item">
            <span class="spec-icon disk"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/></svg></span>
            <span class="spec-content"><span class="spec-label">Disk</span><span class="spec-value">${escHtml(vm.disk_size || '—')}</span></span>
          </div>
          <div class="spec-item">
            <span class="spec-icon net"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18z"/></svg></span>
            <span class="spec-content"><span class="spec-label">IP</span><span class="spec-value">${escHtml(vm.ipv4_address || (vm.network_type === 'nat' ? 'DHCP' : '—'))}</span></span>
          </div>
        </div>

        <div class="ssh-info-box">
          <span class="ssh-icon-wrap"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg></span>
          <span class="ssh-details"><strong>${escHtml(vm.username || 'root')}</strong>@localhost:<strong>${sshPort}</strong></span>
          <button class="ssh-copy-btn" data-pm-copy="${escHtml(sshCmd)}" data-pm-copy-label="SSH command" title="Copy SSH command" aria-label="Copy SSH command">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          </button>
        </div>

        <div class="vm-actions-enhanced">
          ${status === 'running'
            ? `<button class="btn btn-action pm-no-loader" style="background:rgba(251,113,133,.14);border-color:rgba(251,113,133,.3);color:#fb7185" onclick="vmAction('stop', ${vm.vm_id}, '${escHtml(vm.vm_name)}')">Stop</button>`
            : `<button class="btn btn-action pm-no-loader" style="background:rgba(52,211,153,.14);border-color:rgba(52,211,153,.3);color:#34d399" onclick="vmAction('start', ${vm.vm_id}, '${escHtml(vm.vm_name)}')">Start</button>`}
          <a href="/vm/${vm.vm_id}" class="btn btn-action btn-ghost">Details</a>
          <a href="/vm/${vm.vm_id}/console" class="btn btn-action btn-ghost">Console</a>
        </div>
      </div>
    `;
  }

  async function loadMyVMs() {
    const btn = document.getElementById('refreshBtn');
    if (btn) btn.classList.add('spinning');

    try {
      const res = await fetch('/api/vms');
      if (!res.ok) throw new Error('API responded ' + res.status);
      const vms = await res.json();
      allVMs = Array.isArray(vms) ? vms : [];

      const total = allVMs.length;
      const running = allVMs.filter((v) => v.status === 'running').length;
      const stopped = total - running;
      const totalMem = allVMs.reduce((sum, v) => sum + (Number(v.memory) || 0), 0);
      const memLabel = totalMem >= 1024 ? (totalMem / 1024).toFixed(1) + ' GB' : totalMem + ' MB';

      if (window.PM) {
        PM.countUp(document.getElementById('myTotal'), total);
        PM.countUp(document.getElementById('myRunning'), running);
        PM.countUp(document.getElementById('myStopped'), stopped);
        const memNode = document.getElementById('myTotalMem');
        if (memNode) { memNode.textContent = memLabel; }
      }

      paintSpark('sparkTotal', history('myTotal', total), '#818cf8');
      paintSpark('sparkRunning', history('myRunning', running), '#34d399');
      paintSpark('sparkStopped', history('myStopped', stopped), '#94a3b8');
      paintSpark('sparkMem', history('myMem', totalMem), '#22d3ee');

      document.getElementById('vmCount').textContent = total;
      document.getElementById('runningRatio').textContent = total ? Math.round((running / total) * 100) + '% active' : 'No machines';
      document.getElementById('heroRunning').textContent = running + ' of ' + total + ' running';
      document.getElementById('heroRam').textContent = 'RAM ' + memLabel;
      document.getElementById('heroSync').textContent = 'Synced ' + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      document.getElementById('snapMachines').textContent = total;
      document.getElementById('snapRunning').textContent = running;

      const vmBadge = document.getElementById('userVmBadge');
      if (vmBadge) { vmBadge.textContent = total; vmBadge.style.display = total ? 'inline-flex' : 'none'; }
      const runBadge = document.getElementById('userRunningBadge');
      if (runBadge) { runBadge.textContent = running; runBadge.style.display = running ? 'inline-flex' : 'none'; }

      renderMachines();
    } catch (e) {
      document.getElementById('vmContainer').innerHTML =
        '<div class="empty-enhanced">' +
          '<div class="empty-icon-wrap" style="color:#fb7185;background:rgba(251,113,133,.12);border-color:rgba(251,113,133,.3)">' +
            '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><path d="M12 9v4M12 17h.01"/></svg>' +
          '</div>' +
          '<div class="empty-title">Unable to load your machines</div>' +
          '<div class="empty-desc">' + escHtml(e.message) + '</div>' +
          '<button class="btn btn-ghost btn-sm" onclick="loadMyVMs()">Try again</button>' +
        '</div>';
    } finally {
      if (btn) setTimeout(() => btn.classList.remove('spinning'), 500);
    }
  }

  async function vmAction(action, vmId, vmName) {
    const verb = action === 'start' ? 'Start' : 'Stop';
    const confirmed = window.PM
      ? await PM.confirm(verb + ' “' + vmName + '”?', { title: verb + ' machine', confirmText: verb, danger: action !== 'start' })
      : window.confirm(verb + ' ' + vmName + '?');
    if (!confirmed) return;

    try {
      toast(verb + 'ping ' + vmName + '…', 'info');
      const res = await fetch('/api/vms/' + vmId + '/' + action, { method: 'POST' });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.success !== false) {
        toast(vmName + ' ' + (action === 'start' ? 'is booting' : 'is shutting down'), 'success');
        setTimeout(loadMyVMs, 1400);
      } else {
        toast(data.error || 'Action failed', 'error');
      }
    } catch (e) {
      toast('Request failed: ' + e.message, 'error');
    }
  }

  function requestMachine() {
    if (!window.PM) return;
    PM.confirm('We will copy a ready-to-send request to your clipboard. Paste it to your panel administrator to get a new machine provisioned.', {
      title: 'Request a virtual machine',
      confirmText: 'Copy request',
      danger: false
    }).then(function (ok) {
      if (!ok) return;
      const note = 'Hi team, please provision a new virtual machine for my workspace on <%= siteName %>.\n\nAccount: <%= user.username %>\nRequested on: ' + new Date().toLocaleString() + '\n\nThanks!';
      PM.copy(note, 'Machine request copied');
    });
  }

  document.addEventListener('DOMContentLoaded', function () {
    greeting();
    const filter = document.getElementById('vmFilter');
    if (filter) {
      filter.addEventListener('click', (e) => {
        const btn = e.target.closest('button[data-filter]');
        if (!btn) return;
        currentFilter = btn.getAttribute('data-filter');
        filter.querySelectorAll('button').forEach((b) => b.classList.toggle('active', b === btn));
        renderMachines();
      });
    }
    loadMyVMs();
    setInterval(loadMyVMs, 30000);
  });
</script>
  <script src="/js/premium.js"></script>
</body>
</html>
