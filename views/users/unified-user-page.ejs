<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'TGVPANEL User Panel' %></title>
  <link rel="icon" href="<%= siteLogo %>" type="image/png">
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    .u3-card { background: var(--bg-card); border: 1px solid var(--border-card); border-radius: 12px; padding: 18px; margin-bottom: 18px; }
    .u3-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(310px, 1fr)); gap: 16px; }
    .u3-field label { display: block; font-size: 12px; color: var(--text-secondary); margin-bottom: 5px; font-weight: 600; }
    .u3-field input, .u3-field select { width: 100%; padding: 9px 11px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--bg-secondary, rgba(255,255,255,0.03)); color: var(--text-primary); font-size: 13px; }
    .u3-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .u3-table th, .u3-table td { padding: 10px 12px; text-align: left; border-bottom: 1px solid var(--border-subtle); color: var(--text-primary); }
    .u3-pill { display: inline-flex; padding: 2px 9px; border-radius: 999px; font-size: 11px; font-weight: 600; }
    .u3-pill.kvm { background: rgba(99,102,241,0.16); color: #818cf8; }
    .u3-pill.lxc { background: rgba(6,182,212,0.16); color: #22d3ee; }
    .u3-pill.running { background: rgba(16,185,129,0.16); color: #10b981; }
    .u3-pill.stopped { background: rgba(107,114,128,0.2); color: #9ca3af; }
    .u3-pill.frozen, .u3-pill.suspended { background: rgba(245,158,11,0.18); color: #f59e0b; }
  </style>
</head>
<body>
<div class="admin-wrapper">
  <%- include('../partials/users/sidebar') %>
  <div class="admin-main">
    <%- include('../partials/admin/header') %>
    <div class="admin-content">

      <% if (section === 'instances') { %>
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;flex-wrap:wrap;gap:12px;">
        <div>
          <h2 style="margin:0;color:var(--text-primary);">My Virtual Machines &amp; LXC Containers</h2>
          <p style="margin:4px 0 0;font-size:13px;color:var(--text-muted);">Unified compute dashboard including owned and shared KVM &amp; LXC instances.</p>
        </div>
        <select id="uEngineFilter" onchange="loadMyInstances()" style="padding:8px 12px;border-radius:8px;background:var(--bg-card);color:var(--text-primary);border:1px solid var(--border-card);">
          <option value="" <%= (typeof defaultEngine !== 'undefined' && defaultEngine === '') ? 'selected' : '' %>>All Engines (KVM + LXC)</option>
          <option value="kvm" <%= (typeof defaultEngine !== 'undefined' && defaultEngine === 'kvm') ? 'selected' : '' %>>KVM Virtual Machines</option>
          <option value="lxc" <%= (typeof defaultEngine !== 'undefined' && defaultEngine === 'lxc') ? 'selected' : '' %>>LXC Containers</option>
        </select>
      </div>
      <div id="myInstGrid" class="u3-grid"></div>
      <% } %>

      <% if (section === 'ports') { %>
      <div style="margin-bottom:18px;">
        <h2 style="margin:0;color:var(--text-primary);">Self-Service NAT Port Forwarding</h2>
        <p style="margin:4px 0 0;font-size:13px;color:var(--text-muted);" id="portQuotaBanner">Loading port allocation...</p>
      </div>
      <div class="u3-card">
        <h3 style="margin-top:0;color:var(--text-primary);">Add Port Forward Rule</h3>
        <form onsubmit="submitUserPort(event)" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;">
          <div class="u3-field"><label>Instance</label><select id="pfInst" required></select></div>
          <div class="u3-field"><label>Guest Internal Port</label><input id="pfGuestPort" type="number" min="1" max="65535" required placeholder="8080"></div>
          <div class="u3-field"><label>Host Public Port (Optional)</label><input id="pfHostPort" type="number" min="1024" max="65535" placeholder="Auto-assign"></div>
          <div class="u3-field"><label>Protocol</label><select id="pfProto"><option value="tcp,udp">TCP + UDP</option><option value="tcp">TCP Only</option><option value="udp">UDP Only</option></select></div>
          <div class="u3-field"><label>Description</label><input id="pfDesc" placeholder="Web / Game Port"></div>
          <div class="u3-field" style="display:flex;align-items:flex-end;"><button class="btn btn-primary" type="submit" style="width:100%;">Create Forward</button></div>
        </form>
      </div>
      <div class="u3-card" style="overflow-x:auto;">
        <table class="u3-table">
          <thead><tr><th>Instance</th><th>Public Port</th><th>Internal Target</th><th>Protocol</th><th>Description</th><th>Delete</th></tr></thead>
          <tbody id="uPortsBody"></tbody>
        </table>
      </div>
      <% } %>

      <% if (section === 'security') { %>
      <h2 style="margin:0 0 18px;color:var(--text-primary);">Account Security, Two-Factor Auth &amp; API Keys</h2>
      <div class="u3-card">
        <h3 style="margin-top:0;color:var(--text-primary);">Authenticator App (TOTP 2FA) — Status: <span id="tfaBadge"><%= twoFactorEnabled ? 'ENABLED' : 'DISABLED' %></span></h3>
        <% if (!twoFactorEnabled) { %>
        <button class="btn btn-primary" onclick="start2faSetup()">Generate Authenticator QR Code</button>
        <div id="tfaSetupBox" style="display:none;margin-top:14px;">
          <img id="tfaQrImg" alt="TOTP QR" style="background:#fff;padding:8px;border-radius:8px;display:block;margin-bottom:8px;">
          <div style="font-size:12px;color:var(--text-muted);margin-bottom:10px;">Manual Secret: <code id="tfaSecretCode"></code></div>
          <div style="display:flex;gap:8px;max-width:320px;">
            <input id="tfaVerifyInput" placeholder="6-digit code" maxlength="6" style="padding:8px;border-radius:8px;border:1px solid var(--border-color);background:var(--bg-secondary);color:var(--text-primary);">
            <button class="btn btn-primary" onclick="confirmEnable2fa()">Verify &amp; Enable</button>
          </div>
        </div>
        <% } else { %>
        <div style="display:flex;gap:8px;max-width:340px;">
          <input id="tfaDisableCode" placeholder="Enter 6-digit code to disable" maxlength="6" style="padding:8px;border-radius:8px;border:1px solid var(--border-color);background:var(--bg-secondary);color:var(--text-primary);">
          <button class="btn btn-outline" style="color:#ef4444;" onclick="disable2fa()">Disable 2FA</button>
        </div>
        <% } %>
      </div>

      <div class="u3-card">
        <h3 style="margin-top:0;color:var(--text-primary);">Personal API Keys</h3>
        <form onsubmit="createUserApiKey(event)" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin-bottom:14px;">
          <div class="u3-field"><label>Name</label><input id="ukName" required placeholder="CLI Script"></div>
          <div class="u3-field"><label>Permissions</label><select id="ukPerms"><option value="read">Read-Only</option><option value="read,write">Read + Write</option></select></div>
          <div class="u3-field" style="display:flex;align-items:flex-end;"><button class="btn btn-primary" type="submit" style="width:100%;">Generate API Key</button></div>
        </form>
        <pre id="ukSecretOut" style="display:none;padding:12px;background:rgba(0,0,0,0.3);border-radius:8px;color:#10b981;font-size:12px;"></pre>
        <table class="u3-table"><thead><tr><th>Prefix</th><th>Name</th><th>Permissions</th><th>Created</th><th>Revoke</th></tr></thead><tbody id="ukTable"></tbody></table>
      </div>
      <% } %>

      <% if (section === 'reseller-customers') { %>
      <h2 style="margin:0 0 8px;color:var(--text-primary);">Reseller Customer Directory</h2>
      <p style="margin:0 0 16px;color:var(--text-muted);font-size:13px;">Manage your own customer contact records. These CRM records are not login accounts and do not grant access to any VPS or resources.</p>
      <div class="u3-card">
        <form id="resellerCustomerForm" onsubmit="saveResellerCustomer(event)" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;">
          <input id="rcId" type="hidden">
          <div class="u3-field"><label>Customer name</label><input id="rcName" maxlength="120" required></div>
          <div class="u3-field"><label>Email</label><input id="rcEmail" type="email" maxlength="254" required></div>
          <div class="u3-field"><label>External reference (optional)</label><input id="rcExternal" maxlength="100"></div>
          <div class="u3-field"><label>Contact record status</label><select id="rcStatus"><option value="active">Active</option><option value="suspended">Suspended</option></select></div>
          <div class="u3-field" style="grid-column:1/-1;"><label>Notes (encrypted at rest; not a credential store)</label><textarea id="rcNotes" maxlength="1000" rows="3" style="width:100%;padding:9px 11px;border-radius:8px;border:1px solid var(--border-color);background:var(--bg-secondary,rgba(255,255,255,.03));color:var(--text-primary);"></textarea></div>
          <div style="display:flex;gap:8px;align-items:flex-end;"><button class="btn btn-primary" type="submit" id="rcSave">Create customer record</button><button class="btn btn-outline" type="button" id="rcCancel" onclick="resetResellerCustomerForm()" style="display:none;">Cancel edit</button></div>
        </form>
      </div>
      <div class="u3-card">
        <div style="display:flex;gap:8px;margin-bottom:12px;align-items:center;flex-wrap:wrap;"><input id="rcSearch" placeholder="Search name, email, reference" maxlength="100" onkeydown="if(event.key==='Enter'){event.preventDefault();resellerCustomerOffset=0;loadResellerCustomers();}" style="flex:1;min-width:220px;padding:9px 11px;border-radius:8px;border:1px solid var(--border-color);background:var(--bg-secondary);color:var(--text-primary);"><button class="btn btn-outline" onclick="resellerCustomerOffset=0;loadResellerCustomers()">Search</button><span id="rcCount" style="font-size:12px;color:var(--text-muted);"></span><button class="btn btn-outline" onclick="changeResellerCustomerPage(-1)">Previous</button><button class="btn btn-outline" onclick="changeResellerCustomerPage(1)">Next</button></div>
        <div style="overflow-x:auto;"><table class="u3-table"><thead><tr><th>Name</th><th>Email</th><th>Reference</th><th>Status</th><th>Updated</th><th>Actions</th></tr></thead><tbody id="resellerCustomersBody"></tbody></table></div>
      </div>
      <% } %>

      <% if (section === 'reseller-api-keys') { %>
      <h2 style="margin:0 0 8px;color:var(--text-primary);">Reseller API Keys</h2>
      <p style="margin:0 0 16px;color:var(--text-muted);font-size:13px;">Generate HMAC-signed automation credentials. The API key and secret are shown once at creation or rotation; store them securely.</p>
      <div class="u3-card">
        <form onsubmit="createResellerApiKey(event)" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;">
          <div class="u3-field"><label>Key Name</label><input id="rKeyName" maxlength="80" required placeholder="Provisioning bot"></div>
          <div class="u3-field"><label>Description</label><input id="rKeyDescription" maxlength="500" placeholder="CI automation"></div>
          <div class="u3-field"><label>Requests per minute</label><input id="rKeyRate" type="number" min="1" max="6000" value="60"></div>
          <div class="u3-field"><label>Expires (optional)</label><input id="rKeyExpiry" type="datetime-local"></div>
          <div class="u3-field" style="grid-column:1/-1;"><label>Exact source IP allowlist (optional, comma-separated; no CIDR/wildcards)</label><input id="rKeyIps" placeholder="203.0.113.10, 2001:db8::10"></div>
          <div class="u3-field" style="grid-column:1/-1;"><label>Permissions (select only what this key needs)</label>
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:6px;">
              <label><input type="checkbox" data-reseller-scope value="vps.read" checked> VPS read</label>
              <label><input type="checkbox" data-reseller-scope value="vps.start"> VPS start</label>
              <label><input type="checkbox" data-reseller-scope value="vps.stop"> VPS stop</label>
              <label><input type="checkbox" data-reseller-scope value="vps.restart"> VPS restart</label>
              <label><input type="checkbox" data-reseller-scope value="stats.read" checked> Statistics read</label>
              <label><input type="checkbox" data-reseller-scope value="resources.read"> Resource usage read</label>
              <label><input type="checkbox" data-reseller-scope value="customers.read"> Customer records read</label>
              <label><input type="checkbox" data-reseller-scope value="customers.create"> Customer records create</label>
              <label><input type="checkbox" data-reseller-scope value="customers.update"> Customer records update</label>
              <label><input type="checkbox" data-reseller-scope value="customers.delete"> Customer records delete</label>
              <label><input type="checkbox" data-reseller-scope value="api_keys.read"> API key metadata read</label>
              <label><input type="checkbox" data-reseller-scope value="api_keys.create"> Create/update/rotate keys</label>
              <label><input type="checkbox" data-reseller-scope value="api_keys.revoke"> Revoke keys</label>
            </div>
          </div>
          <div style="display:flex;align-items:flex-end;"><button class="btn btn-primary" type="submit">Generate HMAC Key Pair</button></div>
        </form>
        <pre id="resellerKeyOnce" style="display:none;white-space:pre-wrap;overflow-wrap:anywhere;padding:12px;background:rgba(0,0,0,.3);border-radius:8px;color:#10b981;font-size:12px;"></pre>
      </div>
      <div class="u3-card" style="overflow-x:auto;">
        <table class="u3-table"><thead><tr><th>Key</th><th>Name</th><th>Permissions</th><th>Rate/min</th><th>Last Used</th><th>Expires</th><th>State</th><th>Actions</th></tr></thead><tbody id="resellerKeysBody"></tbody></table>
      </div>
      <div class="u3-card" style="overflow-x:auto;">
        <h3 style="margin-top:0;color:var(--text-primary);">Selected Key Request Log</h3>
        <div id="resellerKeyUsageSummary" style="font-size:12px;color:var(--text-muted);margin-bottom:8px;">Select Usage on a key to review requests.</div>
        <table class="u3-table"><thead><tr><th>Time</th><th>Method</th><th>Path</th><th>Source IP</th><th>Status</th></tr></thead><tbody id="resellerKeyUsageBody"></tbody></table>
      </div>
      <% } %>

    </div>
    <%- include('../partials/admin/footer') %>
  </div>
</div>

<script>
const USER_SECTION = '<%= section %>';

async function openUserKvmVnc(id) {
  try {
    const current = await hkvmApi(`/api/v1/instances/kvm/${id}/vnc`);
    if (!current.vnc.enabled) {
      if (!confirm('Enable loopback-only VNC? The VM must be stopped; the console becomes available after its next start.')) return;
      await hkvmApi(`/api/v1/instances/kvm/${id}/vnc`, { method: 'POST', body: { enabled: true } });
      hkvmToast('VNC enabled for the next start. Start the VM, then open VNC Console.', 'warning');
      return;
    }
    window.open(`/vm/${id}/vnc`, '_blank', 'noopener');
  } catch (e) { hkvmToast(e.message, 'error'); }
}

async function manageUserKvmRescueIso(id) {
  try {
    const current = await hkvmApi(`/api/vms/${id}/iso/status`);
    if (current.iso_attached && current.boot_from_iso) {
      if (!confirm('Disable rescue mode? This detaches the ISO and restores disk-first boot. Stop the VM first.')) return;
      await hkvmApi(`/api/v1/instances/kvm/${id}/rescue`, { method: 'POST', body: { enabled: false } });
      hkvmToast('Rescue ISO detached; disk-first boot restored.', 'success');
      return;
    }
    const isos = await hkvmApi('/api/iso-list');
    if (!Array.isArray(isos) || !isos.length) return hkvmToast('No managed ISO files found. Upload a bootable rescue ISO to ~/vms/iso first.', 'warning');
    const filename = prompt(`Choose an ISO filename from the managed list:
${isos.join('
')}`);
    if (!filename || !isos.includes(filename.trim())) return;
    if (!confirm('TGVPANEL does not provide rescue software or verify that this ISO is bootable. Stop the VM, configure the ISO, start it and use its serial/VNC console. Disable rescue after stopping it. Continue?')) return;
    await hkvmApi(`/api/v1/instances/kvm/${id}/rescue`, { method: 'POST', body: { enabled: true, isoFilename: filename.trim() } });
    hkvmToast('Rescue ISO selected for the next start. Start the VM and connect using its console.', 'warning');
  } catch (e) { hkvmToast(e.message, 'error'); }
}

async function cloneUserLxc(id) {
  if (!confirm('This copies the stopped LXC disk and duplicates guest keys, passwords, machine identity and secrets. The clone is created with networking detached. Review in-guest static IP settings and reset identity before reconnecting it. Continue?')) return;
  const name = prompt('Enter a unique name for the stopped LXC clone:');
  if (!name) return;
  try {
    const result = await hkvmApi(`/api/v1/instances/lxc/${id}/clone`, {
      method: 'POST', body: { name: name.trim(), acknowledgeGuestIdentityRisk: true }
    });
    hkvmToast(`Created disconnected LXC clone ${result.clone.instance.name}. Review guest networking before connecting it.`, 'warning');
    loadMyInstances();
  } catch (e) { hkvmToast(e.message, 'error'); }
}

async function loadMyInstances() {
  const eng = document.getElementById('uEngineFilter').value;
  const data = await hkvmApi('/api/v1/instances' + (eng ? '?engine=' + eng : ''));
  const grid = document.getElementById('myInstGrid');
  if (!data.instances.length) {
    grid.innerHTML = '<div class="u3-card">No compute instances assigned to your account yet.</div>';
    return;
  }
  grid.innerHTML = data.instances.map(i => {
    const detailHref = i.engine === 'kvm' ? '/vm/' + i.refId : '/lxc/' + i.refId;
    const consoleHref = i.engine === 'kvm' ? '/vm/' + i.refId + '/console' : '/lxc/' + i.refId + '/console';
    return `<div class="u3-card">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
        <span class="u3-pill ${i.engine}">${i.engine.toUpperCase()}</span>
        <span class="u3-pill ${i.status}">${hkvmEsc(i.status)}</span>${i.serviceLocked ? '<span class="u3-pill suspended">STAFF LOCK</span>' : ''}
      </div>
      <h3 style="margin:0 0 4px;color:var(--text-primary);">${hkvmEsc(i.name)}</h3>
      <div style="font-size:12px;color:var(--text-muted);margin-bottom:12px;">${hkvmEsc(i.osLabel)} • IP: <code>${hkvmEsc(i.primaryIp || 'Pending')}</code></div>
      <div style="font-size:12px;color:var(--text-secondary);margin-bottom:14px;">${i.cpuCores} vCPU • ${i.ramMb} MB RAM • ${i.diskGb} GB Storage</div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;">
        <a class="btn btn-primary" href="${detailHref}">Manage</a>
        <a class="btn btn-outline" href="${consoleHref}">Console</a>
        ${i.engine === 'kvm' ? `<button class="btn btn-outline" onclick="openUserKvmVnc(${i.refId})">VNC Console</button>${i.status === 'stopped' ? `<button class="btn btn-outline" onclick="manageUserKvmRescueIso(${i.refId})">Rescue ISO</button>` : ''}` : ''}
        ${i.engine === 'lxc' && i.status === 'stopped' && !i.suspended ? `<button class="btn btn-outline" onclick="cloneUserLxc(${i.refId})">Clone</button>` : ''}
        <button class="btn btn-outline" onclick="uAct('${i.engine}',${i.refId},'start')" ${i.serviceLocked ? 'disabled title="Administrative service lock is active"' : ''}>Start</button>
        <button class="btn btn-outline" onclick="uAct('${i.engine}',${i.refId},'stop')">Stop</button>
        <button class="btn btn-outline" onclick="hkvmShowInstanceTaskHistory('${i.engine}',${i.refId})">Task history</button>
      </div>
    </div>`;
  }).join('');
}

async function uAct(engine, id, action) {
  try {
    await hkvmRunInstanceAction(engine, id, action);
    loadMyInstances();
  } catch (e) { hkvmToast(e.message, 'error'); }
}

async function loadUserPorts() {
  const [instRes, portRes] = await Promise.all([
    hkvmApi('/api/v1/instances'),
    hkvmApi('/api/v1/network/ports')
  ]);
  document.getElementById('portQuotaBanner').textContent =
    `Used ${portRes.quota.usedPorts} of ${portRes.quota.allocatedPorts} allocated NAT ports (${portRes.quota.remainingPorts} remaining).`;
  document.getElementById('pfInst').innerHTML = instRes.instances
    .map(i => `<option value="${i.engine}:${i.refId}">[${i.engine.toUpperCase()}] ${hkvmEsc(i.name)} (${hkvmEsc(i.primaryIp || 'no-ip')})</option>`)
    .join('');
  document.getElementById('uPortsBody').innerHTML = portRes.forwards.length
    ? portRes.forwards.map(f => `<tr>
        <td>${hkvmEsc(f.container_name)}</td><td><code>:${f.host_port}</code></td>
        <td><code>${hkvmEsc(f.guest_ip || '')}:${f.guest_port}</code></td><td>${hkvmEsc(f.protocol)}</td>
        <td>${hkvmEsc(f.description)}</td>
        <td><button class="btn btn-outline" style="color:#ef4444;" onclick="delUserPort(${f.id})">Delete</button></td>
      </tr>`).join('')
    : '<tr><td colspan="6" style="color:var(--text-muted);">No port forwarding rules created yet.</td></tr>';
}

async function submitUserPort(e) {
  e.preventDefault();
  const [instanceType, instanceRefId] = document.getElementById('pfInst').value.split(':');
  try {
    await hkvmApi('/api/v1/network/ports', {
      method: 'POST',
      body: {
        instanceType,
        instanceRefId: Number(instanceRefId),
        guestPort: Number(document.getElementById('pfGuestPort').value),
        hostPort: document.getElementById('pfHostPort').value ? Number(document.getElementById('pfHostPort').value) : undefined,
        protocol: document.getElementById('pfProto').value,
        description: document.getElementById('pfDesc').value
      }
    });
    hkvmToast('Port forward rule added');
    loadUserPorts();
  } catch (err) { hkvmToast(err.message, 'error'); }
}

async function delUserPort(id) {
  await hkvmApi('/api/v1/network/ports/' + id, { method: 'DELETE' });
  loadUserPorts();
}

async function start2faSetup() {
  const out = await hkvmApi('/api/v1/auth/2fa/setup', { method: 'POST' });
  document.getElementById('tfaSetupBox').style.display = 'block';
  document.getElementById('tfaQrImg').src = out.qrDataUrl;
  document.getElementById('tfaSecretCode').textContent = out.secret;
}

async function confirmEnable2fa() {
  try {
    await hkvmApi('/api/v1/auth/2fa/enable', {
      method: 'POST',
      body: { code: document.getElementById('tfaVerifyInput').value }
    });
    hkvmToast('Two-Factor Authentication enabled!');
    setTimeout(() => location.reload(), 800);
  } catch (err) { hkvmToast(err.message, 'error'); }
}

async function disable2fa() {
  try {
    await hkvmApi('/api/v1/auth/2fa/disable', {
      method: 'POST',
      body: { code: document.getElementById('tfaDisableCode').value }
    });
    location.reload();
  } catch (err) { hkvmToast(err.message, 'error'); }
}

async function loadUserKeys() {
  const data = await hkvmApi('/api/v1/api-keys');
  document.getElementById('ukTable').innerHTML = data.apiKeys.map(k => `<tr>
    <td><code>${hkvmEsc(k.key_prefix)}...</code></td><td>${hkvmEsc(k.name)}</td>
    <td><code>${hkvmEsc(k.permissions)}</code></td><td>${hkvmEsc(k.created_at)}</td>
    <td><button class="btn btn-outline" onclick="revokeUserKey(${k.id})">Revoke</button></td>
  </tr>`).join('');
}

async function createUserApiKey(e) {
  e.preventDefault();
  const out = await hkvmApi('/api/v1/api-keys', {
    method: 'POST',
    body: {
      name: document.getElementById('ukName').value,
      permissions: document.getElementById('ukPerms').value.split(',')
    }
  });
  const pre = document.getElementById('ukSecretOut');
  pre.style.display = 'block';
  pre.textContent = 'Copy your API key now (shown once):\n' + out.rawApiKey;
  loadUserKeys();
}

async function revokeUserKey(id) {
  await hkvmApi('/api/v1/api-keys/' + id, { method: 'DELETE' });
  loadUserKeys();
}

async function loadResellerApiKeys() {
  const data = await hkvmApi('/api/v1/reseller/api-keys');
  document.getElementById('resellerKeysBody').innerHTML = (data.apiKeys || []).length
    ? data.apiKeys.map(k => `<tr>
        <td><code>${hkvmEsc(k.keyPrefix)}…</code></td><td>${hkvmEsc(k.name)}</td>
        <td><code>${hkvmEsc(Array.isArray(k.permissions) ? k.permissions.join(', ') : k.permissions)}</code></td>
        <td>${hkvmEsc(k.rateLimitPerMinute)}</td><td>${hkvmEsc(k.lastUsedAt || 'Never')}</td>
        <td>${hkvmEsc(k.expiresAt || 'Never')}</td><td>${k.isActive ? 'Enabled' : 'Disabled'}</td>
        <td style="white-space:nowrap;">
          <button class="btn btn-outline" onclick="loadResellerKeyUsage(${k.id})">Usage</button>
          <button class="btn btn-outline" onclick="rotateResellerApiKey(${k.id})">Rotate</button>
          ${k.isActive ? `<button class="btn btn-outline" onclick="setResellerKeyState(${k.id},'disable')">Disable</button>` : `<button class="btn btn-outline" onclick="setResellerKeyState(${k.id},'enable')">Enable</button>`}
          <button class="btn btn-outline" style="color:#ef4444;" onclick="revokeResellerApiKey(${k.id})">Revoke</button>
        </td>
      </tr>`).join('')
    : '<tr><td colspan="8" style="color:var(--text-muted);">No reseller API keys configured.</td></tr>';
}

async function createResellerApiKey(e) {
  e.preventDefault();
  const permissions = [...document.querySelectorAll('[data-reseller-scope]:checked')].map(el => el.value);
  const ipAllowlist = document.getElementById('rKeyIps').value.split(',').map(ip => ip.trim()).filter(Boolean);
  try {
    const data = await hkvmApi('/api/v1/reseller/api-keys', {
      method: 'POST',
      body: {
        name: document.getElementById('rKeyName').value,
        description: document.getElementById('rKeyDescription').value,
        permissions,
        ipAllowlist,
        rateLimitPerMinute: Number(document.getElementById('rKeyRate').value),
        expiresAt: document.getElementById('rKeyExpiry').value ? new Date(document.getElementById('rKeyExpiry').value).toISOString() : null,
      }
    });
    const output = document.getElementById('resellerKeyOnce');
    output.style.display = 'block';
    output.textContent = `SAVE THESE CREDENTIALS NOW — the secret is shown once.\nAPI key: ${data.apiKey}\nAPI secret: ${data.apiSecret}\nPermissions: ${data.permissions.join(', ')}\nCanonical request and code examples: docs/API_RESELLER.md`;
    await loadResellerApiKeys();
  } catch (err) { hkvmToast(err.message, 'error'); }
}

async function rotateResellerApiKey(id) {
  if (!confirm('Rotate both the API key and signing secret? The old credential pair becomes invalid immediately.')) return;
  try {
    const data = await hkvmApi(`/api/v1/reseller/api-keys/${id}/rotate`, { method: 'POST' });
    const output = document.getElementById('resellerKeyOnce');
    output.style.display = 'block';
    output.textContent = `SAVE THE NEW CREDENTIALS NOW — the secret is shown once.\nAPI key: ${data.apiKey}\nAPI secret: ${data.apiSecret}`;
    await loadResellerApiKeys();
  } catch (err) { hkvmToast(err.message, 'error'); }
}

async function setResellerKeyState(id, action) {
  try {
    await hkvmApi(`/api/v1/reseller/api-keys/${id}/${action}`, { method: 'POST' });
    await loadResellerApiKeys();
  } catch (err) { hkvmToast(err.message, 'error'); }
}

async function revokeResellerApiKey(id) {
  if (!confirm('Permanently revoke this API key?')) return;
  try {
    await hkvmApi(`/api/v1/reseller/api-keys/${id}`, { method: 'DELETE' });
    await loadResellerApiKeys();
  } catch (err) { hkvmToast(err.message, 'error'); }
}

async function loadResellerKeyUsage(id) {
  try {
    const data = await hkvmApi(`/api/v1/reseller/api-keys/${id}/usage?limit=50`);
    const summary = data.usage || {};
    document.getElementById('resellerKeyUsageSummary').textContent = `Total: ${summary.total || 0} · Last 24 hours: ${summary.last_24h || 0} · Succeeded: ${summary.succeeded || 0} · Failed: ${summary.failed || 0}`;
    document.getElementById('resellerKeyUsageBody').innerHTML = data.requests.length
      ? data.requests.map(r => `<tr><td>${hkvmEsc(r.created_at)}</td><td>${hkvmEsc(r.method)}</td><td><code>${hkvmEsc(r.path)}</code></td><td>${hkvmEsc(r.ip_address || '')}</td><td>${hkvmEsc(r.status_code)}</td></tr>`).join('')
      : '<tr><td colspan="5" style="color:var(--text-muted);">No request records for this key.</td></tr>';
  } catch (err) { hkvmToast(err.message, 'error'); }
}

let resellerCustomerOffset = 0;
const resellerCustomerPageSize = 50;

async function loadResellerCustomers() {
  const query = new URLSearchParams({ limit: String(resellerCustomerPageSize), offset: String(resellerCustomerOffset) });
  const search = document.getElementById('rcSearch')?.value.trim();
  if (search) query.set('search', search);
  try {
    const data = await hkvmApi(`/api/v1/reseller/customers?${query.toString()}`);
    const body = document.getElementById('resellerCustomersBody');
    document.getElementById('rcCount').textContent = `${data.pagination.total} customer records`;
    body.innerHTML = data.customers.length
      ? data.customers.map(customer => `<tr>
          <td>${hkvmEsc(customer.displayName)}</td>
          <td>${hkvmEsc(customer.email)}</td>
          <td>${hkvmEsc(customer.externalReference || '—')}</td>
          <td><span class="u3-pill ${customer.status === 'active' ? 'running' : 'suspended'}">${hkvmEsc(customer.status)}</span></td>
          <td>${hkvmEsc(customer.updatedAt || '')}</td>
          <td><div style="display:flex;gap:6px;"><button class="btn btn-outline" onclick="editResellerCustomer(${customer.id})">Edit</button><button class="btn btn-outline" style="color:#ef4444;" onclick="deleteResellerCustomer(${customer.id})">Delete</button></div></td>
        </tr>`).join('')
      : '<tr><td colspan="6" style="color:var(--text-muted);">No customer records found.</td></tr>';
  } catch (err) {
    hkvmToast(err.message, 'error');
  }
}

async function changeResellerCustomerPage(direction) {
  const next = resellerCustomerOffset + direction * resellerCustomerPageSize;
  if (next < 0) return;
  resellerCustomerOffset = next;
  await loadResellerCustomers();
  const total = Number(document.getElementById('rcCount').textContent.split(' ')[0]);
  if (resellerCustomerOffset >= total && total > 0) {
    resellerCustomerOffset = Math.max(0, Math.floor((total - 1) / resellerCustomerPageSize) * resellerCustomerPageSize);
    await loadResellerCustomers();
  }
}

async function saveResellerCustomer(event) {
  event.preventDefault();
  const id = document.getElementById('rcId').value;
  const body = {
    displayName: document.getElementById('rcName').value,
    email: document.getElementById('rcEmail').value,
    externalReference: document.getElementById('rcExternal').value || null,
    notes: document.getElementById('rcNotes').value || null,
    status: document.getElementById('rcStatus').value,
  };
  try {
    await hkvmApi(id ? `/api/v1/reseller/customers/${id}` : '/api/v1/reseller/customers', { method: id ? 'PUT' : 'POST', body });
    hkvmToast(id ? 'Customer record updated' : 'Customer record created');
    resetResellerCustomerForm();
    resellerCustomerOffset = 0;
    await loadResellerCustomers();
  } catch (err) { hkvmToast(err.message, 'error'); }
}

async function editResellerCustomer(id) {
  try {
    const data = await hkvmApi(`/api/v1/reseller/customers/${id}`);
    const customer = data.customer;
    document.getElementById('rcId').value = customer.id;
    document.getElementById('rcName').value = customer.displayName;
    document.getElementById('rcEmail').value = customer.email;
    document.getElementById('rcExternal').value = customer.externalReference || '';
    document.getElementById('rcNotes').value = customer.notes || '';
    document.getElementById('rcStatus').value = customer.status;
    document.getElementById('rcSave').textContent = 'Save customer changes';
    document.getElementById('rcCancel').style.display = '';
    document.getElementById('rcName').focus();
  } catch (err) { hkvmToast(err.message, 'error'); }
}

function resetResellerCustomerForm() {
  document.getElementById('resellerCustomerForm').reset();
  document.getElementById('rcId').value = '';
  document.getElementById('rcSave').textContent = 'Create customer record';
  document.getElementById('rcCancel').style.display = 'none';
}

async function deleteResellerCustomer(id) {
  if (!confirm('Permanently delete this CRM contact record? No panel login or VPS will be affected.')) return;
  try {
    await hkvmApi(`/api/v1/reseller/customers/${id}`, { method: 'DELETE' });
    hkvmToast('Customer record deleted');
    await loadResellerCustomers();
  } catch (err) { hkvmToast(err.message, 'error'); }
}

document.addEventListener('DOMContentLoaded', () => {
  if (USER_SECTION === 'instances') loadMyInstances();
  if (USER_SECTION === 'ports') loadUserPorts();
  if (USER_SECTION === 'security') loadUserKeys();
  if (USER_SECTION === 'reseller-api-keys') loadResellerApiKeys();
  if (USER_SECTION === 'reseller-customers') loadResellerCustomers();
});
</script>
</body>
</html>
